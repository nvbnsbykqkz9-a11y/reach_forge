<Window x:Class="ReachForge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ReachForge" Width="1280" Height="820" MinWidth="390" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F7F8FA">
    <Grid>
        <wv2:WebView2 x:Name="Web" Visibility="Collapsed" />
        <StackPanel x:Name="Splash" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
            <TextBlock Text="ReachForge" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#1F2633" />
            <TextBlock x:Name="Status" Text="起動しています…" FontSize="14" Margin="0,12,0,0" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center" Foreground="#5F687A" />
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="4" Width="240" Margin="0,16,0,0" />
            <StackPanel x:Name="ErrorActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed">
                <Button Content="もう一度起動する" Padding="16,6" Click="Retry_Click" />
                <Button Content="ログを開く" Padding="16,6" Margin="12,0,0,0" Click="OpenLogs_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
