<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows 版（PC 単体）。WebView2 の画面と、PC の中で動かすサーバー（ReachForge.Web）の起動・停止・タスクトレイ常駐を受け持つ。
    発行は deploy/desktop/publish.ps1（サーバーは server フォルダーに同梱）。Linux でもビルドだけはできる（EnableWindowsTargeting）。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF と Windows Forms の同名の型（Application など）がぶつからないよう、using は明示する -->
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>ReachForge.ico</ApplicationIcon>
    <AssemblyName>ReachForge</AssemblyName>
    <RootNamespace>ReachForge.Desktop</RootNamespace>
    <Product>ReachForge</Product>
    <Version>1.0.0</Version>
    <!-- 画面は WPF（DPI はマニフェストで指定）。Windows Forms はトレイのアイコンにだけ使うため、Windows Forms の DPI 設定の警告は対象外 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ReachForge.Desktop.Host\ReachForge.Desktop.Host.csproj" />
  </ItemGroup>
</Project>
