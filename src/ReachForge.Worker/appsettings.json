{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Database": {
    "Provider": "Sqlite",
    "SeedDemo": false
  },
  "ConnectionStrings": {
    "ReachForge": "Data Source=../../reachforge.local.db"
  },
  "Worker": {
    "PollSeconds": 15
  },
  "Jobs": {
    "Engine": "Hosted",
    "TimeZone": "Asia/Tokyo",
    "Queue": "InProcess",
    "ServiceBus": {
      "ConnectionString": "",
      "FullyQualifiedNamespace": "",
      "CreateQueues": false,
      "MaxConcurrentCalls": 4
    },
    "Hangfire": {
      "Schema": "hangfire",
      "PrepareSchema": true,
      "WorkerCount": 5
    }
  },
  "Social": {
    "UseMock": false,
    "X": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Meta": {
      "AppId": "",
      "AppSecret": ""
    },
    "Threads": {
      "AppId": "",
      "AppSecret": ""
    }
  },
  "Secrets": {
    "KeyVaultUri": ""
  },
  "Media": {
    "LocalPath": "../../media.local",
    "BlobServiceUri": "",
    "BlobContainer": "media",
    "PublicBaseUrl": ""
  },
  "ContentSafety": {
    "Endpoint": "",
    "Key": "",
    "BlockSeverity": 4
  },
  "Video": {
    "FfmpegPath": "ffmpeg",
    "Preset": "veryfast",
    "TimeoutSeconds": 900
  }
}
