{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Database": {
    "Provider": "Sqlite",
    "SeedDemo": false
  },
  "ConnectionStrings": {
    "ReachForge": "Data Source=../../reachforge.local.db"
  },
  "Worker": {
    "PollSeconds": 15
  },
  "Social": {
    "UseMock": false,
    "X": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Meta": {
      "AppId": "",
      "AppSecret": ""
    },
    "Threads": {
      "AppId": "",
      "AppSecret": ""
    }
  },
  "Secrets": {
    "KeyVaultUri": ""
  },
  "Media": {
    "LocalPath": "../../media.local",
    "BlobServiceUri": "",
    "BlobContainer": "media",
    "PublicBaseUrl": ""
  },
  "ContentSafety": {
    "Endpoint": "",
    "Key": "",
    "BlockSeverity": 4
  },
  "Video": {
    "FfmpegPath": "ffmpeg",
    "Preset": "veryfast",
    "TimeoutSeconds": 900
  }
}
