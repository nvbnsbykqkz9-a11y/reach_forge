<Project Sdk="Aspire.AppHost.Sdk/13.6.1">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>reachforge-apphost</UserSecretsId>
    <!-- Aspire CLI のバンドル（aspire publish/deploy 用）は使わず、dotnet run で起動する -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ReachForge.Web\ReachForge.Web.csproj" />
    <ProjectReference Include="..\ReachForge.Worker\ReachForge.Worker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" />
  </ItemGroup>
</Project>
