<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\ReachForge.Application\ReachForge.Application.csproj" />
    <ProjectReference Include="..\ReachForge.AI\ReachForge.AI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Azure.Identity" />
    <!-- ジョブ基盤（14章）：Hangfire（LGPL v3。DLL を改変せずに参照する限り商用利用可）と Azure Service Bus -->
    <PackageReference Include="Hangfire.NetCore" />
    <PackageReference Include="Hangfire.InMemory" />
    <PackageReference Include="Cronos" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <!-- 画像処理は SkiaSharp（MIT）。IImageProcessor 越しに使う。Linux の native は開発・テスト用（Windows 版は SkiaSharp に同梱） -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ReachForge.Application.Tests" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <!-- QuestPDF は Community License（年商100万USD未満の営利企業・非営利・OSS は無償）。それ以外は商用ライセンスが必要 -->
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- 操作説明書（PDF）の表紙に使うアプリのアイコン -->
    <EmbeddedResource Include="Help\icon.png" LogicalName="ReachForge.Help.icon.png" />
  </ItemGroup>
</Project>
