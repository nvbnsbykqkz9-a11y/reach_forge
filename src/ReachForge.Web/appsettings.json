{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "SeedDemo": false
  },
  "ConnectionStrings": {
    "ReachForge": "Data Source=../../reachforge.local.db"
  },
  "Worker": {
    "RunInWeb": false,
    "PollSeconds": 15
  },
  "Social": {
    "UseMock": false,
    "X": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Meta": {
      "AppId": "",
      "AppSecret": "",
      "GraphVersion": "v24.0",
      "WebhookVerifyToken": ""
    },
    "Threads": {
      "AppId": "",
      "AppSecret": "",
      "WebhookVerifyToken": ""
    },
    "Line": {
      "Enabled": true
    }
  },
  "AI": {
    "MaxOutputTokens": 16000,
    "Providers": {
      "anthropic": {
        "Type": "Anthropic",
        "Model": "claude-opus-5-5",
        "InputPricePerMTok": 4.0,
        "OutputPricePerMTok": 20.0
      },
      "openai": {
        "Type": "OpenAI",
        "Model": "",
        "InputPricePerMTok": 0,
        "OutputPricePerMTok": 0
      }
    },
    "Routes": {
      "Default": [
        "anthropic",
        "openai"
      ],
      "Copy": [
        "anthropic",
        "openai"
      ],
      "Variant": [
        "anthropic",
        "openai"
      ],
      "Judge": [
        "anthropic",
        "openai"
      ],
      "Summarize": [
        "anthropic",
        "openai"
      ]
    }
  },
  "Auth": {
    "RequireMfaForAdmins": true,
    "AllowRegistration": true,
    "Oidc": {
      "Google": {
        "DisplayName": "Google",
        "Authority": "https://accounts.google.com",
        "ClientId": "",
        "ClientSecret": ""
      },
      "Microsoft": {
        "DisplayName": "Microsoft",
        "Authority": "https://login.microsoftonline.com/common/v2.0",
        "ClientId": "",
        "ClientSecret": ""
      }
    }
  },
  "Secrets": {
    "KeyVaultUri": ""
  }
}