{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "SeedDemo": false
  },
  "ConnectionStrings": {
    "ReachForge": "Data Source=../../reachforge.local.db"
  },
  "Worker": {
    "RunInWeb": false,
    "PollSeconds": 15
  },
  "Jobs": {
    "Engine": "Hosted",
    "TimeZone": "Asia/Tokyo",
    "Queue": "InProcess",
    "ServiceBus": {
      "ConnectionString": "",
      "FullyQualifiedNamespace": "",
      "CreateQueues": false,
      "MaxConcurrentCalls": 4
    },
    "Hangfire": {
      "Schema": "hangfire",
      "PrepareSchema": true,
      "WorkerCount": 5
    }
  },
  "Ops": {
    "Operators": []
  },
  "AI": {
    "MaxOutputTokens": 16000,
    "UsdJpyRate": 150,
    "Providers": {
      "anthropic": {
        "Type": "Anthropic",
        "Model": "claude-opus-5-5",
        "InputPricePerMTok": 4.0,
        "OutputPricePerMTok": 20.0
      },
      "openai": {
        "Type": "OpenAI",
        "Model": "",
        "InputPricePerMTok": 0,
        "OutputPricePerMTok": 0,
        "TaskModels": {
          "Image": "gpt-image-1",
          "ImageEdit": "gpt-image-1",
          "VideoGeneration": "sora-2",
          "Tts": "gpt-4o-mini-tts"
        },
        "PricePerImage": 0.04,
        "PricePerVideoSecond": 0.1,
        "PricePerSpeechMinute": 0.015
      },
      "google": {
        "Type": "Google",
        "Model": "veo-3.0-generate-001",
        "PricePerVideoSecond": 0.4
      }
    },
    "Routes": {
      "Default": [
        "anthropic",
        "openai"
      ],
      "Copy": [
        "anthropic",
        "openai"
      ],
      "Variant": [
        "anthropic",
        "openai"
      ],
      "Judge": [
        "anthropic",
        "openai"
      ],
      "Summarize": [
        "anthropic",
        "openai"
      ],
      "Image": [
        "openai"
      ],
      "ImageEdit": [
        "openai"
      ],
      "Vision": [
        "anthropic",
        "openai"
      ],
      "Tts": [
        "openai"
      ],
      "VideoGeneration": [
        "google",
        "openai"
      ]
    }
  },
  "Auth": {
    "RequireMfaForAdmins": true,
    "AllowRegistration": true,
    "Oidc": {
      "Google": {
        "DisplayName": "Google",
        "Authority": "https://accounts.google.com",
        "ClientId": "",
        "ClientSecret": ""
      },
      "Microsoft": {
        "DisplayName": "Microsoft",
        "Authority": "https://login.microsoftonline.com/common/v2.0",
        "ClientId": "",
        "ClientSecret": ""
      }
    }
  },
  "Secrets": {
    "KeyVaultUri": ""
  },
  "Media": {
    "LocalPath": "../../media.local",
    "BlobServiceUri": "",
    "BlobContainer": "media",
    "PublicBaseUrl": ""
  },
  "ContentSafety": {
    "Endpoint": "",
    "Key": "",
    "BlockSeverity": 4
  },
  "Video": {
    "FfmpegPath": "ffmpeg",
    "Preset": "veryfast",
    "TimeoutSeconds": 900
  }
}
