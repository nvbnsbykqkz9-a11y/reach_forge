{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": { "Provider": "Sqlite", "SeedDemo": false },
  "ConnectionStrings": { "ReachForge": "Data Source=../../reachforge.local.db" },
  "Worker": { "RunInWeb": false, "PollSeconds": 15 },
  "Social": { "UseMock": true },
  "Demo": { "UserName": "田中", "Role": "Owner" },
  "AI": {
    "MaxOutputTokens": 16000,
    "Providers": {
      "anthropic": {
        "Type": "Anthropic",
        "Model": "claude-opus-5-5",
        "InputPricePerMTok": 4.0,
        "OutputPricePerMTok": 20.0
      },
      "openai": {
        "Type": "OpenAI",
        "Model": "",
        "InputPricePerMTok": 0,
        "OutputPricePerMTok": 0
      }
    },
    "Routes": {
      "Default": [ "anthropic", "openai" ],
      "Copy": [ "anthropic", "openai" ],
      "Variant": [ "anthropic", "openai" ],
      "Judge": [ "anthropic", "openai" ],
      "Summarize": [ "anthropic", "openai" ]
    }
  }
}
