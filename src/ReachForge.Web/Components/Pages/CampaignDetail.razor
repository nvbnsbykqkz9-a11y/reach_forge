@page "/campaigns/{Id:guid}"
@inherits RfComponentBase
@inject WebTenantContext Tenant
@inject AppState State
@inject TimeDisplay Time
@inject ISnackbar Snackbar

<PageTitle>@(_summary?.Campaign.Name ?? "キャンペーン")｜ReachForge</PageTitle>

@if (_summary is { } s)
{
    var c = s.Campaign;
    <div class="rf-page-header">
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.ArrowBack" Href="/campaigns">一覧</MudButton>
        <MudText Typo="Typo.h4" tabindex="-1">@c.Name</MudText>
        <span class="rf-spacer"></span>
        <MudButton Variant="Variant.Outlined" Href="@($"/analytics?campaign={c.Id}&period=90d")" StartIcon="@Icons.Material.Rounded.Insights">分析を見る</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@($"/studio?campaign={c.Id}")" StartIcon="@Icons.Material.Rounded.Add">このキャンペーンで投稿をつくる</MudButton>
    </div>
    <MudText Typo="Typo.body2" Class="mb-3">
        @(c.StartsOn is null ? "期間指定なし" : $"{c.StartsOn:yyyy/M/d}〜{c.EndsOn:M/d}") ・ @c.Objective.ToLabel()
        @if (c.Budget is { } b) { <span> ・ 予算 @b.ToString("N0")円</span> }
        ・ 対象：@(c.Platforms.Count == 0 ? "すべてのSNS" : string.Join("、", c.Platforms.Select(p => PlatformCatalog.Get(p).DisplayName)))
        @if (!string.IsNullOrWhiteSpace(c.Description)) { <br /><span>@c.Description</span> }
    </MudText>
    <MudPaper Class="pa-4 mb-4 rf-card" Elevation="0" Outlined="true">
        <MudText Typo="Typo.body1">@c.Kpi.ToLabel()：<b>@Campaigns.Format(c.Kpi, s.KpiActual)</b>@(c.KpiTarget is { } t ? $" ／ 目標 {Campaigns.Format(c.Kpi, t)}" : "")</MudText>
        @if (s.Progress is { } p)
        {
            <MudProgressLinear Value="@(Math.Min(100, p * 100))" Color="@(p >= 1 ? Color.Success : Color.Primary)" Class="mt-2" Size="Size.Large" aria-label="@($"目標の {p:P0}")" />
            <MudText Typo="Typo.caption">目標の @p.ToString("P0")（数値はシステムが計算）</MudText>
        }
    </MudPaper>

    @* A/B テスト *@
    <MudText Typo="Typo.h6" Class="mb-2">A/Bテスト</MudText>
    @if (_tests.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mb-3" Style="color:var(--rf-color-text-secondary)">下の投稿から「A/Bテストにする」を選ぶと、AIがB案をつくります。</MudText>
    }
    @foreach (var t in _tests)
    {
        <MudPaper Class="pa-4 mb-3 rf-card" Elevation="0" Outlined="true">
            <div class="d-flex align-center flex-wrap gap-2">
                <MudText Typo="Typo.subtitle1"><b>@t.Test.Name</b></MudText>
                <span class="rf-tag">@t.Test.Variable.ToLabel()を比べる</span>
                <span class="rf-tag">@(t.Test.Mode == AbMode.CrossChannel ? "別のSNSで同時に" : "同じSNSで1週間ずらす")</span>
                <MudSpacer />
                <span class="rf-tag">@t.Test.Status.ToLabel()</span>
            </div>
            @* 結論から、統計用語を使わずに表示する *@
            <MudAlert Severity="@(t.Test.Verdict is "AWins" or "BWins" ? Severity.Success : Severity.Info)" Dense="true" Class="mt-2">@t.Status</MudAlert>
            <MudGrid Class="mt-1">
                @foreach (var (label, v, ch, imp, rate) in new[] { ("A案", t.A, t.ChannelA, t.ImpressionsA, t.Test.RateA), ("B案", t.B, t.ChannelB, t.ImpressionsB, t.Test.RateB) })
                {
                    <MudItem xs="12" md="6">
                        @{ var winner = (t.Test.Verdict == "AWins" && label == "A案") || (t.Test.Verdict == "BWins" && label == "B案"); }
                        <MudPaper Elevation="0" Class="@(winner ? "pa-3 rf-ab-card is-winner" : "pa-3 rf-ab-card")">
                            <MudText Typo="Typo.caption"><b>@label</b>@(winner ? "（勝ち）" : "") ・ @PlatformCatalog.Get(v.Platform).DisplayName（@ch） ・ @v.Status.ToLabel()@((v.ScheduledAt ?? v.RequestedPublishAt) is { } at && v.PublishedAt is null ? $" ・ {Time.Short(at)}予定" : v.PublishedAt is { } pub ? $" ・ {Time.Short(pub)}公開" : "")</MudText>
                            @if (_editing == v.Id)
                            {
                                <MudTextField T="string" @bind-Value="_editBody" Lines="4" Variant="Variant.Outlined" Class="mt-1" />
                                <div class="d-flex gap-2 mt-1">
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SaveBodyAsync(v)">保存</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => _editing = null">やめる</MudButton>
                                </div>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Style="white-space:pre-wrap" Class="mt-1">@v.Body</MudText>
                                @if (v.MediaAssetIds.FirstOrDefault() is { } img && img != Guid.Empty) { <RfMediaImage AssetId="img" Alt="" Class="rf-thumb-sm mt-1" /> }
                                @if (t.Test.Status == AbTestStatus.Draft && label == "B案" && CanEdit)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => { _editing = v.Id; _editBody = v.Body; }">B案を直す</MudButton>
                                }
                            }
                            <MudText Typo="Typo.caption" Class="d-block mt-1">表示回数 @imp.ToString("N0")@(rate is { } r ? $" ・ 反応の割合 {r:P1}" : "")</MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
            @if (t.Test.Status == AbTestStatus.Draft && CanSchedule)
            {
                <div class="d-flex flex-wrap align-end gap-3 mt-3">
                    <MudDatePicker @bind-Date="_startDate" Label="A案の日付" Variant="Variant.Outlined" DateFormat="yyyy/MM/dd" Style="max-width:180px" />
                    <MudTimePicker @bind-Time="_startTime" Label="時刻" Variant="Variant.Outlined" MinuteSelectionStep="15" Style="max-width:140px" />
                    @if (t.Test.Variable == AbVariable.TimeSlot)
                    {
                        <MudTimePicker @bind-Time="_timeB" Label="B案の時刻（同じ日）" Variant="Variant.Outlined" MinuteSelectionStep="15" Style="max-width:180px" />
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => StartAsync(t.Test)">テストを始める</MudButton>
                    <MudButton Variant="Variant.Text" OnClick="() => CancelAsync(t.Test)">中止</MudButton>
                </div>
                <MudText Typo="Typo.caption" Class="d-block mt-1">
                    @(t.Test.Variable == AbVariable.TimeSlot ? "同じ日の別の時刻にB案を投稿します。"
                        : t.Test.Mode == AbMode.CrossChannel ? "A案とB案を同じ時刻に投稿します。"
                        : "B案はA案の1週間後、同じ曜日・時刻に投稿します（時間帯の影響を減らすため）。")
                    承認が必要な場合は、この日時で承認を依頼します。
                </MudText>
            }
        </MudPaper>
    }

    @* 投稿一覧（A案の候補） *@
    <MudText Typo="Typo.h6" Class="mt-4 mb-2">このキャンペーンの投稿</MudText>
    @if (_posts.Count == 0)
    {
        <MudText Typo="Typo.body2" Style="color:var(--rf-color-text-secondary)">まだ投稿がありません。「このキャンペーンで投稿をつくる」から始めましょう。</MudText>
    }
    else
    {
        <MudSimpleTable Dense="true" Elevation="0">
            <thead><tr><th>件名</th><th>SNS</th><th>状態</th><th></th></tr></thead>
            <tbody>
                @foreach (var (v, title, channel) in _posts)
                {
                    <tr>
                        <td>@title @if (v.AbGroup is not null) { <span class="rf-tag">@v.AbGroup 案</span> }</td>
                        <td>@PlatformCatalog.Get(v.Platform).DisplayName（@channel）</td>
                        <td>@v.Status.ToLabel()</td>
                        <td>
                            @if (CanEdit && v.AbGroup is null && v.Status is not (VariantStatus.Published or VariantStatus.Publishing or VariantStatus.Canceled or VariantStatus.Failed))
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => OpenCreate(v)">A/Bテストにする</MudButton>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }

    @if (_createFor is { } a)
    {
        <MudPaper Class="pa-4 mt-3 rf-ai-surface" Elevation="0" id="ab-create">
            <MudText Typo="Typo.h6">A/Bテストをつくる</MudText>
            <MudText Typo="Typo.caption" Class="d-block mb-2">A案：@PostText.Truncate(a.Body, 60)</MudText>
            <MudRadioGroup T="AbVariable" @bind-Value="_variable">
                @foreach (var v in Enum.GetValues<AbVariable>()) { <MudRadio Value="v">@v.ToLabel()</MudRadio> }
            </MudRadioGroup>
            @if (_variable != AbVariable.TimeSlot)
            {
                <MudRadioGroup T="AbMode" @bind-Value="_mode" Class="mt-2">
                    <MudRadio Value="AbMode.SameChannelStaggered">同じSNSで日時をずらす</MudRadio>
                    <MudRadio Value="AbMode.CrossChannel">別のSNSで同時に比べる</MudRadio>
                </MudRadioGroup>
            }
            @if (_mode == AbMode.CrossChannel && _variable != AbVariable.TimeSlot)
            {
                <MudSelect T="Guid?" @bind-Value="_channelB" Label="B案を投稿するSNS" Variant="Variant.Outlined" Class="mt-2">
                    @foreach (var ch in _channels.Where(x => x.Id != a.ChannelId)) { <MudSelectItem T="Guid?" Value="ch.Id">@ch.DisplayName</MudSelectItem> }
                </MudSelect>
            }
            @if (_variable == AbVariable.Image)
            {
                <MudSelect T="Guid?" @bind-Value="_imageB" Label="B案の画像" Variant="Variant.Outlined" Class="mt-2">
                    @foreach (var m in _images) { <MudSelectItem T="Guid?" Value="m.Id">@m.FileName</MudSelectItem> }
                </MudSelect>
            }
            <MudText Typo="Typo.caption" Class="d-block mt-2">
                @(_variable is AbVariable.Hook or AbVariable.Cta ? "AIが指定した部分だけを変えたB案をつくります（1クレジット）。作成後に直せます。" : "本文はA案と同じです。")
            </MudText>
            <div class="d-flex gap-2 mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="CreateAsync" Disabled="_busy">B案をつくる</MudButton>
                <MudButton Variant="Variant.Text" OnClick="() => _createFor = null">やめる</MudButton>
            </div>
        </MudPaper>
    }
}
else
{
    <MudSkeleton Height="200px" />
}

@code {
    private CampaignService CampaignSvc => Scoped<CampaignService>();
    private AbTestService AbTests => Scoped<AbTestService>();
    private StudioService Studio => Scoped<StudioService>();
    private ChannelService Channels => Scoped<ChannelService>();
    private MediaService Media => Scoped<MediaService>();

    [Parameter] public Guid Id { get; set; }

    private CampaignSummary? _summary;
    private IReadOnlyList<AbTestView> _tests = [];
    private IReadOnlyList<(PostVariant Variant, string Title, string ChannelName)> _posts = [];
    private IReadOnlyList<Channel> _channels = [];
    private IReadOnlyList<MediaAsset> _images = [];
    private PostVariant? _createFor;
    private AbVariable _variable = AbVariable.Hook;
    private AbMode _mode = AbMode.SameChannelStaggered;
    private Guid? _channelB, _imageB, _editing;
    private string _editBody = "";
    private DateTime? _startDate;
    private TimeSpan? _startTime = new(19, 0, 0), _timeB = new(12, 0, 0);
    private bool _busy;

    private bool CanEdit => RolePolicy.Can(Tenant.Role, Permission.Generate);
    private bool CanSchedule => RolePolicy.Can(Tenant.Role, Permission.Schedule);

    protected override async Task OnParametersSetAsync()
    {
        await Time.ZoneAsync();
        _startDate = Time.ToLocal(Time.Now).Date.AddDays(1);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _summary = await CampaignSvc.GetAsync(Id, CancellationToken.None);
            _tests = await AbTests.ListAsync(Id, CancellationToken.None);
            _posts = await CampaignSvc.PostsAsync(Id, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private async Task OpenCreate(PostVariant v)
    {
        _createFor = v;
        _variable = AbVariable.Hook;
        _mode = AbMode.SameChannelStaggered;
        _channelB = null;
        _imageB = null;
        try
        {
            _channels = (await Channels.ListAsync(CancellationToken.None)).Where(c => c.Status == ChannelStatus.Active).ToList();
            _images = (await Media.ListAsync(MediaFilter.All, CancellationToken.None)).Where(m => m.Kind == MediaKind.Image).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private async Task CreateAsync()
    {
        _busy = true;
        try
        {
            await AbTests.CreateAsync(new CreateAbTest
            {
                VariantAId = _createFor!.Id, Variable = _variable,
                Mode = _variable == AbVariable.TimeSlot ? AbMode.SameChannelStaggered : _mode,
                ChannelBId = _channelB, ImageAssetIdB = _imageB,
            }, CancellationToken.None);
            Snackbar.Add("B案をつくりました。内容を確認してテストを始めてください", Severity.Success);
            _createFor = null;
            await LoadAsync();
            await State.RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveBodyAsync(PostVariant v)
    {
        try
        {
            await Studio.UpdateVariantAsync(v.Id, _editBody, v.Hashtags, v.Title, null, CancellationToken.None);
            _editing = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private async Task StartAsync(AbTest test)
    {
        if (_startDate is null || _startTime is null) return;
        try
        {
            var start = Time.FromLocal(_startDate.Value.Date + _startTime.Value);
            DateTimeOffset? b = test.Variable == AbVariable.TimeSlot && _timeB is { } tb ? Time.FromLocal(_startDate.Value.Date + tb) : null;
            await AbTests.StartAsync(test.Id, start, b, CancellationToken.None);
            Snackbar.Add(State.Workspace?.RequiresApproval == true ? "承認を依頼しました。承認されると予約されます" : "予約しました", Severity.Success);
            await LoadAsync();
            await State.RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private async Task CancelAsync(AbTest test)
    {
        try
        {
            await AbTests.CancelAsync(test.Id, CancellationToken.None);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }
}
