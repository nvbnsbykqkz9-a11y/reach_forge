@page "/lp/{Id:guid}"
@* LP からつくったもの：縦型・横型の動画と、SNS の形式ごとの広告画像・広告文・投稿文。ダウンロード・コピーして、各 SNS に手動でアップロードする *@
@inherits RfComponentBase
@inject TimeDisplay Time
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Nav
@inject ILogger<LpProjectPage> Log

@if (_project is not { } p)
{
    <PageTitle>つくったもの｜ReachForge</PageTitle>
    @if (_notFound)
    {
        <RfEmptyState Title="見つかりません" Message="削除されたか、別のワークスペースのものです。" ActionText="一覧へ" ActionHref="/lp" />
    }
    else
    {
        <MudProgressLinear Indeterminate="true" />
    }
}
else
{
    <PageTitle>@p.Title｜ReachForge</PageTitle>
    <div class="rf-page-header">
        <div style="min-width:0">
            <MudText Typo="Typo.h4" tabindex="-1" Style="overflow-wrap:anywhere">@p.Title</MudText>
            <MudLink Href="@p.Url" Target="_blank" Typo="Typo.caption" Style="word-break:break-all">@p.Url</MudLink>
            <MudText Typo="Typo.caption" Class="d-block">@Time.Short(p.CreatedAt) につくりました</MudText>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <MudButton Href="@($"/api/v1/lp/{p.Id}/download")" download="" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Rounded.FolderZip" Disabled="@(p.Status != LpProjectStatus.Ready)">まとめてダウンロード（ZIP）</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Rounded.Delete" OnClick="DeleteAsync">削除</MudButton>
        </div>
    </div>

    @if (p.Status == LpProjectStatus.Failed)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">つくれませんでした：@p.Error</MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            できたものをダウンロード・コピーして、各 SNS のアプリや広告マネージャーから<b>ご自身でアップロード</b>してください。
            「まとめてダウンロード」で、動画・SNS ごとの画像・文章（テキストファイル）を1つの ZIP で保存できます。
        </MudAlert>
    }

    @if (p.MediaJobId is not null)
    {
        <MudPaper Class="pa-4 mb-4 rf-card" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6">広告の画像と動画</MudText>
            <MudText Typo="Typo.caption" Class="d-block mb-2">
                AI が LP の画像の商品を使って広告の写真をつくり、SNS の形式ごとに書き出します。動画は縦型（9:16）・横型（16:9）を、使う SNS に合わせてつくります。
            </MudText>
            @if (_job is null || !_job.IsFinished)
            {
                @if (_job is not null)
                {
                    <RfJobProgress JobId="_job.Id" Title="広告の画像と動画をつくっています" EstimatedSeconds="600" OnFinished="JobFinishedAsync" />
                }
            }
            else if (_job.Status != AiJobStatus.Succeeded)
            {
                <MudAlert Severity="Severity.Error">画像・動画をつくれませんでした：@(_job.Error ?? "もう一度お試しください。")</MudAlert>
            }
            else
            {
                @if (p.Visuals.Any(v => v.Fallback))
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-3" data-testid="fallback-warning">
                        一部の画像は AI でつくれなかったため、LP の画像を枠に収めるか、LP の色で描いた背景を使いました（画像生成の AI（Google・OpenAI）の設定・API キーを確認してください）。
                    </MudAlert>
                }
                @if (p.Direction.Mood.Length > 0 || p.Direction.Palette.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2">LP から読み取った世界観</MudText>
                    <div class="d-flex flex-wrap align-center gap-2 mb-3" data-testid="direction">
                        @foreach (var color in p.Direction.Palette)
                        {
                            <span title="@color" aria-label="@($"色 {color}")" style="display:inline-block;width:20px;height:20px;border-radius:50%;border:1px solid var(--rf-color-border, #ccc);background:@color"></span>
                        }
                        <MudText Typo="Typo.body2">@p.Direction.Mood</MudText>
                    </div>
                }
                @if (p.Visuals.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2">広告のビジュアル案</MudText>
                    <ul class="mb-3" style="margin-top:4px">
                        @foreach (var (v, i) in p.Visuals.Select((v, i) => (v, i + 1)))
                        {
                            <li><MudText Typo="Typo.body2">案@(i)：@(v.Angle.Length > 0 ? v.Angle : "商品の魅力")@(v.Headline.Length > 0 ? $"（見出し「{v.Headline}」）" : "")@(v.Kind == LpSourceKind.Screen ? "・画面を端末の枠に入れて使用" : "")@(v.Retried ? "・AI の確認でつくり直し" : "")</MudText></li>
                        }
                    </ul>
                }
                @foreach (var (orientation, video) in p.Videos.OrderBy(v => v.Key))
                {
                    var summary = _summaries.GetValueOrDefault(orientation);
                    var label = MediaFormat.OrientationLabel(orientation);
                    var landscape = orientation == MediaOrientation.Landscape;
                    var uses = LpStudioService.Supported.Where(p.Outputs.ContainsKey)
                        .SelectMany(sns => p.Outputs[sns].Videos.Where(x => x.AssetId == video).Select(x => $"{PlatformCatalog.Get(sns).DisplayName}（{x.Label}）"));
                    <div class="d-flex flex-wrap gap-4 align-start mb-4" data-testid="@($"video-{orientation.ToString().ToLowerInvariant()}")">
                        <div style="@(landscape ? "width:420px" : "width:220px");max-width:100%">
                            <RfMediaImage AssetId="video" Controls="true" Alt="@($"LP からつくった{label}の動画")" />
                        </div>
                        <div style="flex:1;min-width:240px">
                            <MudText Typo="Typo.subtitle1"><b>@(label)の動画（@(landscape ? "16:9・1920×1080" : "9:16・1080×1920")）</b></MudText>
                            <MudText Typo="Typo.caption" Class="d-block mb-2">使う SNS：@string.Join("、", uses)</MudText>
                            @if (summary?.NarrationError is { } narrationError)
                            {
                                <MudAlert Severity="Severity.Warning" Class="mb-2" data-testid="narration-warning">ナレーションなしで仕上げました。@narrationError</MudAlert>
                            }
                            <MudButton Href="@($"/api/v1/files/{video}")" download="" Variant="Variant.Outlined" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Rounded.Download">@(label)の動画をダウンロード（MP4）</MudButton>
                            @if (summary is { } s)
                            {
                                <MudText Typo="Typo.subtitle2" Class="mt-3">動画に添える文章の例</MudText>
                                <MudPaper Class="pa-2 mt-1" Elevation="0" Outlined="true" Style="white-space:pre-wrap">@PostText.Compose(s.PostText, s.Hashtags)</MudPaper>
                                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.ContentCopy" Class="mt-1"
                                           OnClick="() => CopyAsync(PostText.Compose(s.PostText, s.Hashtags))">コピー</MudButton>
                            }
                        </div>
                    </div>
                }
            }
        </MudPaper>
    }

    @if (p.Outputs.Count > 0)
    {
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-4">
            @foreach (var platform in LpStudioService.Supported.Where(p.Outputs.ContainsKey))
            {
                var o = p.Outputs[platform];
                var c = PlatformCatalog.Get(platform);
                <MudTabPanel Text="@c.DisplayName">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true">
                                <MudText Typo="Typo.h6">投稿文</MudText>
                                <MudText Typo="Typo.caption" Class="d-block mb-2">@c.DisplayName にふつうに投稿するときの文章です。</MudText>
                                <MudPaper Class="pa-2" Elevation="0" Outlined="true" Style="white-space:pre-wrap">@LpStudioService.PostTextOf(o)</MudPaper>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.ContentCopy" Class="mt-2"
                                           OnClick="() => CopyAsync(LpStudioService.PostTextOf(o))">投稿文をコピー</MudButton>

                                @if (o.Images.Count > 0)
                                {
                                    @foreach (var group in o.Images.GroupBy(x => x.Key))
                                    {
                                        var first = group.First();
                                        <MudText Typo="Typo.h6" Class="mt-5">画像：@first.Label</MudText>
                                        <MudText Typo="Typo.caption" Class="d-block mb-2">@c.DisplayName の@(first.Label)の形式（@first.Width×@first.Height）です。</MudText>
                                        <div class="rf-media-grid">
                                            @foreach (var (image, i) in group.Select((x, i) => (x, i + 1)))
                                            {
                                                <div>
                                                    <RfMediaImage AssetId="image.AssetId" Alt="@($"{c.DisplayName} {first.Label}の画像 {i}")" ShowAiBadge="true"
                                                                  Style="@($"aspect-ratio:{first.Width}/{first.Height}")" />
                                                    <MudButton Href="@($"/api/v1/files/{image.AssetId}")" download="" Size="Size.Small" Variant="Variant.Text" FullWidth="true"
                                                               StartIcon="@Icons.Material.Rounded.Download" aria-label="@($"{first.Label}の画像 {i} をダウンロード")">ダウンロード</MudButton>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else if (o.ImageAssetIds.Count > 0)
                                {
                                    <MudText Typo="Typo.h6" Class="mt-5">画像</MudText>
                                    <div class="rf-media-grid">
                                        @foreach (var (asset, i) in o.ImageAssetIds.Select((a, i) => (a, i + 1)))
                                        {
                                            <div>
                                                <RfMediaImage AssetId="asset" Alt="@($"{c.DisplayName} 用の画像 {i}")" />
                                                <MudButton Href="@($"/api/v1/files/{asset}")" download="" Size="Size.Small" Variant="Variant.Text" FullWidth="true"
                                                           StartIcon="@Icons.Material.Rounded.Download" aria-label="@($"画像 {i} をダウンロード")">ダウンロード</MudButton>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (_job is { IsFinished: false })
                                {
                                    <MudText Typo="Typo.body2" Class="mt-5" Style="color:var(--rf-color-text-secondary)">画像は上でつくっています…</MudText>
                                }
                                @if (o.Videos.Count > 0)
                                {
                                    <MudText Typo="Typo.h6" Class="mt-5">動画</MudText>
                                    @foreach (var v in o.Videos)
                                    {
                                        <MudButton Href="@($"/api/v1/files/{v.AssetId}")" download="" Size="Size.Small" Variant="Variant.Outlined" Class="mr-2 mt-1"
                                                   StartIcon="@Icons.Material.Rounded.Download">@v.Label（@v.Width×@v.Height）</MudButton>
                                    }
                                }
                                <MudText Typo="Typo.subtitle2" Class="mt-4">アップロードするところ</MudText>
                                <div class="d-flex flex-wrap gap-2 mt-1">
                                    <MudButton Href="@RfSns.PostUrl(platform)" Target="_blank" Size="Size.Small" Variant="Variant.Outlined"
                                               EndIcon="@Icons.Material.Rounded.OpenInNew">@c.DisplayName を開く</MudButton>
                                    <MudButton Href="@RfSns.AdsUrl(platform)" Target="_blank" Size="Size.Small" Variant="Variant.Outlined"
                                               EndIcon="@Icons.Material.Rounded.OpenInNew">@RfSns.AdsName(platform) を開く</MudButton>
                                </div>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true">
                                <MudText Typo="Typo.h6">広告文の案</MudText>
                                <MudText Typo="Typo.caption" Class="d-block mb-2">@RfSns.AdsName(platform) の入力欄（見出し・本文・説明・ボタン）にそのまま使えます。</MudText>
                                @foreach (var (copy, i) in o.AdCopies.Select((x, i) => (x, i + 1)))
                                {
                                    <MudPaper Class="pa-3 mt-2" Elevation="0" Outlined="true">
                                        <MudText Typo="Typo.overline">案 @i</MudText>
                                        @if (copy.Headline.Length > 0) { <MudText Typo="Typo.subtitle1"><b>@copy.Headline</b></MudText> }
                                        <MudText Typo="Typo.body2" Style="white-space:pre-wrap">@copy.PrimaryText</MudText>
                                        @if (copy.Description.Length > 0) { <MudText Typo="Typo.caption" Class="d-block">@copy.Description</MudText> }
                                        <MudText Typo="Typo.caption" Class="d-block mt-1">ボタン：@LpStudioService.CtaLabel(copy.CallToAction)</MudText>
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.ContentCopy" Class="mt-2"
                                                   OnClick="() => CopyAsync(LpStudioService.AdCopyText(copy))">案 @i をコピー</MudButton>
                                    </MudPaper>
                                }
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
            }
        </MudTabs>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private LpStudioService Lp => Scoped<LpStudioService>();

    private LpProject? _project;
    private AiJob? _job;
    private Dictionary<MediaOrientation, LandingPageVideoSummary> _summaries = [];
    private bool _notFound;

    protected override async Task OnParametersSetAsync()
    {
        await Time.ZoneAsync();
        try
        {
            _project = await Lp.ReloadAsync(Id, CancellationToken.None);
            await LoadJobAsync();
        }
        catch (NotFoundException)
        {
            _notFound = true;
        }
    }

    private async Task LoadJobAsync(AiJob? finished = null)
    {
        _job = finished ?? await Lp.MediaJobAsync(_project!, CancellationToken.None);
        _summaries = [];
        foreach (var (orientation, video) in _project!.Videos)
        {
            if (VideoService.LandingPageSummaryOf(await Scoped<MediaService>().GetAsync(video, CancellationToken.None)) is { } summary)
            {
                _summaries[orientation] = summary;
            }
        }
    }

    /// <summary>ジョブが終わったら、ジョブが書き込んだ画像・動画を読み直す。</summary>
    private async Task JobFinishedAsync(AiJob job)
    {
        _project = await Lp.ReloadAsync(Id, CancellationToken.None);
        await LoadJobAsync(job);
    }

    private async Task CopyAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Snackbar.Add("コピーしました", Severity.Info);
        }
        catch (JSException)
        {
            Snackbar.Add("コピーできませんでした。文章を選んでコピーしてください", Severity.Warning);
        }
    }

    private async Task DeleteAsync()
    {
        var ok = await Dialogs.ShowMessageBoxAsync("一覧から削除しますか？", "ダウンロードしたファイルは消えません。", yesText: "削除する", cancelText: "やめる");
        if (ok != true) return;
        try
        {
            await Lp.DeleteAsync(Id, CancellationToken.None);
            Nav.NavigateTo("/lp");
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex, Log);
        }
    }
}
