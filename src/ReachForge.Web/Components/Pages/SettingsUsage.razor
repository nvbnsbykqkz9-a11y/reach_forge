@page "/settings/usage"
@inject WorkspaceService Workspaces
@inject WebTenantContext Tenant

<PageTitle>プラン・利用量｜ReachForge</PageTitle>

<div class="rf-page-header">
    <MudText Typo="Typo.h4" tabindex="-1">プラン・利用量</MudText>
</div>

@if (_usage is { } u)
{
    var used = u.Account.MonthlyGrant - u.Account.Balance;
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6">今月のクレジット</MudText>
                <div class="rf-kpi-value">@u.Account.Available.ToString("N0") <MudText Typo="Typo.body2" Inline="true">／ @u.Account.MonthlyGrant.ToString("N0") 残り</MudText></div>
                <MudProgressLinear Value="@(u.Account.MonthlyGrant == 0 ? 0 : 100.0 * used / u.Account.MonthlyGrant)"
                                   Color="@(u.Account.IsLow ? Color.Warning : Color.Primary)" Size="Size.Large" Class="my-2"
                                   aria-label="@($"今月の消費 {used} クレジット")" />
                <MudText Typo="Typo.body2">
                    @(u.ProjectedExhaustion is { } d ? $"このペースだと {d:M/d} に上限に達します。" : "今月はまだ消費がありません。")
                </MudText>
                <MudText Typo="Typo.caption" Style="color:var(--rf-color-text-secondary)">失敗・ブロックされた生成ではクレジットは消費されません。残り20%でお知らせし、0%でAI生成を停止します（予約投稿の配信は続きます）。</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">機能別の消費</MudText>
                @if (u.ByFeature.Count == 0)
                {
                    <MudText Typo="Typo.body2">今月はまだAIを使っていません。</MudText>
                }
                @foreach (var f in u.ByFeature)
                {
                    var max = Math.Max(1, u.ByFeature.Max(x => x.Credits));
                    <div class="d-flex align-center gap-2 mb-1">
                        <MudText Typo="Typo.body2" Style="width:110px">@f.Label</MudText>
                        <MudProgressLinear Value="@(100.0 * f.Credits / max)" Color="Color.Secondary" Size="Size.Medium" Style="flex:1" aria-hidden="true" />
                        <MudText Typo="Typo.body2" Style="width:60px;text-align:right">@f.Credits</MudText>
                    </div>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12">
            <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6">SNS費用（別枠）</MudText>
                <MudText Typo="Typo.body2">X API：今月 @u.XPostsThisPeriod 件の投稿、推定 $@u.EstimatedSnsCostUsd.ToString("0.000")</MudText>
                <MudText Typo="Typo.caption" Style="color:var(--rf-color-text-secondary)">URL付き投稿は1件あたり約 $0.20、URLなしは約 $0.015 です（2026年4月の料金改定）。</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private UsageSummary? _usage;

    protected override async Task OnInitializedAsync() => _usage = await Workspaces.UsageAsync(CancellationToken.None);
}
