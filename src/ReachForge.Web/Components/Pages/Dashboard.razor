@page "/"
@* ホーム（初心者向け）：SNS を選んで投稿・広告をつくる入り口と、最近の投稿。はじめての人には最初にやることを案内する *@
@inherits RfComponentBase
@inject WebTenantContext Tenant
@inject TimeDisplay Time
@inject AppState State
@inject Microsoft.Extensions.Options.IOptions<ReachForge.AI.AiOptions> Ai

<PageTitle>ホーム｜ReachForge</PageTitle>

<div class="rf-page-header">
    <MudText Typo="Typo.h4" tabindex="-1">@Greeting、@(Tenant.UserName)さん</MudText>
</div>

@if (_channels is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    @if (!AiReady || _channels.Count == 0)
    {
        <MudPaper Class="pa-4 mb-4 rf-card" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6">はじめにやること</MudText>
            <MudList T="string" Dense="true" Class="mt-1" aria-label="はじめにやること">
                <MudListItem T="string" Icon="@(AiReady ? Icons.Material.Rounded.CheckCircle : Icons.Material.Rounded.RadioButtonUnchecked)"
                             IconColor="@(AiReady ? Color.Success : Color.Default)" Href="/settings/ai">
                    1. 生成AI の API キーを設定する（文章・画像・動画づくりに使います）
                </MudListItem>
                <MudListItem T="string" Icon="@(_channels.Count > 0 ? Icons.Material.Rounded.CheckCircle : Icons.Material.Rounded.RadioButtonUnchecked)"
                             IconColor="@(_channels.Count > 0 ? Color.Success : Color.Default)" Href="/settings/channels">
                    2. 使う SNS とつなぐ
                </MudListItem>
            </MudList>
        </MudPaper>
    }

    <MudText Typo="Typo.h6" Class="mb-2">どの SNS でつくりますか？</MudText>
    <MudGrid>
        @foreach (var c in RfSns.Creatable)
        {
            var channel = _channels.FirstOrDefault(x => x.Platform == c.Platform);
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true" Style="height:100%">
                    <div class="d-flex align-center">
                        <span class="rf-sns-dot rf-sns-dot-lg" style="background:@RfSns.Color(c.Platform)" aria-hidden="true"></span>
                        <MudText Typo="Typo.h6">@c.DisplayName</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Class="mt-1" Style="min-height:3em">@RfSns.Intro(c.Platform)</MudText>
                    <MudText Typo="Typo.caption" Class="d-block mt-1" Style="color:var(--rf-color-text-secondary)">
                        @(channel is null ? "まだつないでいません" : $"{channel.DisplayName} と連携中")
                    </MudText>
                    <MudButton Href="@RfSns.CreateHref(c.Platform)" Variant="@(channel is null ? Variant.Outlined : Variant.Filled)" Color="Color.Primary"
                               FullWidth="true" Class="mt-3" aria-label="@($"{c.DisplayName} で投稿・広告をつくる")">
                        @(channel is null ? "つないで始める" : "投稿・広告をつくる")
                    </MudButton>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudGrid Class="mt-4">
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6">最近の投稿</MudText>
                @if (_recent is { Count: > 0 })
                {
                    <MudList T="string" Dense="true" aria-label="最近の投稿">
                        @foreach (var p in _recent)
                        {
                            <MudListItem T="string" Href="@p.Url" Target="_blank">
                                <div class="d-flex align-center gap-2">
                                    <span class="rf-sns-dot" style="background:@RfSns.Color(p.Platform)" aria-hidden="true"></span>
                                    <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@PostText.Truncate(p.Body, 60)</span>
                                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(p.Status)">@StatusLabel(p.Status)</MudChip>
                                    <MudText Typo="Typo.caption" Style="white-space:nowrap">@Time.Short(p.At)</MudText>
                                </div>
                                @if (p.Status == VariantStatus.Failed && p.Error is not null)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block">@p.Error</MudText>
                                }
                            </MudListItem>
                        }
                    </MudList>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mt-2">まだ投稿がありません。上の SNS から1件つくってみましょう。</MudText>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6">受信箱</MudText>
                <MudText Typo="Typo.body1" Class="mt-1">
                    @(State.OpenInbox > 0 ? $"返信を待っているコメント・メッセージが {State.OpenInbox} 件あります。" : "返信待ちのコメント・メッセージはありません。")
                </MudText>
                <MudButton Href="/inbox" Variant="Variant.Text" Color="Color.Primary" Class="mt-2">受信箱を開く</MudButton>
            </MudPaper>
            <MudPaper Class="pa-4 rf-card mt-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6">広告</MudText>
                @if (_ads is { Count: > 0 })
                {
                    @foreach (var ad in _ads)
                    {
                        <div class="d-flex align-center gap-2 mt-2">
                            <span class="rf-sns-dot" style="background:@RfSns.Color(ad.Platform)" aria-hidden="true"></span>
                            <MudLink Href="@($"{RfSns.CreateHref(ad.Platform)}?tab=ad")" Typo="Typo.body2" Style="flex:1;min-width:0">@ad.Name</MudLink>
                            <MudChip T="string" Size="Size.Small" Color="@RfAdWizard.StatusColor(ad.Status)">@RfAdWizard.StatusLabel(ad.Status)</MudChip>
                        </div>
                    }
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mt-1">SNS の画面の「広告を出す」から、有料広告を出せます（お試しもできます）。</MudText>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private HomeService Home => Scoped<HomeService>();

    private IReadOnlyList<Channel>? _channels;
    private IReadOnlyList<RecentPost>? _recent;
    private IReadOnlyList<AdCampaign>? _ads;

    /// <summary>文章をつくる AI（Claude または OpenAI）のキーがあるか。</summary>
    private bool AiReady => Ai.Value.Providers.Any(p => p.Value.Type is ReachForge.AI.AiProviderType.Anthropic or ReachForge.AI.AiProviderType.OpenAI
                                                       && !string.IsNullOrWhiteSpace(p.Value.ApiKey));

    protected override async Task OnInitializedAsync()
    {
        _channels = await Home.ChannelsAsync(CancellationToken.None);
        _recent = await Home.RecentPostsAsync(10, CancellationToken.None);
        _ads = await Scoped<AdService>().RecentAsync(5, CancellationToken.None);
    }

    private string Greeting
    {
        get
        {
            var hour = Time.ToLocal(Time.Now).Hour;
            return hour switch { >= 18 => "こんばんは", >= 11 => "こんにちは", _ => "おはようございます" };
        }
    }

    private static string StatusLabel(VariantStatus s) => s switch
    {
        VariantStatus.Published => "投稿済み",
        VariantStatus.Publishing => "投稿中",
        VariantStatus.Scheduled => "投稿待ち",
        VariantStatus.Failed => "失敗",
        _ => "下書き",
    };

    private static Color StatusColor(VariantStatus s) => s switch
    {
        VariantStatus.Published => Color.Success,
        VariantStatus.Failed => Color.Error,
        VariantStatus.Scheduled or VariantStatus.Publishing => Color.Info,
        _ => Color.Default,
    };
}
