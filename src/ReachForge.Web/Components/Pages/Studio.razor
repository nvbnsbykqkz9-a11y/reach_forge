@page "/studio"
@inject TrendService Trends
@using ReachForge.Domain.Analytics
@inject StudioService StudioSvc
@inject MediaService MediaSvc
@inject ChannelService Channels
@inject WorkspaceService Workspaces
@inject ApprovalService Approvals
@inject SchedulingService Scheduling
@inject IBrandContextProvider BrandContext
@inject WebTenantContext Tenant
@inject TimeDisplay Time
@inject AppState State
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject ILogger<Studio> Log

<PageTitle>AIコンテンツスタジオ｜ReachForge</PageTitle>

<div class="rf-page-header">
    <MudText Typo="Typo.h4" tabindex="-1">AIコンテンツスタジオ</MudText>
    <span class="rf-spacer"></span>
    <nav aria-label="作成ステップ" class="d-flex gap-2 flex-wrap">
        @foreach (var (step, label) in Steps)
        {
            <MudButton Variant="@(_step == step ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small"
                       aria-current="@(_step == step ? "step" : null)" OnClick="() => GoToAsync(step)">@step @label</MudButton>
        }
    </nav>
</div>

@if (!RolePolicy.Can(Tenant.Role, Permission.Generate))
{
    <MudAlert Severity="Severity.Info" Class="mb-4">@Tenant.Role.ToLabel()のロールでは投稿をつくれません。編集者以上のロールでご利用ください。</MudAlert>
}

@switch (_step)
{
    case 1:
        <MudGrid>
            @* ① 何を伝えますか？ *@
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.h6" Class="mb-3">① 何を伝えますか？</MudText>

                    <MudText Typo="Typo.body2" Class="mb-1"><b>目的</b></MudText>
                    <MudChipSet T="PostObjective" @bind-SelectedValue="_objective" SelectionMode="SelectionMode.SingleSelection" CheckMark="true">
                        @foreach (var o in new[] { PostObjective.Traffic, PostObjective.Awareness, PostObjective.Conversion, PostObjective.Engagement })
                        {
                            <MudChip T="PostObjective" Value="o" Variant="Variant.Outlined">@o.ToLabel()</MudChip>
                        }
                    </MudChipSet>

                    <MudTextField @bind-Value="_theme" Label="テーマ（必須）" Variant="Variant.Outlined" Lines="3" Sizing="InputSizing.Auto"
                                  MaxLength="500" Counter="500" Class="mt-4"
                                  Placeholder="例：秋の新メニュー、週末のイベント、スタッフ紹介"
                                  HelperText="何を伝えたいかを1〜2文で書いてください" Immediate="true" />
                    @if (string.IsNullOrWhiteSpace(_theme))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Rounded.AutoAwesome"
                                   OnClick="Omakase">おまかせ（季節の話題から）</MudButton>
                    }

                    <MudSelect T="Guid" Label="商品・サービス" Variant="Variant.Outlined" Class="mt-3" MultiSelection="true"
                               @bind-SelectedValues="_productIds" ToStringFunc="@(id => _products.FirstOrDefault(p => p.Id == id)?.Name ?? "")">
                        @foreach (var p in _products)
                        {
                            <MudSelectItem T="Guid" Value="p.Id">@p.Name@(p.Price is { } yen ? $"（{yen:N0}円）" : "")</MudSelectItem>
                        }
                    </MudSelect>

                    <MudText Typo="Typo.body2" Class="mt-4 mb-1"><b>投稿先</b></MudText>
                    @if (_channels.Count == 0)
                    {
                        <MudText Typo="Typo.body2">SNSが連携されていません。<MudLink Href="/settings/channels">SNSを連携する</MudLink></MudText>
                    }
                    @foreach (var c in _channels)
                    {
                        <MudCheckBox T="bool" Value="_selectedChannels.Contains(c.Id)" ValueChanged="v => Toggle(c.Id, v)"
                                     Label="@($"{PlatformCatalog.Get(c.Platform).DisplayName}（{c.DisplayName}）")" Dense="true" />
                    }

                    <MudExpansionPanels Class="mt-3" Elevation="0">
                        <MudExpansionPanel Text="詳しい設定（文体・案数・キャンペーン・リンク）">
                            <MudSelect T="CopyFramework" @bind-Value="_framework" Label="構成の型" Variant="Variant.Outlined" Dense="true">
                                @foreach (var f in Enum.GetValues<CopyFramework>())
                                {
                                    <MudSelectItem T="CopyFramework" Value="f">@f.ToLabel()</MudSelectItem>
                                }
                            </MudSelect>
                            <MudNumericField T="int" @bind-Value="_count" Label="案の数" Min="1" Max="5" Variant="Variant.Outlined" Class="mt-3" Margin="Margin.Dense" />
                            <MudSelect T="Guid?" @bind-Value="_campaignId" Label="キャンペーン" Variant="Variant.Outlined" Class="mt-3" Dense="true" Clearable="true">
                                @foreach (var c in _campaigns)
                                {
                                    <MudSelectItem T="Guid?" Value="c.Id">@c.Name@(c.IsAdvertisement ? "（広告）" : "")</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField @bind-Value="_extra" Label="追加の希望" Variant="Variant.Outlined" Lines="2" Class="mt-3" />
                        </MudExpansionPanel>
                    </MudExpansionPanels>

                    <div class="mt-4">
                        <RfAiButton Text="@($"AIで{_count}案つくる（約{Credits(CreditOperation.CopyGeneration)}クレジット）")" BusyText="@($"{_count}つの案を書いています…")"
                                    EstimatedCredits="Credits(CreditOperation.CopyGeneration)" IsBusy="_generating" FullWidth="true"
                                    DisabledReason="@GenerateDisabledReason" OnClick="GenerateAsync" />
                    </div>
                </MudPaper>
            </MudItem>

            @* ② AIの案 *@
            <MudItem xs="12" md="4">
                <div class="d-flex align-center mb-2">
                    <MudText Typo="Typo.h6">② AIの案</MudText>
                    <MudSpacer />
                    @if (_history.Count > 0)
                    {
                        <MudText Typo="Typo.caption">履歴（@_history.Count）</MudText>
                    }
                </div>
                <div aria-live="polite" class="rf-visually-hidden">@_announce</div>
                @if (_generating)
                {
                    @for (var i = 0; i < _count; i++)
                    {
                        <MudPaper Class="pa-4 mb-3 rf-ai-surface" Elevation="0">
                            <MudSkeleton Width="40%" /><MudSkeleton /><MudSkeleton /><MudSkeleton Width="60%" />
                        </MudPaper>
                    }
                }
                else if (_candidates.Count == 0)
                {
                    <RfEmptyState Icon="@Icons.Material.Rounded.AutoAwesome" Title="ここにAIの案が表示されます"
                                  Message="テーマを入れて「AIで3案つくる」を押してください。テーマを入れると精度が上がります。" />
                }
                else
                {
                    @foreach (var c in _candidates)
                    {
                        <RfAiCandidateCard Candidate="c" Selected="ReferenceEquals(c, _selected)" Busy="_refining"
                                           Expanded="c.Rank == 1" OnAdopt="() => Adopt(c)" OnQuickFix="fix => RefineAsync(c, fix)" />
                    }
                }
            </MudItem>

            @* ③ 選んだ内容 *@
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.h6" Class="mb-3">③ 選んだ内容</MudText>
                    @if (_selected is null && string.IsNullOrEmpty(_body))
                    {
                        <MudText Typo="Typo.body2" Style="color:var(--rf-color-text-secondary)">案を選ぶとここに表示されます。自分で書くこともできます。</MudText>
                    }
                    <MudTextField @bind-Value="_headline" Label="見出し" Variant="Variant.Outlined" Class="mt-2" Immediate="true" />
                    <MudTextField @bind-Value="_body" Label="本文" Variant="Variant.Outlined" Lines="6" Sizing="InputSizing.Auto" Class="mt-3"
                                  Immediate="true" Style="font-size:1rem;line-height:1.8" />
                    <MudTextField @bind-Value="_cta" Label="行動を促す一文（CTA）" Variant="Variant.Outlined" Class="mt-3" Immediate="true" />
                    <MudTextField @bind-Value="_tags" Label="ハッシュタグ（スペース区切り）" Variant="Variant.Outlined" Class="mt-3" Immediate="true" />
                    @if (_selected is not null)
                    {
                        <MudText Typo="Typo.caption" Class="mt-2 rf-ai-hint">✦ AI生成@(IsEdited ? "（編集あり）" : "")</MudText>
                    }
                    <MudText Typo="Typo.body2" Class="mt-4 mb-2"><b>画像</b>（Instagram は画像が必要です）</MudText>
                    <RfMediaPicker @bind-Selected="_mediaIds" Max="4" DefaultPrompt="@(string.IsNullOrWhiteSpace(_headline) ? _theme : _headline)" />
                    <MudText Typo="Typo.body2" Class="mt-4 mb-2"><b>確認結果</b></MudText>
                    <RfGuardrailPanel Findings="MasterFindings" OnApply="ApplyToMaster" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" FullWidth="true"
                               Disabled="@(string.IsNullOrWhiteSpace(_body))" OnClick="() => GoToAsync(2)">次へ：SNSごとに整える</MudButton>
                </MudPaper>
            </MudItem>
        </MudGrid>
        break;

    case 2:
        <MudPaper Class="pa-4 rf-card mb-4" Elevation="0" Outlined="true">
            <div class="d-flex flex-wrap align-center gap-3">
                <MudTextField @bind-Value="_linkUrl" Label="リンク先URL（任意）" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:320px"
                              HelperText="UTMパラメータを自動で付けます。Xは費用対策のため既定で本文に入れません。" />
                <MudSwitch T="bool" @bind-Value="_includeUrlForX" Color="Color.Warning" Label="XにもURLを入れる（費用が約13倍）" />
                <MudSpacer />
                <RfAiButton Text="@(_variants.Count == 0 ? $"SNS別に変換する（約{_selectedChannels.Count}クレジット）" : "下書きを作り直す")"
                            BusyText="SNSごとに整えています…" EstimatedCredits="_selectedChannels.Count" IsBusy="_converting"
                            DisabledReason="@(_selectedChannels.Count == 0 ? "投稿先のSNSを選んでください" : null)" OnClick="ConvertAsync" />
            </div>
        </MudPaper>

        @if (_variants.Count == 0)
        {
            <RfEmptyState Icon="@Icons.Material.Rounded.Transform" Title="SNSごとの下書きはまだありません"
                          Message="選んだSNSの文字数・ハッシュタグ・リンクの決まりに合わせて、AIが自動で書き分けます。" />
        }
        else
        {
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-4" @bind-ActivePanelIndex="_tab">
                @foreach (var v in _variants)
                {
                    var c = PlatformCatalog.Get(v.Platform);
                    var edit = _edits[v.Id];
                    <MudTabPanel Text="@c.DisplayName" Icon="@(v.HasGuardrailErrors ? Icons.Material.Rounded.Warning : Icons.Material.Rounded.CheckCircle)"
                                 IconColor="@(v.HasGuardrailErrors ? Color.Error : Color.Success)">
                        <MudGrid>
                            <MudItem xs="12" md="7">
                                <MudText Typo="Typo.body2" Class="mb-2" Style="color:var(--rf-color-text-secondary)">@c.Summary@(c.Note is null ? "" : $"　※{c.Note}")</MudText>
                                @if (c.MaxTitleLength is { } maxTitle)
                                {
                                    <MudTextField @bind-Value="edit.Title" Label="タイトル" Variant="Variant.Outlined" Immediate="true" />
                                    <RfCharCounter Text="@(edit.Title ?? "")" Max="maxTitle" />
                                }
                                <MudTextField @bind-Value="edit.Body" Label="本文" Variant="Variant.Outlined" Lines="8" Sizing="InputSizing.Auto" Immediate="true"
                                              Style="font-size:1rem;line-height:1.8" Class="mt-2" />
                                <RfCharCounter Text="@PostText.Compose(edit.Body, ParseTags(edit.Tags))" Max="c.MaxBodyLength" />
                                <MudTextField @bind-Value="edit.Tags" Label="ハッシュタグ（スペース区切り）" Variant="Variant.Outlined" Immediate="true" Class="mt-2"
                                              Disabled="@(c.MaxHashtags == 0)" HelperText="@(c.MaxHashtags == 0 ? $"{c.DisplayName}ではハッシュタグを使いません" : null)" />
                                <div class="d-flex align-center gap-3 mt-2">
                                    <RfCostHint Constraint="c" Text="@edit.Body" />
                                    @if (c.LinkPolicy == LinkPolicy.DiscouragedByCost && PostText.ContainsUrl(edit.Body))
                                    {
                                        <MudCheckBox T="bool" @bind-Value="edit.UrlAck" Label="URL付き投稿の費用を確認しました" Dense="true" />
                                    }
                                </div>
                                <div class="d-flex gap-2 mt-3">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SaveVariantAsync(v)">この内容で保存</MudButton>
                                    <RfStatusBadge Status="v.Status" At="v.ScheduledAt" />
                                </div>
                                <MudText Typo="Typo.body2" Class="mt-4 mb-2"><b>確認結果</b></MudText>
                                <RfGuardrailPanel Findings="v.GuardrailFindings" OnApply="f => ApplyToVariantAsync(v, f)" />
                            </MudItem>
                            <MudItem xs="12" md="5">
                                <div class="d-flex align-center mb-2">
                                    <MudText Typo="Typo.body2"><b>プレビュー</b></MudText>
                                    <MudSpacer />
                                    <MudSwitch T="bool" @bind-Value="_previewDark" Label="ダーク" />
                                </div>
                                <RfPlatformPreview Platform="v.Platform" Body="@edit.Body" Hashtags="ParseTags(edit.Tags)" Title="@edit.Title"
                                                   AccountName="@AccountName(v.ChannelId)" Dark="_previewDark"
                                                   ImageAssetId="@(v.MediaAssetIds.Count > 0 ? v.MediaAssetIds[0] : null)"
                                                   ImageAlt="@AltOf(v)" ImageIsAi="@IsAiImage(v)" ImageCount="v.MediaAssetIds.Count" />
                                @if (_mediaIds.Count > 0)
                                {
                                    <MudText Typo="Typo.body2" Class="mt-3 mb-1"><b>画像の比率（@c.ImageAspect）の合わせ方</b></MudText>
                                    <MudToggleGroup T="AspectMethod" Value="v.AspectMethod" ValueChanged="m => ChangeAspectAsync(v, m)" Size="Size.Small"
                                                    Color="Color.Primary" Disabled="_outpaintJobs.ContainsKey(v.Id)">
                                        <MudToggleItem Value="AspectMethod.SmartCrop" Text="自動トリミング" />
                                        <MudToggleItem Value="AspectMethod.Pad" Text="余白を付ける" />
                                        <MudToggleItem Value="AspectMethod.Outpaint" Text="✦ AIで広げる（5）" />
                                    </MudToggleGroup>
                                    <MudText Typo="Typo.caption" Class="d-block mt-1" Style="color:var(--rf-color-text-secondary)">
                                        引き伸ばしはしません。自動トリミングは写っているものが多い部分を残します。
                                    </MudText>
                                    @if (_outpaintJobs.TryGetValue(v.Id, out var jobId))
                                    {
                                        <div class="mt-2"><RfJobProgress JobId="jobId" Title="AIで画像を広げています" EstimatedSeconds="30" OnFinished="j => OutpaintFinishedAsync(v, j)" /></div>
                                    }
                                }
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>
                }
            </MudTabs>
            <div class="rf-sticky-actions">
                <MudButton Variant="Variant.Text" OnClick="() => GoToAsync(1)">戻る</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => GoToAsync(3)">次へ：確認して予約</MudButton>
            </div>
        }
        break;

    case 3:
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.h6" Class="mb-3">確認して予約</MudText>
                    @if (_variants.Count == 0)
                    {
                        <MudAlert Severity="Severity.Warning">SNSごとの下書きがありません。ステップ2で作成してください。</MudAlert>
                    }
                    else
                    {
                        <MudSimpleTable Dense="true" Hover="true" Bordered="false">
                            <thead><tr><th>SNS</th><th>状態</th><th>確認事項</th><th>文字数</th><th style="text-align:right">推定SNS費用</th></tr></thead>
                            <tbody>
                                @foreach (var v in _variants)
                                {
                                    var c = PlatformCatalog.Get(v.Platform);
                                    var text = PostText.Compose(v.Body, v.Hashtags);
                                    <tr>
                                        <td>@c.DisplayName</td>
                                        <td><RfStatusBadge Status="v.Status" At="v.ScheduledAt" /></td>
                                        <td>
                                            @if (v.HasGuardrailErrors)
                                            {
                                                <MudText Typo="Typo.body2" Color="Color.Error">⚠ 要修正 @v.GuardrailFindings.Count(f => f.Level == GuardrailLevel.Error)件</MudText>
                                            }
                                            else if (v.GuardrailLevel == GuardrailLevel.Warning)
                                            {
                                                <MudText Typo="Typo.body2">！確認 @v.GuardrailFindings.Count(f => f.Level == GuardrailLevel.Warning)件</MudText>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2" Style="color:var(--rf-color-success)">✓ OK</MudText>
                                            }
                                        </td>
                                        <td>@PostText.Length(text) / @c.MaxBodyLength</td>
                                        <td style="text-align:right">
                                            @(c.CostPerPostUsd is { } cost ? (PostText.ContainsUrl(text) ? $"${c.CostPerPostWithUrlUsd:0.00}" : $"${cost:0.000}") : "—")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                        @if (_variants.Any(v => v.Platform == SocialPlatform.Instagram && v.MediaAssetIds.Count == 0))
                        {
                            <MudAlert Severity="Severity.Warning" Class="mt-3">Instagram は画像がないと投稿できません。ステップ1で画像を選び、ステップ2で「下書きを作り直す」を押してください。</MudAlert>
                        }
                        @if (_variants.Any(v => v.HasGuardrailErrors))
                        {
                            <MudAlert Severity="Severity.Error" Class="mt-3">修正が必要なSNSがあります。ステップ2で修正案を適用してください。修正が終わるまで予約・承認依頼はできません。</MudAlert>
                        }
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.h6" Class="mb-1">公開日時</MudText>
                    <MudText Typo="Typo.caption" Style="color:var(--rf-color-text-secondary)">@Time.ZoneLabel</MudText>
                    <MudText Typo="Typo.body2" Class="mt-3 mb-1">おすすめの時刻</MudText>
                    <RfBestTimeSlots Slots="_bestTimes" OnSelect="SelectTime" />
                    <MudDatePicker @bind-Date="_date" Label="日付" Variant="Variant.Outlined" Class="mt-4" DateFormat="yyyy/MM/dd" />
                    <MudTimePicker @bind-Time="_time" Label="時刻（15分刻み）" Variant="Variant.Outlined" Class="mt-3" MinuteSelectionStep="15" />
                    @if (_requiresApproval)
                    {
                        <MudTextField @bind-Value="_comment" Label="承認者へのコメント（任意）" Variant="Variant.Outlined" Class="mt-3" />
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" FullWidth="true" Size="Size.Large"
                               Disabled="@(FinishDisabledReason is not null || _finishing)" OnClick="FinishAsync">
                        @(_requiresApproval ? "承認を依頼する" : "予約する")
                    </MudButton>
                    @if (FinishDisabledReason is { } reason)
                    {
                        <MudText Typo="Typo.caption" Class="mt-1" Style="color:var(--rf-color-text-secondary)">@reason</MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
        break;
}

@code {
    private static readonly (int Step, string Label)[] Steps = [(1, "内容をつくる"), (2, "SNSごとに整える"), (3, "確認して予約")];

    [SupplyParameterFromQuery(Name = "theme")] public string? ThemeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "campaign")] public Guid? CampaignQuery { get; set; }

    private sealed class VariantEdit
    {
        public string Body { get; set; } = "";
        public string Tags { get; set; } = "";
        public string? Title { get; set; }
        public bool UrlAck { get; set; }
    }

    private int _step = 1;
    private PostObjective _objective = PostObjective.Traffic;
    private string _theme = "";
    private IReadOnlyCollection<Guid> _productIds = new HashSet<Guid>();
    private CopyFramework _framework = CopyFramework.Auto;
    private int _count = 3;
    private Guid? _campaignId;
    private string? _extra;
    private readonly HashSet<Guid> _selectedChannels = [];

    private IReadOnlyList<Product> _products = [];
    private IReadOnlyList<Campaign> _campaigns = [];
    private IReadOnlyList<Channel> _channels = [];
    private bool _requiresApproval = true;

    private bool _generating, _refining, _converting, _finishing, _previewDark;
    private string _announce = "";
    private Guid? _generationId;
    private List<CopyCandidate> _candidates = [];
    private readonly List<CopyCandidate> _history = [];
    private CopyCandidate? _selected;
    private string _headline = "", _body = "", _cta = "", _tags = "";
    private BrandContext? _brand;
    private List<Guid> _mediaIds = [];
    private readonly Dictionary<Guid, Guid> _outpaintJobs = [];
    private IReadOnlyDictionary<Guid, MediaAsset> _assets = new Dictionary<Guid, MediaAsset>();

    private Guid? _masterId;
    private List<PostVariant> _variants = [];
    private readonly Dictionary<Guid, VariantEdit> _edits = [];
    private int _tab;
    private string? _linkUrl;
    private bool _includeUrlForX;

    private IReadOnlyList<BestTimeSlot> _bestTimes = [];
    private DateTime? _date;
    private TimeSpan? _time;
    private string? _comment;

    protected override async Task OnInitializedAsync()
    {
        await Time.ZoneAsync();
        _products = await Workspaces.ProductsAsync(CancellationToken.None);
        _campaigns = await Workspaces.CampaignsAsync(CancellationToken.None);
        _channels = await Channels.ListAsync(CancellationToken.None);
        _requiresApproval = (await Workspaces.CurrentAsync(CancellationToken.None)).RequiresApproval;
        foreach (var c in _channels.Where(c => c.Status == ChannelStatus.Active)) _selectedChannels.Add(c.Id);
        _brand = await BrandContext.BuildAsync(Tenant.WorkspaceId, null, null, CancellationToken.None);
        if (!string.IsNullOrWhiteSpace(ThemeQuery)) _theme = ThemeQuery;
        if (CampaignQuery is { } campaign && _campaigns.Any(c => c.Id == campaign)) _campaignId = campaign;
    }

    private string? GenerateDisabledReason =>
        !RolePolicy.Can(Tenant.Role, Permission.Generate) ? "このロールでは生成できません"
        : string.IsNullOrWhiteSpace(_theme) ? "テーマを入れてください"
        : null;

    private string? FinishDisabledReason =>
        _variants.Count == 0 ? "SNSごとの下書きを作成してください"
        : _variants.Any(v => v.HasGuardrailErrors) ? "確認結果にエラーがあるため進めません"
        : _date is null || _time is null ? "公開日時を選んでください"
        : null;

    private bool IsEdited => _selected is not null && (_selected.Body != _body || _selected.Headline != _headline || _selected.Cta != _cta);

    private IReadOnlyList<GuardrailFinding> MasterFindings =>
        _brand is null || string.IsNullOrWhiteSpace(_body)
            ? []
            : GuardrailChecker.CheckContent(PostText.Compose($"{_headline}\n{_body}\n{_cta}", ParseTags(_tags)), CurrentGuardrailContext()).Findings;

    private GuardrailContext CurrentGuardrailContext() =>
        _brand!.ToGuardrailContext() with { IsAdvertisement = _campaigns.FirstOrDefault(c => c.Id == _campaignId)?.IsAdvertisement ?? false };

    private static int Credits(CreditOperation op) => ReachForge.Domain.Credits.CreditTable.Cost(op);

    private CopyRequest BuildRequest() => new()
    {
        WorkspaceId = Tenant.WorkspaceId,
        Objective = _objective,
        Theme = _theme,
        ProductIds = _productIds.ToList(),
        Framework = _framework,
        Count = _count,
        TargetPlatforms = _channels.Where(c => _selectedChannels.Contains(c.Id)).Select(c => c.Platform).Distinct().ToList(),
        AdditionalInstructions = _extra,
        CampaignId = _campaignId,
    };

    private void Toggle(Guid id, bool on)
    {
        if (on) _selectedChannels.Add(id); else _selectedChannels.Remove(id);
    }

    /// <summary>「おまかせ」：ネタ帳の一番近いネタ、なければ季節イベントからテーマを提案する（RF-UX-001 SCR-05 ①）。</summary>
    private async Task Omakase()
    {
        var idea = (await Trends.ListAsync(CancellationToken.None)).FirstOrDefault();
        if (idea is not null)
        {
            _theme = idea.Angles.FirstOrDefault() is { } angle ? $"{idea.Topic}：{angle}" : $"{idea.Topic}（{idea.RecommendedDate:M/d}）に合わせた投稿";
            return;
        }
        var today = DateOnly.FromDateTime(Time.ToLocal(Time.Now));
        var next = SeasonalEvents.Upcoming(today, 45).FirstOrDefault();
        _theme = next.Name is null ? "今週のおすすめメニューの紹介" : $"{next.Name}（{next.Date:M/d}）に合わせたおすすめの紹介";
    }

    private async Task GenerateAsync()
    {
        _generating = true;
        _announce = "";
        try
        {
            var result = await StudioSvc.GenerateCopiesAsync(BuildRequest(), CancellationToken.None);
            _generationId = result.GenerationId;
            _history.AddRange(_candidates);
            _candidates = [.. result.Candidates];
            Adopt(_candidates[0]);
            _announce = $"{_candidates.Count}つの案ができました";
            if (result.Model.FallbackUsed) Snackbar.Add("第一候補のAIが混み合っていたため、代わりのAIで作成しました", Severity.Info);
            await State.RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex, Log);
        }
        finally
        {
            _generating = false;
        }
    }

    private async Task RefineAsync(CopyCandidate candidate, QuickFix fix)
    {
        _refining = true;
        try
        {
            var result = await StudioSvc.RefineCopyAsync(BuildRequest(),
                new GeneratedCopy(candidate.Headline, candidate.Body, candidate.Cta, candidate.Hashtags.ToArray()), fix, CancellationToken.None);
            var refined = result.Candidates[0] with { Rank = candidate.Rank };
            _history.Add(candidate);
            var index = _candidates.IndexOf(candidate);
            _candidates[index] = refined;
            if (ReferenceEquals(_selected, candidate)) Adopt(refined);
            _generationId = result.GenerationId;
            Snackbar.Add($"案{(char)('A' + candidate.Rank - 1)}を「{fix.ToLabel()}」で書き直しました（前の案は履歴に残っています）", Severity.Success);
            await State.RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex, Log);
        }
        finally
        {
            _refining = false;
        }
    }

    private void Adopt(CopyCandidate c)
    {
        _selected = c;
        _headline = c.Headline;
        _body = c.Body;
        _cta = c.Cta;
        _tags = string.Join(" ", c.Hashtags);
    }

    private void ApplyToMaster(GuardrailFinding f)
    {
        if (f.Code == GuardrailCodes.MissingPrDisclosure)
        {
            _body = "#PR " + _body;
            return;
        }
        _headline = f.Apply(_headline);
        _body = f.Apply(_body);
        _cta = f.Apply(_cta);
    }

    private async Task GoToAsync(int step)
    {
        if (step >= 2 && _step == 1 && !string.IsNullOrWhiteSpace(_body))
        {
            if (!await SaveMasterAsync()) return;
        }
        if (step == 3)
        {
            await RefreshVariantsAsync();
            _bestTimes = await Scheduling.BestTimesAsync(null, CancellationToken.None);
        }
        _step = step;
    }

    private async Task<bool> SaveMasterAsync()
    {
        try
        {
            var post = await StudioSvc.SaveMasterPostAsync(new SaveMasterPost
            {
                Id = _masterId,
                Title = _headline,
                Objective = _objective,
                Theme = _theme,
                CoreMessage = _body,
                Cta = _cta,
                Hashtags = ParseTags(_tags),
                ProductIds = _productIds.ToList(),
                CampaignId = _campaignId,
                AiGenerationId = _selected is null ? null : _generationId,
                IsAiEdited = IsEdited,
                MediaAssetIds = _mediaIds,
            }, CancellationToken.None);
            _masterId = post.Id;
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex, Log);
            return false;
        }
    }

    private async Task ConvertAsync()
    {
        if (_masterId is null && !await SaveMasterAsync()) return;
        _converting = true;
        try
        {
            _variants = [.. await StudioSvc.GenerateVariantsAsync(_masterId!.Value, _selectedChannels.ToList(),
                new VariantOptions(_linkUrl, _includeUrlForX), CancellationToken.None)];
            SyncEdits(force: true);
            await LoadAssetsAsync();
            Snackbar.Add($"{_variants.Count}つのSNS向けに整えました", Severity.Success);
            await State.RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex, Log);
        }
        finally
        {
            _converting = false;
        }
    }

    private async Task RefreshVariantsAsync()
    {
        if (_masterId is null) return;
        _variants = [.. await StudioSvc.GetVariantsAsync(_masterId.Value, CancellationToken.None)];
        SyncEdits(force: false);
    }

    private void SyncEdits(bool force)
    {
        foreach (var v in _variants)
        {
            if (!force && _edits.ContainsKey(v.Id)) continue;
            _edits[v.Id] = new VariantEdit { Body = v.Body, Tags = string.Join(" ", v.Hashtags), Title = v.Title, UrlAck = v.UrlCostAcknowledged };
        }
    }

    private async Task SaveVariantAsync(PostVariant v)
    {
        var edit = _edits[v.Id];
        try
        {
            var result = await StudioSvc.UpdateVariantAsync(v.Id, edit.Body, ParseTags(edit.Tags), edit.Title, edit.UrlAck, CancellationToken.None);
            var index = _variants.FindIndex(x => x.Id == v.Id);
            _variants[index] = result.Variant;
            Snackbar.Add(result.ReapprovalRequired ? "承認後に内容が変更されたため、再承認が必要です。" : "保存しました",
                result.ReapprovalRequired ? Severity.Warning : Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex, Log);
        }
    }

    private async Task ApplyToVariantAsync(PostVariant v, GuardrailFinding f)
    {
        var edit = _edits[v.Id];
        edit.Body = f.Code == GuardrailCodes.MissingPrDisclosure ? "#PR " + edit.Body : f.Apply(edit.Body);
        await SaveVariantAsync(v);
    }

    private void SelectTime(DateTimeOffset at)
    {
        var local = Time.ToLocal(at);
        _date = local.Date;
        _time = local.TimeOfDay;
    }

    private async Task FinishAsync()
    {
        _finishing = true;
        try
        {
            var at = Time.FromLocal(_date!.Value.Date + _time!.Value);
            var targets = _variants.Where(v => v.Status is VariantStatus.Draft or VariantStatus.Approved or VariantStatus.OnHold).ToList();
            if (_requiresApproval)
            {
                var drafts = targets.Where(v => v.Status == VariantStatus.Draft).Select(v => v.Id).ToList();
                await Approvals.SubmitAsync(drafts, at, _comment, CancellationToken.None);
                Snackbar.Add($"承認を依頼しました（{Time.Short(at)} 公開予定・{drafts.Count}件）", Severity.Success);
            }
            else
            {
                foreach (var v in targets) await Scheduling.ScheduleAsync(v.Id, at, CancellationToken.None);
                Snackbar.Add($"{Time.Short(at)} に {targets.Count}件のSNSで公開します", Severity.Success);
            }
            await RefreshVariantsAsync();
            await State.RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex, Log);
        }
        finally
        {
            _finishing = false;
        }
    }

    private async Task ChangeAspectAsync(PostVariant v, AspectMethod method)
    {
        try
        {
            if (method == AspectMethod.Outpaint)
            {
                var ok = await Dialogs.ShowMessageBoxAsync("AIで画像を広げますか？",
                    "足りない部分をAIが描き足して、この SNS の比率に合わせます。約5クレジット・30秒ほどかかります。",
                    yesText: "AIで広げる", cancelText: "やめる");
                if (ok != true) return;
            }
            var job = await StudioSvc.ChangeAspectMethodAsync(v.Id, method, CancellationToken.None);
            if (job is not null)
            {
                _outpaintJobs[v.Id] = job.Id;
                await State.RefreshAsync();
            }
            await RefreshVariantsAsync();
            await LoadAssetsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex, Log);
        }
    }

    private async Task OutpaintFinishedAsync(PostVariant v, AiJob job)
    {
        _outpaintJobs.Remove(v.Id);
        if (job.Status == AiJobStatus.Failed) Snackbar.Add(job.Error ?? "画像を広げられませんでした。", Severity.Error);
        await RefreshVariantsAsync();
        await LoadAssetsAsync();
        await State.RefreshAsync();
    }

    private async Task LoadAssetsAsync()
    {
        var ids = _variants.SelectMany(v => v.MediaAssetIds).Distinct().ToList();
        var map = new Dictionary<Guid, MediaAsset>();
        foreach (var id in ids)
        {
            try
            {
                map[id] = await MediaSvc.GetAsync(id, CancellationToken.None);
            }
            catch (NotFoundException)
            {
            }
        }
        _assets = map;
    }

    private string? AltOf(PostVariant v) => v.MediaAssetIds.Count > 0 && _assets.TryGetValue(v.MediaAssetIds[0], out var a) ? a.AltText : null;

    private bool IsAiImage(PostVariant v) => v.MediaAssetIds.Count > 0 && _assets.TryGetValue(v.MediaAssetIds[0], out var a) && a.IsAiLabeled;

    private string AccountName(Guid channelId) => _channels.FirstOrDefault(c => c.Id == channelId)?.DisplayName ?? "@shop";

    private static List<string> ParseTags(string tags) =>
        [.. tags.Split([' ', '　', ','], StringSplitOptions.RemoveEmptyEntries).Select(PostText.Normalize).Where(t => t.Length > 0).Distinct()];
}
