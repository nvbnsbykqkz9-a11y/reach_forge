@page "/inbox"
@inherits RfComponentBase
@inject WebTenantContext Tenant
@inject AppState State
@inject TimeDisplay Time
@inject ISnackbar Snackbar

<PageTitle>統合受信箱｜ReachForge</PageTitle>

<div class="rf-page-header">
    <MudText Typo="Typo.h4" tabindex="-1">統合受信箱</MudText>
    <span class="rf-spacer"></span>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.QuestionAnswer" Href="/settings/brand?tab=faq">よくある質問を編集</MudButton>
</div>

@* 炎上の兆し：赤いアラートと「予約を一時停止」 *@
@foreach (var alert in _alerts)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-3" role="alert">
        <div class="d-flex flex-wrap align-center gap-2">
            <span><b>炎上の兆し：</b>@alert.Reason（@Time.Relative(alert.CreatedAt)）</span>
            <MudSpacer />
            @if (RolePolicy.Can(Tenant.Role, Permission.PauseAllPublishing))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small" OnClick="() => ResolveAlertAsync(alert, true)">予約投稿を一時停止</MudButton>
            }
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small" OnClick="() => ResolveAlertAsync(alert, false)">問題なし</MudButton>
        </div>
    </MudAlert>
}

<div class="rf-inbox @(_selected is null ? "" : "rf-inbox-has-detail")">
    @* 左：絞り込み *@
    <aside class="rf-inbox-filters" aria-label="絞り込み">
        <MudList T="InboxView" SelectedValue="_view" SelectedValueChanged="ChangeViewAsync" Dense="true" Color="Color.Primary" aria-label="表示する受信メッセージ">
            <MudListItem Value="InboxView.All" Text="@($"すべて（{_counts?.All ?? 0}）")" />
            <MudListItem Value="InboxView.Urgent" Text="@($"急ぎ（{_counts?.Urgent ?? 0}）")" />
            <MudListItem Value="InboxView.Overdue" Text="@($"期限切れ（{_counts?.Overdue ?? 0}）")" />
            <MudListItem Value="InboxView.Question" Text="@($"質問（{_counts?.Question ?? 0}）")" />
            <MudListItem Value="InboxView.PurchaseOrReservation" Text="@($"購入・予約（{_counts?.PurchaseOrReservation ?? 0}）")" />
            <MudListItem Value="InboxView.Complaint" Text="@($"ご意見・苦情（{_counts?.Complaint ?? 0}）")" />
            <MudListItem Value="InboxView.Spam" Text="@($"スパム（{_counts?.Spam ?? 0}）")" />
            <MudListItem Value="InboxView.Done" Text="対応済み" />
        </MudList>
        <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">SNS</MudText>
        @foreach (var c in PlatformCatalog.InitialRelease)
        {
            <MudCheckBox T="bool" Value="_platforms.Contains(c.Platform)" ValueChanged="v => TogglePlatformAsync(c.Platform, v)" Dense="true" Label="@c.DisplayName" />
        }
        <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">担当</MudText>
        <MudRadioGroup T="string" Value="_assignee" ValueChanged="ChangeAssigneeAsync">
            <MudRadio Value="@("any")" Dense="true">すべて</MudRadio>
            <MudRadio Value="@("me")" Dense="true">自分</MudRadio>
            <MudRadio Value="@("none")" Dense="true">未割当</MudRadio>
        </MudRadioGroup>
    </aside>

    @* 中央：一覧 *@
    <section class="rf-inbox-list" aria-label="メッセージ一覧">
        @if (_items is null)
        {
            <MudSkeleton Height="80px" /><MudSkeleton Height="80px" /><MudSkeleton Height="80px" />
        }
        else if (_items.Count == 0)
        {
            <RfEmptyState Icon="@Icons.Material.Rounded.Inbox" Title="新しいコメントはありません" Message="返信が必要なものが届いたらお知らせします。" />
        }
        else
        {
            @foreach (var m in _items)
            {
                var now = Time.Now;
                <button type="button" class="rf-inbox-item @(m.Id == _selected?.Message.Id ? "is-selected" : "") @(m.IsOverdue(now) ? "is-overdue" : "")"
                        @onclick="() => SelectAsync(m.Id)" aria-current="@(m.Id == _selected?.Message.Id ? "true" : null)">
                    <div class="d-flex align-center gap-1">
                        <MudText Typo="Typo.caption"><b>@PlatformCatalog.Get(m.Platform).DisplayName</b> @m.AuthorName ・ @Time.Relative(m.ReceivedAt)</MudText>
                        <MudSpacer />
                        @if (m.IsOverdue(now)) { <span class="rf-tag rf-tag-error">期限切れ</span> }
                        else if (m.Status == InboxStatus.Replied) { <span class="rf-tag">返信済み</span> }
                    </div>
                    <MudText Typo="Typo.body2" Class="rf-inbox-text">@m.Text</MudText>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @if (m.RequiresHuman) { <span class="rf-tag rf-tag-error">⚠ @m.Sensitive.ToLabel()</span> }
                        <span class="rf-tag">@m.Intent.ToLabel()</span>
                        @if (m.Urgency == Urgency.High) { <span class="rf-tag rf-tag-warn">急ぎ</span> }
                        <span class="rf-tag">@m.Sentiment.ToLabel()</span>
                        @if (m.AssignedTo is not null) { <span class="rf-tag">担当：@m.AssignedTo</span> }
                    </div>
                </button>
            }
        }
    </section>

    @* 右：詳細・返信 *@
    <section class="rf-inbox-detail" aria-label="返信">
        @if (_selected is { } d)
        {
            var m = d.Message;
            <MudButton Class="rf-inbox-back" Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.ArrowBack" OnClick="() => _selected = null">一覧に戻る</MudButton>
            <MudText Typo="Typo.subtitle1"><b>@m.AuthorName</b> さん（@d.ChannelName）</MudText>
            <MudText Typo="Typo.caption" Class="d-block">@Time.Short(m.ReceivedAt) ・ @m.Status.ToLabel()@(m.DueAt is { } due && m.IsOpen ? $" ・ 返信の目安 {Time.Short(due)}まで" : "")</MudText>
            @if (d.OriginalPost is not null)
            {
                <MudPaper Elevation="0" Class="pa-2 mt-2 rf-inbox-post"><MudText Typo="Typo.caption">元の投稿：@PostText.Truncate(d.OriginalPost, 80)</MudText></MudPaper>
            }
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 mt-2"><MudText Typo="Typo.body1" Style="white-space:pre-wrap">@m.Text</MudText></MudPaper>

            @* AI の分類：間違っていたらその場で直せる *@
            <div class="d-flex flex-wrap gap-2 mt-3 align-center">
                <span class="rf-ai-badge"><MudIcon Icon="@Icons.Material.Rounded.AutoAwesome" Size="Size.Small" aria-hidden="true" />@(m.HumanCorrected ? "分類（修正済み）" : "AIの分類")</span>
                <MudSelect T="InboxIntent" Value="m.Intent" ValueChanged="v => CorrectAsync(intent: v)" Label="意図" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:120px" Disabled="!CanReply">
                    @foreach (var v in Enum.GetValues<InboxIntent>()) { <MudSelectItem Value="v">@v.ToLabel()</MudSelectItem> }
                </MudSelect>
                <MudSelect T="Sentiment" Value="m.Sentiment" ValueChanged="v => CorrectAsync(sentiment: v)" Label="感情" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:110px" Disabled="!CanReply">
                    @foreach (var v in Enum.GetValues<Sentiment>()) { <MudSelectItem Value="v">@v.ToLabel()</MudSelectItem> }
                </MudSelect>
                <MudSelect T="Urgency" Value="m.Urgency" ValueChanged="v => CorrectAsync(urgency: v)" Label="急ぎ" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:120px" Disabled="!CanReply">
                    @foreach (var v in Enum.GetValues<Urgency>()) { <MudSelectItem Value="v">@v.ToLabel()</MudSelectItem> }
                </MudSelect>
                <MudSelect T="SensitiveTopic" Value="m.Sensitive" ValueChanged="v => CorrectAsync(sensitive: v)" Label="人の対応" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:140px" Disabled="!CanReply">
                    @foreach (var v in Enum.GetValues<SensitiveTopic>()) { <MudSelectItem Value="v">@v.ToLabel()</MudSelectItem> }
                </MudSelect>
            </div>

            @if (d.TypingOther is { } who)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">@who さんが入力中です。重複して返信しないようご注意ください。</MudAlert>
            }

            @if (m.Status == InboxStatus.Replied)
            {
                <MudAlert Severity="Severity.Success" Dense="true" Class="mt-3">@m.RepliedBy が返信しました（@(m.RepliedAt is { } at ? Time.Short(at) : "")）：@m.ReplyText</MudAlert>
            }
            else if (CanReply && m.Status != InboxStatus.Hidden)
            {
                @if (m.RequiresHuman)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-3">
                        @m.Sensitive.ToLabel()に関わる内容のため、AIの返信案は出しません。担当者が対応してください。
                        @if (m.AssignedTo is null) { <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="AssignMeAsync">自分が担当する</MudButton> }
                    </MudAlert>
                }
                else
                {
                    <div class="mt-3">
                        @if (_drafts is null)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Rounded.AutoAwesome" OnClick="SuggestAsync" Disabled="_busy">
                                返信案をつくる（1クレジット）
                            </MudButton>
                        }
                        else
                        {
                            <MudText Typo="Typo.subtitle2" Class="mb-1"><span class="rf-ai-badge">✦</span> 返信案（押すと入力欄に入ります。送信はされません）</MudText>
                            @foreach (var (draft, i) in _drafts.Select((x, i) => (x, i)))
                            {
                                <button type="button" class="rf-draft rf-ai-surface pa-2 mb-2" @onclick="() => Insert(draft.Text)" aria-label="@($"案{i + 1}を入力欄に入れる")">
                                    <MudText Typo="Typo.body2"><b>案@(i + 1)：</b>@draft.Text</MudText>
                                    @if (draft.Sources.Count > 0) { <MudText Typo="Typo.caption">参照：@string.Join("、", draft.Sources.Select(s => s.Label))</MudText> }
                                </button>
                            }
                        }
                        @if (d.Knowledge.Count > 0 && _drafts is null)
                        {
                            <MudText Typo="Typo.caption" Class="d-block mt-1">関係がありそうなFAQ：@string.Join("、", d.Knowledge.Select(k => k.Entry.Question))</MudText>
                        }
                    </div>
                }
                <MudTextField T="string" @bind-Value="_reply" Label="返信を入力…（案を選ぶとここに入ります）" Lines="3" Variant="Variant.Outlined" Class="mt-3"
                              MaxLength="InboxService.MaxReplyLength" Counter="InboxService.MaxReplyLength" Immediate="true" DebounceInterval="800"
                              OnDebounceIntervalElapsed="TypingAsync" />
                <div class="d-flex flex-wrap align-center gap-2 mt-2">
                    @if (d.ReplyCostUsd is { } cost)
                    {
                        <MudText Typo="Typo.caption" Style="color:var(--rf-color-text-secondary)">X の返信は投稿費用がかかります（約 $@cost.ToString("0.000")）</MudText>
                    }
                    @if (m.Platform == SocialPlatform.Line)
                    {
                        <MudText Typo="Typo.caption" Style="color:var(--rf-color-text-secondary)">LINE の返信は月のメッセージ通数を消費します</MudText>
                    }
                    <MudSpacer />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_reply))">返信する</MudButton>
                </div>
            }

            @if (CanReply)
            {
                <div class="d-flex flex-wrap gap-2 mt-4">
                    @if (m.AssignedTo != Tenant.UserName) { <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="AssignMeAsync">自分が担当する</MudButton> }
                    else { <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="UnassignAsync">担当を外す</MudButton> }
                    @if (m.IsOpen) { <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => SetStatusAsync(InboxStatus.Closed)">対応不要にする</MudButton> }
                    else if (m.Status == InboxStatus.Closed) { <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => SetStatusAsync(InboxStatus.New)">未対応に戻す</MudButton> }
                    @if (m.Kind != InboxKind.DirectMessage && m.Status != InboxStatus.Hidden)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="HideAsync">SNS上で非表示にする</MudButton>
                    }
                </div>
            }
        }
        else
        {
            <div class="rf-inbox-placeholder"><MudText Typo="Typo.body2" Style="color:var(--rf-color-text-secondary)">左の一覧からメッセージを選んでください。</MudText></div>
        }
    </section>
</div>

@code {
    private InboxService InboxSvc => Scoped<InboxService>();

    private InboxView _view = InboxView.All;
    private readonly HashSet<SocialPlatform> _platforms = [.. PlatformCatalog.InitialRelease.Select(c => c.Platform)];
    private string _assignee = "any";
    private IReadOnlyList<InboxMessage>? _items;
    private InboxCounts? _counts;
    private IReadOnlyList<InboxAlert> _alerts = [];
    private InboxDetail? _selected;
    private IReadOnlyList<ReplyDraft>? _drafts;
    private string _reply = "";
    private bool _busy;
    private PeriodicTimer? _timer;
    private readonly CancellationTokenSource _cts = new();

    private bool CanReply => RolePolicy.Can(Tenant.Role, Permission.ReplyInbox);

    protected override async Task OnInitializedAsync()
    {
        await Time.ZoneAsync();
        await LoadAsync();
        // 新着・対応状況の変化はすぐに反映する（RF-DES-001 3.3）。ほかの人の入力中表示は30秒ごとに読み直す
        OnRealtime<InboxUpdatedEvent>(_ => LoadAsync(keepSelection: true));
        _ = RefreshLoopAsync();
    }

    /// <summary>他の人の入力中表示（と、通知が届かない構成での新着）を30秒ごとに反映する。</summary>
    private async Task RefreshLoopAsync()
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await _timer.WaitForNextTickAsync(_cts.Token))
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync(keepSelection: true);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadAsync(bool keepSelection = false)
    {
        try
        {
            _items = await InboxSvc.ListAsync(new InboxQuery(_view, _platforms.ToList(), _assignee == "me", _assignee == "none"), CancellationToken.None);
            _counts = await InboxSvc.CountsAsync(CancellationToken.None);
            _alerts = await InboxSvc.OpenAlertsAsync(CancellationToken.None);
            if (keepSelection && _selected is { } s) _selected = await InboxSvc.GetAsync(s.Message.Id, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private async Task ChangeViewAsync(InboxView view)
    {
        _view = view;
        await LoadAsync();
    }

    private async Task TogglePlatformAsync(SocialPlatform p, bool on)
    {
        if (on) _platforms.Add(p); else _platforms.Remove(p);
        await LoadAsync();
    }

    private async Task ChangeAssigneeAsync(string value)
    {
        _assignee = value;
        await LoadAsync();
    }

    private async Task SelectAsync(Guid id)
    {
        try
        {
            _selected = await InboxSvc.GetAsync(id, CancellationToken.None);
            _drafts = null;
            _reply = "";
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private async Task SuggestAsync()
    {
        if (_selected is null) return;
        _busy = true;
        try
        {
            _drafts = await InboxSvc.SuggestRepliesAsync(_selected.Message.Id, CancellationToken.None);
            await State.RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Insert(string text) => _reply = text;

    private async Task TypingAsync(string _)
    {
        if (_selected is null) return;
        try
        {
            await InboxSvc.TypingAsync(_selected.Message.Id, CancellationToken.None);
        }
        catch (Exception)
        {
            // 入力中の表示に失敗しても返信は続けられる
        }
    }

    private async Task SendAsync()
    {
        if (_selected is null) return;
        _busy = true;
        try
        {
            await InboxSvc.ReplyAsync(_selected.Message.Id, _reply, CancellationToken.None);
            Snackbar.Add("返信しました", Severity.Success);
            _reply = "";
            _drafts = null;
            await AfterChangeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CorrectAsync(InboxIntent? intent = null, Sentiment? sentiment = null, Urgency? urgency = null, SensitiveTopic? sensitive = null)
    {
        if (_selected is not { } d) return;
        var m = d.Message;
        try
        {
            await InboxSvc.CorrectLabelsAsync(m.Id, sentiment ?? m.Sentiment, intent ?? m.Intent, urgency ?? m.Urgency, sensitive ?? m.Sensitive,
                CancellationToken.None);
            Snackbar.Add("分類を直しました（今後の判定の参考にします）", Severity.Info);
            await AfterChangeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private Task AssignMeAsync() => Run(() => InboxSvc.AssignAsync(_selected!.Message.Id, Tenant.UserName, CancellationToken.None), "担当にしました");
    private Task UnassignAsync() => Run(() => InboxSvc.AssignAsync(_selected!.Message.Id, null, CancellationToken.None), "担当を外しました");
    private Task SetStatusAsync(InboxStatus status) => Run(() => InboxSvc.SetStatusAsync(_selected!.Message.Id, status, CancellationToken.None), "状態を変更しました");
    private Task HideAsync() => Run(() => InboxSvc.HideAsync(_selected!.Message.Id, CancellationToken.None), "SNS上で非表示にしました");

    private async Task Run(Func<Task> action, string done)
    {
        try
        {
            await action();
            Snackbar.Add(done, Severity.Success);
            await AfterChangeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private async Task AfterChangeAsync()
    {
        await LoadAsync(keepSelection: true);
        await State.RefreshAsync();
    }

    private async Task ResolveAlertAsync(InboxAlert alert, bool pause)
    {
        try
        {
            await InboxSvc.ResolveAlertAsync(alert.Id, pause, CancellationToken.None);
            Snackbar.Add(pause ? "すべての予約投稿を一時停止しました" : "アラートを閉じました", pause ? Severity.Warning : Severity.Info);
            await AfterChangeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    protected override async ValueTask DisposeAsyncCore()
    {
        await _cts.CancelAsync();
        _timer?.Dispose();
        _cts.Dispose();
        await base.DisposeAsyncCore();
    }
}
