@page "/media"
@inherits RfComponentBase
@using System.Text.Json
@inject WebTenantContext Tenant
@inject TimeDisplay Time
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>メディアライブラリ｜ReachForge</PageTitle>

<div class="rf-page-header">
    <MudText Typo="Typo.h4" tabindex="-1">メディアライブラリ</MudText>
    <span class="rf-spacer"></span>
    <MudToggleGroup T="MediaFilter" Value="_filter" ValueChanged="FilterAsync" Size="Size.Small" Color="Color.Primary">
        <MudToggleItem Value="MediaFilter.All" Text="すべて" />
        <MudToggleItem Value="MediaFilter.AiGenerated" Text="AI生成" />
        <MudToggleItem Value="MediaFilter.Uploaded" Text="アップロード" />
    </MudToggleGroup>
</div>

@if (RolePolicy.Can(Tenant.Role, Permission.Generate))
{
    <MudPaper Class="pa-4 mb-4 rf-card" Elevation="0" Outlined="true">
        <RfMediaPicker Selected="_picked" SelectedChanged="PickedAsync" Max="99" ShowLibrary="false" />
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Rounded.Movie" Class="mt-2"
                   OnClick="() => _videoMaker = !_videoMaker">ショート動画をつくる</MudButton>
    </MudPaper>
    @if (_videoMaker)
    {
        <div class="mb-4"><RfVideoMaker OnCreated="VideoCreatedAsync" /></div>
    }
}

<MudGrid>
    <MudItem xs="12" md="@(_current is null ? 12 : 8)">
        @if (_items.Count == 0)
        {
            <RfEmptyState Icon="@Icons.Material.Rounded.PhotoLibrary" Title="まだ画像がありません"
                          Message="写真をアップロードするか、AIで画像をつくってください。" />
        }
        else
        {
            <div class="rf-media-library">
                @foreach (var m in _items)
                {
                    <button type="button" class="rf-media-pick @(_current?.Id == m.Id ? "rf-media-pick-on" : "")" @onclick="() => SelectAsync(m)"
                            aria-label="@(m.AltText ?? m.FileName)">
                        <RfMediaImage AssetId="m.Id" Alt="@m.AltText" ShowAiBadge="m.IsAiLabeled" />
                    </button>
                }
            </div>
        }
    </MudItem>

    @if (_current is { } cur)
    {
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true" role="region" aria-label="画像の詳細">
                <div class="d-flex align-center">
                    <MudText Typo="Typo.h6">@cur.FileName</MudText>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Rounded.Close" aria-label="詳細を閉じる" OnClick="() => _current = null" />
                </div>
                <RfMediaImage AssetId="cur.Id" Alt="@cur.AltText" ShowAiBadge="cur.IsAiLabeled" Class="my-2" Controls="true" />
                <MudText Typo="Typo.caption" Class="d-block">@cur.Width × @cur.Height@(cur.DurationMs is { } ms ? $" ・ {ms / 1000.0:0.#}秒" : "") ・ @(cur.Bytes / 1024) KB ・ @Time.Short(cur.CreatedAt)</MudText>
                @if (cur.SubtitlesSrt is { Length: > 0 } srt)
                {
                    <MudExpansionPanels Elevation="0" Class="mt-2">
                        <MudExpansionPanel Text="字幕（SRT）"><pre class="rf-srt">@srt</pre></MudExpansionPanel>
                    </MudExpansionPanels>
                }
                <MudText Typo="Typo.caption" Class="d-block">
                    @(cur.Source switch { MediaSource.AiGenerated => "AI生成", MediaSource.AiEdited => "AI編集", MediaSource.Upload => "アップロード", _ => "編集（文字入れ）" })
                    ・ 安全性チェック：@(cur.SafetyResult == "ok" ? "問題なし" : cur.SafetyResult == "not_checked" ? "未設定（判定なし）" : cur.SafetyResult)
                </MudText>
                @if (_provenance is not null)
                {
                    <MudText Typo="Typo.caption" Class="d-block rf-ai-hint">✦ 来歴：@_provenance</MudText>
                }

                <MudTextField @bind-Value="_alt" Label="代替テキスト（ALT）" Variant="Variant.Outlined" Lines="2" Class="mt-3" Immediate="true"
                              HelperText="@(cur.AltTextIsAi ? "AIが作成しました。内容を確認してください" : "画面読み上げで使われます")" />
                <div class="d-flex gap-2 mt-2 flex-wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SaveAsync">保存する</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Rounded.AutoAwesome"
                               OnClick="AltAsync" Disabled="_altBusy">ALTをAIで作る</MudButton>
                </div>

                @if (cur.Kind == MediaKind.Image)
                {
                <MudExpansionPanels Elevation="0" Class="mt-4">
                    <MudExpansionPanel Text="文字を入れる">
                        <MudTextField T="string" @bind-Value="_textHeadline" Label="見出し（30字まで）" Variant="Variant.Outlined" MaxLength="30" Counter="30" />
                        <MudTextField T="string" @bind-Value="_textSub" Label="補足（任意・40字まで）" Variant="Variant.Outlined" MaxLength="40" Class="mt-2" />
                        <div class="d-flex gap-2 align-center mt-2">
                            <MudSelect T="TextPosition" @bind-Value="_textPosition" Label="位置" Variant="Variant.Outlined" Dense="true" Style="max-width:140px">
                                <MudSelectItem Value="TextPosition.Top">上</MudSelectItem>
                                <MudSelectItem Value="TextPosition.Center">中央</MudSelectItem>
                                <MudSelectItem Value="TextPosition.Bottom">下</MudSelectItem>
                            </MudSelect>
                            <MudSelect T="string" @bind-Value="_textBand" Label="帯の色" Variant="Variant.Outlined" Dense="true" Style="max-width:180px">
                                @foreach (var c in _bandColors) { <MudSelectItem Value="c"><span class="rf-swatch" style="background:@c"></span> @c</MudSelectItem> }
                            </MudSelect>
                        </div>
                        <MudText Typo="Typo.caption" Class="d-block mt-1">文字はAIではなくフォントで正確に描きます。文字色は帯の色に合わせて読みやすい色になります。元の画像はそのまま残ります。</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="AddTextAsync"
                                   Disabled="@(_textBusy || string.IsNullOrWhiteSpace(_textHeadline))">文字入りの画像をつくる</MudButton>
                    </MudExpansionPanel>
                </MudExpansionPanels>
                }

                <MudText Typo="Typo.body2" Class="mt-4"><b>使用中の投稿（@_usages.Count）</b></MudText>
                @foreach (var v in _usages)
                {
                    <div class="d-flex align-center gap-2 mt-1">
                        <MudText Typo="Typo.caption">@PlatformCatalog.Get(v.Platform).DisplayName</MudText>
                        <RfStatusBadge Status="v.Status" At="v.ScheduledAt" />
                    </div>
                }
                <MudButton Variant="Variant.Text" Color="Color.Error" Class="mt-4" OnClick="DeleteAsync">削除する</MudButton>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@code {
    private WorkspaceService Workspaces => Scoped<WorkspaceService>();
    private MediaService Media => Scoped<MediaService>();

    private MediaFilter _filter = MediaFilter.All;
    private IReadOnlyList<MediaAsset> _items = [];
    private List<Guid> _picked = [];
    private MediaAsset? _current;
    private IReadOnlyList<PostVariant> _usages = [];
    private string? _alt, _provenance;
    private bool _altBusy, _textBusy, _videoMaker;

    private async Task VideoCreatedAsync(Guid id)
    {
        _videoMaker = false;
        await LoadAsync();
        if (_items.FirstOrDefault(i => i.Id == id) is { } m) await SelectAsync(m);
    }
    private string? _textHeadline, _textSub;
    private TextPosition _textPosition = TextPosition.Bottom;
    private string _textBand = "#1B2333";
    private List<string> _bandColors = ["#1B2333", "#FFFFFF"];

    private async Task AddTextAsync()
    {
        if (_current is null) return;
        _textBusy = true;
        try
        {
            var created = await Media.AddTextAsync(_current.Id, new TextOverlay(_textHeadline ?? "", _textSub, _textPosition, _textBand),
                CancellationToken.None);
            Snackbar.Add("文字入りの画像をつくりました", Severity.Success);
            _textHeadline = _textSub = null;
            await LoadAsync();
            if (_items.FirstOrDefault(i => i.Id == created.Id) is { } m) await SelectAsync(m);
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
        finally
        {
            _textBusy = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Time.ZoneAsync();
        await LoadAsync();
        try
        {
            var brand = await Workspaces.GetBrandAsync(CancellationToken.None);
            _bandColors = [.. brand.BrandColors.Concat(_bandColors).Distinct()];
            _textBand = _bandColors[0];
        }
        catch (Exception)
        {
            // ブランドを読めない権限でも既定の色で使える
        }
    }

    private async Task LoadAsync() => _items = await Media.ListAsync(_filter, CancellationToken.None);

    private async Task FilterAsync(MediaFilter f)
    {
        _filter = f;
        await LoadAsync();
    }

    private async Task PickedAsync(List<Guid> picked)
    {
        // ライブラリ画面では「選ぶ」＝新しく追加した画像を詳細表示する
        _picked = [];
        await LoadAsync();
        if (picked.LastOrDefault() is var id && id != Guid.Empty && _items.FirstOrDefault(i => i.Id == id) is { } m) await SelectAsync(m);
    }

    private async Task SelectAsync(MediaAsset m)
    {
        _current = m;
        _alt = m.AltText;
        _usages = await Media.UsagesAsync(m.Id, CancellationToken.None);
        _provenance = null;
        if (m.Provenance is { } json)
        {
            try
            {
                using var doc = JsonDocument.Parse(json);
                var r = doc.RootElement;
                var model = r.GetProperty("model").GetString();
                _provenance = r.GetProperty("provider").GetString() + (string.IsNullOrEmpty(model) ? "" : $" / {model}") +
                              (r.TryGetProperty("fallbackUsed", out var fb) && fb.GetBoolean() ? "（代替AI）" : "");
            }
            catch (Exception ex) when (ex is JsonException or KeyNotFoundException or InvalidOperationException)
            {
            }
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            _current = await Media.UpdateAsync(_current!.Id, _alt, _current.Tags, CancellationToken.None);
            Snackbar.Add("保存しました", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private async Task AltAsync()
    {
        _altBusy = true;
        try
        {
            _current = await Media.GenerateAltAsync(_current!.Id, CancellationToken.None);
            _alt = _current.AltText;
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
        finally
        {
            _altBusy = false;
        }
    }

    private async Task DeleteAsync()
    {
        var ok = await Dialogs.ShowMessageBoxAsync("この画像を削除しますか？", "SNS ごとに変換した画像も削除されます。元に戻せません。",
            yesText: "削除する", cancelText: "やめる");
        if (ok != true) return;
        try
        {
            await Media.DeleteAsync(_current!.Id, CancellationToken.None);
            _current = null;
            await LoadAsync();
            Snackbar.Add("削除しました", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }
}
