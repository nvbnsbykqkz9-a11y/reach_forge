@page "/settings"

<PageTitle>設定｜ReachForge</PageTitle>

<div class="rf-page-header">
    <MudText Typo="Typo.h4" tabindex="-1">設定</MudText>
</div>

<MudGrid>
    @foreach (var (href, icon, title, text) in Items)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="rf-card" Elevation="0" Outlined="true">
                <MudCardContent>
                    <MudIcon Icon="@icon" Color="Color.Primary" aria-hidden="true" />
                    <MudText Typo="Typo.h6">@title</MudText>
                    <MudText Typo="Typo.body2">@text</MudText>
                </MudCardContent>
                <MudCardActions><MudButton Href="@href" Variant="Variant.Text" Color="Color.Primary">開く</MudButton></MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    private static readonly (string Href, string Icon, string Title, string Text)[] Items =
    [
        ("/settings/channels", Icons.Material.Rounded.Link, "SNS連携", "SNSアカウントの接続・再接続・解除"),
        ("/settings/brand", Icons.Material.Rounded.Palette, "ブランド", "話し方・NGワード・商品などAIに伝えるブランド情報"),
        ("/settings/members", Icons.Material.Rounded.Group, "メンバー・権限", "招待・ロールの変更・ワークスペースの割り当て"),
        ("/settings/usage", Icons.Material.Rounded.Toll, "プラン・利用量", "クレジット残量と機能別の内訳、SNS費用"),
    ];
}
