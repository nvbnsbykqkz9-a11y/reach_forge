@page "/settings/sns-apps"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = OpsAccess.Policy)]
@* SNS アプリの ID・シークレット（運用者・Windows 版のオーナー）。保存するとすぐに連携・投稿に使われる。シークレットは画面に出さない *@
@inherits RfComponentBase
@inject WebTenantContext Tenant
@inject ISnackbar Snackbar
@using ReachForge.Infrastructure.Settings

<PageTitle>SNSアプリの設定｜ReachForge</PageTitle>

<div class="rf-page-header">
    <MudText Typo="Typo.h4" tabindex="-1">SNSアプリの設定</MudText>
    <MudButton Href="/settings/channels" Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Link">SNS連携へ</MudButton>
</div>
<MudText Typo="Typo.body2" Class="mb-4" Style="color:var(--rf-color-text-secondary)">
    SNSと連携するには、SNSごとに開発者サイトで「アプリ」を作り、その ID とシークレットをここに入力します（最初に1回だけ）。
    保存するとすぐに使われます。シークレットは暗号化して保存し、この画面には表示しません。
</MudText>

@if (!CanManage)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">この設定はオーナーと管理者だけが変更できます。</MudAlert>
}

<MudPaper Class="pa-4 mb-4 rf-card" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6">デモ接続（お試し）</MudText>
    <MudText Typo="Typo.body2" Class="mt-1">アプリの設定がない SNS も「連携済み」にして、投稿の予約や分析の画面を試せます。実際には投稿しません。</MudText>
    <MudSwitch T="bool" Value="_useMock" ValueChanged="SetDemoAsync" Color="Color.Primary" Class="mt-2" Disabled="@(!CanManage)"
               Label="@(_useMock ? "デモ接続を使う（オン）" : "デモ接続を使う（オフ）")" />
</MudPaper>

<MudGrid>
    @foreach (var app in AppSettingsService.SnsApps)
    {
        <MudItem xs="12" lg="6">
            <RfSettingsGroupCard Group="app" Status="_status" CanManage="CanManage" OnChanged="LoadAsync" />
        </MudItem>
    }
</MudGrid>
<MudText Typo="Typo.caption" Class="d-block mt-4" Style="color:var(--rf-color-text-tertiary)">
    LINE 公式アカウントはアプリの設定は不要です（SNS連携の画面でチャネル ID・シークレットを入力します）。設定ファイル・環境変数で設定した値もここで上書きできます。
</MudText>

@code {
    private AppSettingsService Settings => Scoped<AppSettingsService>();

    private IReadOnlyDictionary<string, SettingStatus> _status = new Dictionary<string, SettingStatus>();
    private bool _useMock;

    private bool CanManage => RolePolicy.Can(Tenant.Role, Permission.ManageChannels);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _status = await Settings.StatusAsync(CancellationToken.None);
        _useMock = Settings.UseMock;
    }

    private async Task SetDemoAsync(bool on)
    {
        await Settings.SaveAsync(new Dictionary<string, string?> { [AppSettingsService.UseMockKey] = on ? "true" : "false" },
            Tenant.UserName, CancellationToken.None);
        _useMock = on;
        Snackbar.Add(on ? "デモ接続を使えるようにしました" : "デモ接続を止めました", Severity.Success);
    }
}
