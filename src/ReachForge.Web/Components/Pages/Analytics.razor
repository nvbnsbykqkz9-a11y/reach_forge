@page "/analytics"
@inherits RfComponentBase
@using ReachForge.Domain.Analytics
@inject TimeDisplay Time
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>分析レポート｜ReachForge</PageTitle>

<div class="rf-page-header">
    <MudText Typo="Typo.h4" tabindex="-1">分析レポート</MudText>
    <span class="rf-spacer"></span>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Download" Href="@CsvUrl" Target="_blank" Disabled="_data is null">CSV</MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Schedule" OnClick="ToggleSettingsAsync">定期配信</MudButton>
</div>

@* 条件（URL に保存して共有できる） *@
<MudPaper Class="pa-3 mb-3 rf-card" Elevation="0" Outlined="true">
    <div class="d-flex flex-wrap gap-3 align-center">
        <MudSelect aria-label="期間" T="string" Label="期間" Value="Period" ValueChanged="v => SetQueryAsync(period: v)" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:140px">
            @foreach (var (key, label) in s_periods)
            {
                <MudSelectItem Value="@key">@label</MudSelectItem>
            }
        </MudSelect>
        <MudSelect aria-label="比べる期間" T="string" Label="比べる期間" Value="Compare" ValueChanged="v => SetQueryAsync(compare: v)" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:140px">
            <MudSelectItem Value="@("prev")">前の期間</MudSelectItem>
            <MudSelectItem Value="@("year")">前年の同じ期間</MudSelectItem>
        </MudSelect>
        <MudSelect aria-label="SNS" T="string" Label="SNS" Value="@(PlatformQuery ?? "")" ValueChanged="v => SetQueryAsync(platform: v)" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:140px">
            <MudSelectItem Value="@("")">すべて</MudSelectItem>
            @foreach (var c in PlatformCatalog.InitialRelease)
            {
                <MudSelectItem Value="@c.Platform.ToString()">@c.DisplayName</MudSelectItem>
            }
        </MudSelect>
        @if (_campaigns.Count > 0)
        {
            <MudSelect aria-label="キャンペーン" T="string" Label="キャンペーン" Value="@(CampaignQuery ?? "")" ValueChanged="v => SetQueryAsync(campaign: v)" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:160px">
                <MudSelectItem Value="@("")">すべて</MudSelectItem>
                @foreach (var c in _campaigns)
                {
                    <MudSelectItem Value="@c.Id.ToString()">@c.Name</MudSelectItem>
                }
            </MudSelect>
        }
    </div>
</MudPaper>

@if (_settingsOpen && _settings is not null)
{
    <MudPaper Class="pa-4 mb-3 rf-card" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6">定期配信</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">AIレポートを自動で作成し、PDFをメールで送ります（日本時間の朝7時）。</MudText>
        <MudSwitch T="bool" @bind-Value="_settings.Weekly" Color="Color.Primary" Label="毎週月曜（先週分）" />
        <MudSwitch T="bool" @bind-Value="_settings.Monthly" Color="Color.Primary" Label="毎月1日（先月分）" />
        <MudTextField T="string" @bind-Value="_recipients" Label="送り先のメールアドレス" HelperText="カンマまたは改行で区切ります（20件まで）"
                      Lines="2" Variant="Variant.Outlined" Class="mt-2" />
        <MudSelect aria-label="PDFに載せるロゴ" T="Guid?" @bind-Value="_settings.LogoAssetId" Label="PDFに載せるロゴ" HelperText="クライアント向けに差し替えられます。未選択ならブランドのロゴ"
                   Variant="Variant.Outlined" Class="mt-2" Clearable="true">
            @foreach (var a in _logos)
            {
                <MudSelectItem T="Guid?" Value="@a.Id">@a.FileName</MudSelectItem>
            }
        </MudSelect>
        <div class="d-flex gap-2 mt-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSettingsAsync">保存</MudButton>
            <MudButton Variant="Variant.Text" OnClick="() => _settingsOpen = false">閉じる</MudButton>
        </div>
    </MudPaper>
}

@if (_data is null)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" />
}
else
{
    <MudText Typo="Typo.caption" Class="d-block mb-3" Style="color:var(--rf-color-text-secondary)">
        @PeriodText ／ 最終更新：@(_data.LastCapturedAt is { } t ? Time.Short(t) : "—")（SNSのデータは最大24時間遅れることがあります）
    </MudText>

    @* AI サマリ：各文の後ろに根拠の数値。数値はシステム計算値のみ *@
    <MudPaper Class="pa-4 mb-4 rf-ai-surface" Elevation="0">
        <div class="d-flex align-center gap-2 flex-wrap">
            <span class="rf-ai-badge"><MudIcon Icon="@Icons.Material.Rounded.AutoAwesome" Size="Size.Small" aria-hidden="true" />3行まとめ</span>
            <MudSpacer />
            @if (_view?.Report.PdfPath is not null)
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.PictureAsPdf"
                           Href="@($"/api/v1/reports/{_view.Report.Id}/pdf")" Target="_blank">PDF</MudButton>
            }
            @if (_jobId is null)
            {
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Rounded.AutoAwesome"
                           OnClick="CreateReportAsync" Disabled="_data.Ranking.Count == 0">@(_view is null ? "AIレポートを作成" : "作り直す")</MudButton>
            }
        </div>
        @if (_jobId is { } jobId)
        {
            <div class="mt-3"><RfJobProgress JobId="jobId" Title="AIレポートを作成中" EstimatedSeconds="20" OnFinished="OnReportFinishedAsync" /></div>
        }
        else if (_view is { } view)
        {
            <ul class="mt-2 ml-5">
                @foreach (var claim in view.Insight.Summary)
                {
                    <li><RfClaim Claim="claim" Facts="view.Facts" /></li>
                }
            </ul>
            <MudText Typo="Typo.caption" Style="color:var(--rf-color-text-tertiary)">
                @view.Report.Title・@Time.Short(view.Report.CreatedAt) 作成。数値はシステムが計算した値で、AIは文章化だけを担当しています。
                @if (view.Report.RejectedClaims > 0) { <span>（根拠と一致しない @(view.Report.RejectedClaims)件の文は表示していません）</span> }
            </MudText>
        }
        else
        {
            <ul class="mt-2 ml-5">
                @foreach (var line in BasicSummary())
                {
                    <li><MudText Typo="Typo.body2">@line</MudText></li>
                }
            </ul>
            <MudText Typo="Typo.caption" Style="color:var(--rf-color-text-tertiary)">「AIレポートを作成」で、良かった点・課題・次の施策をAIがまとめます（クレジットは消費しません）。</MudText>
        }
    </MudPaper>

    <MudGrid>
        @foreach (var k in _data.Kpis)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudCard Class="rf-card" Elevation="0" Outlined="true" id="kpi">
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Style="color:var(--rf-color-text-secondary)">@k.Label @if (k.Help is not null) { <MudTooltip Text="@k.Help"><MudIcon Icon="@Icons.Material.Rounded.Info" Size="Size.Small" aria-label="@($"定義：{k.Help}")" /></MudTooltip> }</MudText>
                        <div class="rf-kpi-value">@k.Value.ToString(k.Format)</div>
                        @if (k.Change is { } c)
                        {
                            <MudText Typo="Typo.caption" Class="@(c >= 0 ? "rf-up" : "rf-down")">@(c >= 0 ? "▲" : "▼") @Math.Abs(c).ToString("P1") @(Compare == "year" ? "前年比" : "前期間比")</MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }

        @* 推移（折れ線） *@
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true" id="trend">
                <div class="d-flex align-center"><MudText Typo="Typo.h6">表示回数と反応の推移</MudText><MudSpacer /><TableToggle @bind-Value="_trendTable" /></div>
                @if (_trendTable)
                {
                    <MudSimpleTable Dense="true" Elevation="0" Class="rf-scroll-table">
                        <thead><tr><th>日付</th><th style="text-align:right">表示回数</th><th style="text-align:right">反応数</th></tr></thead>
                        <tbody>
                            @foreach (var p in _data.Trend)
                            {
                                <tr><td>@p.Date.ToString("M/d")</td><td style="text-align:right">@p.Impressions.ToString("N0")</td><td style="text-align:right">@p.Engagements.ToString("N0")</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
                else
                {
                    <MudChart T="double" ChartType="ChartType.Line" ChartSeries="_trendSeries" ChartLabels="_trendLabels" ChartOptions="_lineOptions"
                              Height="260px" Width="100%" role="img" aria-label="表示回数と反応数の日別推移。表で見るに切り替えると数値を確認できます" />
                }
            </MudPaper>
        </MudItem>

        @* SNS 比較（棒） *@
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true" id="platforms">
                <div class="d-flex align-center"><MudText Typo="Typo.h6">SNS比較</MudText><MudSpacer /><TableToggle @bind-Value="_platformTable" /></div>
                @if (_platformTable || _data.Platforms.Count == 0)
                {
                    <MudSimpleTable Dense="true" Elevation="0">
                        <thead><tr><th>SNS</th><th style="text-align:right">投稿</th><th style="text-align:right">表示回数</th><th style="text-align:right">反応の割合</th></tr></thead>
                        <tbody>
                            @foreach (var p in _data.Platforms)
                            {
                                <tr><td>@PlatformCatalog.Get(p.Platform).DisplayName</td><td style="text-align:right">@p.Posts</td><td style="text-align:right">@p.Impressions.ToString("N0")</td><td style="text-align:right">@(p.EngagementRate?.ToString("P1") ?? "—")</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
                else
                {
                    <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="_platformSeries" ChartLabels="_platformLabels" ChartOptions="_barOptions"
                              Height="260px" Width="100%" role="img" aria-label="SNSごとの表示回数。表で見るに切り替えると数値を確認できます" />
                }
            </MudPaper>
        </MudItem>

        @* 曜日×時間の反応（ヒートマップ） *@
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true" id="heatmap">
                <div class="d-flex align-center"><MudText Typo="Typo.h6">曜日×時間帯の反応の割合（%）</MudText><MudSpacer /><TableToggle @bind-Value="_heatTable" /></div>
                @if (_heatTable)
                {
                    <MudSimpleTable Dense="true" Elevation="0" Class="rf-scroll-table">
                        <thead><tr><th>曜日</th>@foreach (var b in AnalyticsData.HourBands) { <th style="text-align:right">@b</th> }</tr></thead>
                        <tbody>
                            @for (var d = 0; d < AnalyticsData.Days.Length; d++)
                            {
                                var row = _data.HeatMap[d];
                                <tr><td>@DashboardService.DayLabel(AnalyticsData.Days[d])</td>@foreach (var v in row) { <td style="text-align:right">@(v == 0 ? "—" : v.ToString("0.0"))</td> }</tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
                else
                {
                    <MudChart T="double" ChartType="ChartType.HeatMap" ChartSeries="_heatSeries" ChartLabels="AnalyticsData.HourBands" ChartOptions="_heatOptions"
                              Height="280px" Width="100%" role="img" aria-label="曜日と時間帯ごとの反応の割合。表で見るに切り替えると数値を確認できます" />
                }
                <MudText Typo="Typo.caption" Style="color:var(--rf-color-text-tertiary)">
                    おすすめ：@string.Join("、", _data.BestTimes.Select(s => $"{DashboardService.DayLabel(s.Day)}曜{s.Hour}時"))（@(_data.BestTimes.FirstOrDefault()?.Rationale)）
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">AI生成と手動の比較</MudText>
                <MudSimpleTable Dense="true" Elevation="0">
                    <tbody>
                        <tr><td>AI生成の投稿</td><td style="text-align:right">@(_data.AiEngagementRate?.ToString("P1") ?? "—")</td></tr>
                        <tr><td>手動の投稿</td><td style="text-align:right">@(_data.ManualEngagementRate?.ToString("P1") ?? "—")</td></tr>
                    </tbody>
                </MudSimpleTable>
                <MudText Typo="Typo.caption" Style="color:var(--rf-color-text-tertiary)">反応の割合で比べています。</MudText>
            </MudPaper>
        </MudItem>

        @if (_view is { } v && v.Insight.Count > v.Insight.Summary.Count)
        {
            <MudItem xs="12">
                <MudPaper Class="pa-4 rf-ai-surface" Elevation="0">
                    <MudGrid>
                        <InsightColumn Title="良かった点" Claims="v.Insight.Good" Facts="v.Facts" />
                        <InsightColumn Title="課題" Claims="v.Insight.Issues" Facts="v.Facts" />
                        <InsightColumn Title="次の施策" Claims="v.Insight.NextActions" Facts="v.Facts" />
                    </MudGrid>
                </MudPaper>
            </MudItem>
        }

        <MudItem xs="12">
            <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true" id="ranking">
                <MudText Typo="Typo.h6" Class="mb-2">投稿ランキング（反応の割合が高い順）</MudText>
                <MudTable Items="_data.Ranking" Dense="true" Hover="true" Elevation="0" RowsPerPage="10">
                    <HeaderContent>
                        <MudTh>#</MudTh><MudTh></MudTh><MudTh>件名</MudTh><MudTh>SNS</MudTh><MudTh>公開</MudTh>
                        <MudTh Style="text-align:right">表示回数</MudTh><MudTh Style="text-align:right">反応の割合</MudTh><MudTh Style="text-align:right">クリック</MudTh><MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@(_rank.GetValueOrDefault(context.VariantId))</MudTd>
                        <MudTd>@if (context.ImageAssetId is { } img) { <RfMediaImage AssetId="img" Alt="" Class="rf-thumb-sm" /> }</MudTd>
                        <MudTd>@context.Title @if (context.IsAiGenerated) { <span class="rf-ai-badge">✦AI</span> }</MudTd>
                        <MudTd>@PlatformCatalog.Get(context.Platform).DisplayName</MudTd>
                        <MudTd>@Time.Short(context.PostedAt)</MudTd>
                        <MudTd Style="text-align:right">@context.Impressions.ToString("N0")</MudTd>
                        <MudTd Style="text-align:right">@(context.EngagementRate?.ToString("P1") ?? "—")</MudTd>
                        <MudTd Style="text-align:right">@context.LinkClicks.ToString("N0")</MudTd>
                        <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/studio?theme={Uri.EscapeDataString(context.Title)}")">この投稿をもとにつくる</MudButton></MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText Typo="Typo.body2">この期間に公開された投稿はありません。</MudText></NoRecordsContent>
                    <PagerContent><MudTablePager InfoFormat="{first_item}-{last_item} / {all_items}件" HideRowsPerPage="true" /></PagerContent>
                </MudTable>
            </MudPaper>
        </MudItem>

        @if (_reports.Count > 0)
        {
            <MudItem xs="12">
                <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.h6" Class="mb-2">作成したレポート</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <thead><tr><th>レポート</th><th>作成</th><th>状態</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var r in _reports)
                            {
                                <tr>
                                    <td>@r.Title</td>
                                    <td>@Time.Short(r.CreatedAt)</td>
                                    <td>@(r.Status switch { ReportStatus.Succeeded => "完了", ReportStatus.Failed => "失敗", _ => "作成中" })</td>
                                    <td>
                                        @if (r.Status == ReportStatus.Succeeded)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => OpenReportAsync(r.Id)">表示</MudButton>
                                            @if (r.PdfPath is not null) { <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/api/v1/reports/{r.Id}/pdf")" Target="_blank">PDF</MudButton> }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private AnalyticsService AnalyticsSvc => Scoped<AnalyticsService>();
    private ReportService Reports => Scoped<ReportService>();
    private WorkspaceService Workspace => Scoped<WorkspaceService>();
    private MediaService Media => Scoped<MediaService>();

    private static readonly (string Key, string Label)[] s_periods =
    [
        ("this-week", "今週"), ("last-week", "先週"), ("this-month", "今月"), ("last-month", "先月"),
        ("7d", "過去7日間"), ("30d", "過去30日間"), ("90d", "過去90日間"),
    ];

    // 色覚の違いに配慮したパレット（青・橙・紫・緑・灰）
    private static readonly string[] s_palette = ["#0A5BD6", "#E07B00", "#6D28D9", "#047857", "#6B7280"];

    [SupplyParameterFromQuery(Name = "period")] public string? PeriodQuery { get; set; }
    [SupplyParameterFromQuery(Name = "compare")] public string? CompareQuery { get; set; }
    [SupplyParameterFromQuery(Name = "platform")] public string? PlatformQuery { get; set; }
    [SupplyParameterFromQuery(Name = "campaign")] public string? CampaignQuery { get; set; }
    [SupplyParameterFromQuery(Name = "report")] public Guid? ReportQuery { get; set; }

    private string Period => s_periods.Any(p => p.Key == PeriodQuery) ? PeriodQuery! : "30d";
    private string Compare => CompareQuery == "year" ? "year" : "prev";

    private AnalyticsData? _data;
    private ReportView? _view;
    private Guid? _jobId;
    private Dictionary<Guid, int> _rank = [];
    private IReadOnlyList<Campaign> _campaigns = [];
    private IReadOnlyList<Report> _reports = [];
    private ReportSettings? _settings;
    private string _recipients = "";
    private IReadOnlyList<MediaAsset> _logos = [];
    private bool _settingsOpen, _trendTable, _platformTable, _heatTable;
    private string? _loadedKey;

    private List<ChartSeries<double>> _trendSeries = [];
    private string[] _trendLabels = [];
    private List<ChartSeries<double>> _platformSeries = [];
    private string[] _platformLabels = [];
    private List<ChartSeries<double>> _heatSeries = [];
    private readonly LineChartOptions _lineOptions = new() { ChartPalette = s_palette };
    private readonly BarChartOptions _barOptions = new() { ChartPalette = s_palette };
    private readonly HeatMapChartOptions _heatOptions = new() { ChartPalette = ["#EFF6FF", "#0A5BD6"], ShowLabels = true, ValueFormatString = "0.0" };

    protected override async Task OnInitializedAsync()
    {
        await Time.ZoneAsync();
        try
        {
            _campaigns = await Workspace.CampaignsAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Period}|{Compare}|{PlatformQuery}|{CampaignQuery}|{ReportQuery}";
        if (key == _loadedKey) return;
        _loadedKey = key;
        await LoadAsync();
    }

    private AnalyticsFilter Filter()
    {
        var (from, to) = Range(Period);
        return new AnalyticsFilter(from, to,
            Enum.TryParse<SocialPlatform>(PlatformQuery, out var p) ? p : null,
            Guid.TryParse(CampaignQuery, out var c) ? c : null,
            Compare == "year" ? CompareMode.PreviousYear : CompareMode.PreviousPeriod);
    }

    /// <summary>期間（テナントのタイムゾーンの暦で区切る。「今週」「今月」は現在まで）。</summary>
    private (DateTimeOffset From, DateTimeOffset To) Range(string period)
    {
        var now = Time.Now;
        var local = Time.ToLocal(now).Date;
        var monday = local.AddDays(-(((int)local.DayOfWeek + 6) % 7));
        var first = new DateTime(local.Year, local.Month, 1);
        return period switch
        {
            "this-week" => (Time.FromLocal(monday), now),
            "last-week" => (Time.FromLocal(monday.AddDays(-7)), Time.FromLocal(monday)),
            "this-month" => (Time.FromLocal(first), now),
            "last-month" => (Time.FromLocal(first.AddMonths(-1)), Time.FromLocal(first)),
            "7d" => (now.AddDays(-7), now),
            "90d" => (now.AddDays(-90), now),
            _ => (now.AddDays(-30), now),
        };
    }

    private string PeriodText
    {
        get
        {
            var f = _data!.Filter;
            return $"{Time.ToLocal(f.From):yyyy/M/d}〜{Time.ToLocal(f.To.AddTicks(-1)):M/d}";
        }
    }

    private string CsvUrl
    {
        get
        {
            var f = Filter();
            var url = $"/api/v1/analytics/posts.csv?from={Uri.EscapeDataString(f.From.ToString("O"))}&to={Uri.EscapeDataString(f.To.ToString("O"))}";
            if (f.Platform is { } p) url += $"&platform={p}";
            if (f.CampaignId is { } c) url += $"&campaignId={c}";
            return url;
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _data = await AnalyticsSvc.BuildAsync(Filter(), CancellationToken.None);
            _rank = _data.Ranking.Select((p, i) => (p.VariantId, i + 1)).ToDictionary(x => x.VariantId, x => x.Item2);
            BuildCharts(_data);
            _reports = await Reports.ListAsync(10, CancellationToken.None);
            _view = null;
            if (ReportQuery is { } id)
            {
                _view = await Reports.GetAsync(id, CancellationToken.None);
            }
            else if (_reports.FirstOrDefault(r => r.Status == ReportStatus.Succeeded && r.PeriodFrom == _data.Filter.From && r.PeriodTo == _data.Filter.To) is { } same)
            {
                _view = await Reports.GetAsync(same.Id, CancellationToken.None);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private void BuildCharts(AnalyticsData d)
    {
        _trendLabels = d.Trend.Select((p, i) => d.Trend.Count <= 14 || i % 7 == 0 ? p.Date.ToString("M/d") : "").ToArray();
        _trendSeries =
        [
            new ChartSeries<double> { Name = "表示回数", Data = d.Trend.Select(p => (double)p.Impressions).ToArray() },
            new ChartSeries<double> { Name = "反応数", Data = d.Trend.Select(p => (double)p.Engagements).ToArray() },
        ];
        _platformLabels = d.Platforms.Select(p => PlatformCatalog.Get(p.Platform).DisplayName).ToArray();
        _platformSeries = [new ChartSeries<double> { Name = "表示回数", Data = d.Platforms.Select(p => (double)p.Impressions).ToArray() }];
        _heatSeries = AnalyticsData.Days.Select((day, i) =>
            new ChartSeries<double> { Name = DashboardService.DayLabel(day), Data = d.HeatMap[i] }).ToList();
    }

    private Task SetQueryAsync(string? period = null, string? compare = null, string? platform = null, string? campaign = null)
    {
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["period"] = period ?? Period,
            ["compare"] = (compare ?? Compare) == "prev" ? null : "year",
            ["platform"] = string.IsNullOrEmpty(platform ?? PlatformQuery) ? null : platform ?? PlatformQuery,
            ["campaign"] = string.IsNullOrEmpty(campaign ?? CampaignQuery) ? null : campaign ?? CampaignQuery,
            ["report"] = null,
        }));
        return Task.CompletedTask;
    }

    private async Task CreateReportAsync()
    {
        try
        {
            var f = Filter();
            var (_, job) = await Reports.RequestAsync(new ReportRequest(f.From, f.To, ReportKind.Custom, f.Platform, f.CampaignId, f.Compare),
                CancellationToken.None);
            _jobId = job.Id;
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private async Task OnReportFinishedAsync(AiJob job)
    {
        _jobId = null;
        if (job.Status == AiJobStatus.Succeeded)
        {
            _reports = await Reports.ListAsync(10, CancellationToken.None);
            if (_reports.FirstOrDefault(r => r.AiJobId == job.Id) is { } r) _view = await Reports.GetAsync(r.Id, CancellationToken.None);
            Snackbar.Add("AIレポートができました", Severity.Success);
        }
        else if (job.Status == AiJobStatus.Failed)
        {
            Snackbar.Add(job.Error ?? "レポートを作成できませんでした", Severity.Error);
        }
    }

    private async Task OpenReportAsync(Guid id)
    {
        try
        {
            _view = await Reports.GetAsync(id, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private async Task ToggleSettingsAsync()
    {
        if (_settingsOpen)
        {
            _settingsOpen = false;
            return;
        }
        try
        {
            _settings = await Reports.GetSettingsAsync(CancellationToken.None);
            _recipients = string.Join(", ", _settings.Recipients);
            _logos = (await Media.ListAsync(MediaFilter.All, CancellationToken.None)).Where(a => a.Kind == MediaKind.Image).ToList();
            _settingsOpen = true;
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private async Task SaveSettingsAsync()
    {
        try
        {
            _settings!.Recipients = _recipients.Split([',', '\n', '、', ' '], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
            await Reports.UpdateSettingsAsync(_settings, CancellationToken.None);
            Snackbar.Add("定期配信の設定を保存しました", Severity.Success);
            _settingsOpen = false;
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    /// <summary>AI レポートがないときの要約（数値はシステム計算値のみ）。</summary>
    private IEnumerable<string> BasicSummary()
    {
        var imp = _data!.Kpis[0];
        var er = _data.Kpis[1];
        yield return $"表示回数は {imp.Value:N0} 回{(imp.Change is { } c ? $"（{(Compare == "year" ? "前年比" : "前期間比")} {(c >= 0 ? "+" : "")}{c:P1}）" : "")}でした。";
        yield return $"反応の割合は {er.Value:P1}{(er.Change is { } e ? $"（{(Compare == "year" ? "前年比" : "前期間比")} {(e >= 0 ? "+" : "")}{e:P1}）" : "")}です。";
        if (_data.Ranking.FirstOrDefault() is { } top)
        {
            yield return $"最も反応が良かったのは「{top.Title}」（{PlatformCatalog.Get(top.Platform).DisplayName}、反応の割合 {top.EngagementRate:P1}）です。";
        }
    }
}
