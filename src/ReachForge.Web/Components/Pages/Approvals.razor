@page "/approvals"
@inherits RfComponentBase
@inject WebTenantContext Tenant
@inject TimeDisplay Time
@inject AppState State
@inject ISnackbar Snackbar

<PageTitle>承認キュー｜ReachForge</PageTitle>

<div class="rf-page-header">
    <MudText Typo="Typo.h4" tabindex="-1">承認待ち（@_queue.Count）</MudText>
    <span class="rf-spacer"></span>
    @if (CanApprove && _checked.Count > 0)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="BulkApproveAsync">選んだ @_checked.Count 件をまとめて承認</MudButton>
    }
</div>

@if (!CanApprove)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">承認者のみ操作できます。内容の確認はできます。</MudAlert>
}

@if (_queue.Count == 0)
{
    <RfEmptyState Icon="@Icons.Material.Rounded.FactCheck" Title="承認待ちの投稿はありません" Message="新しい依頼が届いたらお知らせします。" />
}
else
{
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Outlined="true" Class="rf-card">
                <MudList T="ApprovalQueueItem" SelectedValue="_current" SelectedValueChanged="SelectAsync">
                    @foreach (var item in _queue)
                    {
                        var clean = item.Variant.GuardrailLevel <= GuardrailLevel.Info;
                        <MudListItem T="ApprovalQueueItem" Value="item">
                            <div class="d-flex align-start gap-2">
                                <MudCheckBox T="bool" Disabled="@(!clean || !CanApprove)" Value="_checked.Contains(item.Variant.Id)"
                                             ValueChanged="v => Check(item, v)" aria-label="@(clean ? "まとめて承認に含める" : "確認事項があるため一括承認できません")" />
                                <div style="flex:1">
                                    <MudText Typo="Typo.body1"><b>@item.Post.Title</b></MudText>
                                    <MudText Typo="Typo.body2">@PlatformCatalog.Get(item.Variant.Platform).DisplayName ／ @item.RequestedBy</MudText>
                                    @if (item.Variant.RequestedPublishAt is { } at)
                                    {
                                        <MudText Typo="Typo.caption">⏰ @Time.Relative(at) に公開予定</MudText>
                                    }
                                </div>
                                @if (!clean)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="@(item.Variant.HasGuardrailErrors ? Color.Error : Color.Warning)">
                                        @(item.Variant.HasGuardrailErrors ? "⚠" : "！")@item.Variant.GuardrailFindings.Count(f => f.Level >= GuardrailLevel.Warning)
                                    </MudChip>
                                }
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="8">
            @if (_current is { } cur)
            {
                <MudPaper Class="pa-4 mb-4 rf-ai-surface" Elevation="0">
                    <span class="rf-ai-badge"><MudIcon Icon="@Icons.Material.Rounded.AutoAwesome" Size="Size.Small" aria-hidden="true" />確認ポイント（AI要約）</span>
                    @if (_summary is null)
                    {
                        <MudSkeleton /><MudSkeleton Width="70%" />
                    }
                    else
                    {
                        <ul class="mt-2 ml-5">@foreach (var line in _summary) { <li><MudText Typo="Typo.body2">@line</MudText></li> }</ul>
                    }
                </MudPaper>

                <MudGrid>
                    <MudItem xs="12" lg="6">
                        <MudText Typo="Typo.body2" Class="mb-2"><b>プレビュー（全文）</b></MudText>
                        <RfPlatformPreview Platform="cur.Variant.Platform" Body="@cur.Variant.Body" Hashtags="cur.Variant.Hashtags" Title="@cur.Variant.Title"
                                           AccountName="@cur.Channel.DisplayName"
                                           ImageAssetId="@(cur.Variant.MediaAssetIds.Count > 0 ? cur.Variant.MediaAssetIds[0] : null)"
                                           ImageCount="cur.Variant.MediaAssetIds.Count" />
                    </MudItem>
                    <MudItem xs="12" lg="6">
                        <MudText Typo="Typo.body2" Class="mb-2"><b>確認結果</b></MudText>
                        <RfGuardrailPanel Findings="cur.Variant.GuardrailFindings" ReadOnly="true" />
                        <MudText Typo="Typo.body2" Class="mt-4 mb-2"><b>履歴・コメント（@_history.Count）</b></MudText>
                        @foreach (var h in _history)
                        {
                            <MudText Typo="Typo.caption" Class="d-block">@Time.Short(h.CreatedAt) @h.ActorName：@DecisionLabel(h.Decision) @h.Comment</MudText>
                        }
                    </MudItem>
                </MudGrid>

                <MudPaper Class="pa-4 mt-4 rf-card" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.body2" Class="mb-1">差し戻す理由（差し戻すときは必須）</MudText>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        @foreach (var r in RejectReasons)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="() => _reason = r">@r</MudChip>
                        }
                    </div>
                    <MudTextField @bind-Value="_reason" Label="理由・コメント" Variant="Variant.Outlined" Lines="2" Immediate="true" />
                    @if (cur.Variant.HasGuardrailErrors && Tenant.Role == Role.Owner)
                    {
                        <MudTextField @bind-Value="_exceptionReason" Label="例外として承認する理由（オーナーのみ・監査ログに記録）" Variant="Variant.Outlined" Class="mt-2" />
                    }
                    <div class="rf-sticky-actions">
                        <MudButton Variant="Variant.Outlined" Disabled="@(!CanApprove)" OnClick="RejectAsync">差し戻す（R）</MudButton>
                        <MudButton Variant="Variant.Text" OnClick="CommentAsync">コメントする</MudButton>
                        <MudTooltip Text="@(ApproveDisabledReason ?? "")">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(ApproveDisabledReason is not null)" OnClick="ApproveAsync">承認する（A）</MudButton>
                        </MudTooltip>
                    </div>
                </MudPaper>
            }
            else
            {
                <MudText Typo="Typo.body2">左の一覧から投稿を選んでください。</MudText>
            }
        </MudItem>
    </MudGrid>
}

@code {
    private ApprovalService ApprovalSvc => Scoped<ApprovalService>();

    private static readonly string[] RejectReasons = ["表現の修正", "画像の差し替え", "日時の変更", "その他"];

    private IReadOnlyList<ApprovalQueueItem> _queue = [];
    private ApprovalQueueItem? _current;
    private IReadOnlyList<string>? _summary;
    private IReadOnlyList<ApprovalAction> _history = [];
    private readonly HashSet<Guid> _checked = [];
    private string? _reason, _exceptionReason;

    private bool CanApprove => RolePolicy.Can(Tenant.Role, Permission.Approve);

    private string? ApproveDisabledReason =>
        !CanApprove ? "承認者のみ操作できます"
        : _current?.Variant.HasGuardrailErrors == true && string.IsNullOrWhiteSpace(_exceptionReason)
            ? "確認結果にエラーがあるため承認できません（オーナーは理由を入力して例外承認できます）"
        : null;

    protected override async Task OnInitializedAsync()
    {
        await Time.ZoneAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _queue = await ApprovalSvc.QueueAsync(CancellationToken.None);
        _checked.IntersectWith(_queue.Select(q => q.Variant.Id));
        await SelectAsync(_queue.FirstOrDefault(q => q.Variant.Id == _current?.Variant.Id) ?? _queue.FirstOrDefault());
    }

    private async Task SelectAsync(ApprovalQueueItem? item)
    {
        _current = item;
        _summary = null;
        _reason = _exceptionReason = null;
        if (item is null) return;
        _history = await ApprovalSvc.HistoryAsync(item.Variant.Id, CancellationToken.None);
        StateHasChanged();
        _summary = await ApprovalSvc.SummaryAsync(item.Variant.Id, CancellationToken.None);
    }

    private void Check(ApprovalQueueItem item, bool on)
    {
        if (on) _checked.Add(item.Variant.Id); else _checked.Remove(item.Variant.Id);
    }

    private Task ApproveAsync() => RunAsync(async () =>
    {
        await ApprovalSvc.ApproveAsync(_current!.Variant.Id, _reason, _exceptionReason, CancellationToken.None);
        Snackbar.Add("承認しました", Severity.Success);
    });

    private Task RejectAsync() => RunAsync(async () =>
    {
        await ApprovalSvc.RejectAsync(_current!.Variant.Id, _reason ?? "", CancellationToken.None);
        Snackbar.Add("差し戻しました", Severity.Success);
    });

    private Task CommentAsync() => RunAsync(async () =>
    {
        await ApprovalSvc.CommentAsync(_current!.Variant.Id, _reason ?? "", CancellationToken.None);
        Snackbar.Add("コメントしました", Severity.Success);
    });

    private Task BulkApproveAsync() => RunAsync(async () =>
    {
        var n = await ApprovalSvc.BulkApproveAsync(_checked.ToList(), CancellationToken.None);
        _checked.Clear();
        Snackbar.Add($"{n}件を承認しました", Severity.Success);
    });

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
            await LoadAsync();
            await State.RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private static string DecisionLabel(ApprovalDecision d) => d switch
    {
        ApprovalDecision.Submitted => "承認を依頼",
        ApprovalDecision.Approved => "承認",
        ApprovalDecision.Rejected => "差し戻し",
        ApprovalDecision.ExceptionApproved => "例外として承認",
        _ => "コメント",
    };
}
