@page "/create/{Slug}"
@* つくる（SNS ごと）：投稿をつくる／広告を出す。初心者が迷わないよう、1画面1つのことを順番に進める *@
@inherits RfComponentBase
@inject WebTenantContext Tenant

@if (Platform is not { } platform)
{
    <PageTitle>見つかりません｜ReachForge</PageTitle>
    <RfEmptyState Title="この SNS には対応していません" Message="左のメニューから SNS を選んでください。" ActionText="ホームへ" ActionHref="/" />
}
else
{
    var c = PlatformCatalog.Get(platform);
    <PageTitle>@c.DisplayName でつくる｜ReachForge</PageTitle>
    <div class="rf-page-header">
        <div class="d-flex align-center">
            <span class="rf-sns-dot rf-sns-dot-lg" style="background:@RfSns.Color(platform)" aria-hidden="true"></span>
            <MudText Typo="Typo.h4" tabindex="-1">@c.DisplayName</MudText>
        </div>
        @if (_channel is { } ch)
        {
            <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Icon="@Icons.Material.Rounded.CheckCircle">@ch.DisplayName と連携中</MudChip>
        }
    </div>
    <MudText Typo="Typo.body1" Class="mb-4">@RfSns.Intro(platform)</MudText>

    @if (!_loaded)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_channel is null)
    {
        <MudPaper Class="pa-6 rf-card" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6">まず @c.DisplayName とつなぎましょう</MudText>
            <MudText Typo="Typo.body1" Class="mt-2">
                投稿や広告を出すには、@(c.DisplayName) のアカウントを ReachForge とつなぐ必要があります（最初に1回だけ）。
            </MudText>
            <MudButton Href="/settings/channels" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="mt-4"
                       StartIcon="@Icons.Material.Rounded.Link">@c.DisplayName とつなぐ</MudButton>
        </MudPaper>
    }
    else
    {
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-4" @bind-ActivePanelIndex="_tab">
            <MudTabPanel Text="投稿をつくる" Icon="@Icons.Material.Rounded.EditNote">
                <RfPostWizard @key="platform" Platform="platform" Channel="_channel" />
            </MudTabPanel>
            <MudTabPanel Text="広告を出す" Icon="@Icons.Material.Rounded.Campaign">
                <RfAdWizard @key="platform" Platform="platform" Channel="_channel" JustConnected="AdConnected" Error="@ErrorQuery" />
            </MudTabPanel>
        </MudTabs>
    }
}

@code {
    [Parameter] public string? Slug { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    [SupplyParameterFromQuery(Name = "adConnected")] public bool AdConnected { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? ErrorQuery { get; set; }

    private ChannelService Channels => Scoped<ChannelService>();
    private SocialPlatform? Platform => RfSns.FromSlug(Slug);
    private Channel? _channel;
    private bool _loaded;
    private int _tab;

    protected override async Task OnParametersSetAsync()
    {
        _loaded = false;
        _channel = null;
        _tab = Tab == "ad" ? 1 : 0;
        if (Platform is { } p)
        {
            _channel = (await Channels.ListAsync(CancellationToken.None))
                .FirstOrDefault(c => c.Platform == p && c.Status != ChannelStatus.Revoked);
        }
        _loaded = true;
    }
}
