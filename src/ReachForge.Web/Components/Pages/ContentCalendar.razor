@page "/calendar"
@inherits RfComponentBase
@using ReachForge.Domain.Analytics
@inject WebTenantContext Tenant
@inject TimeDisplay Time
@inject AppState State
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Nav

<PageTitle>コンテンツカレンダー｜ReachForge</PageTitle>

<div class="rf-page-header">
    <MudText Typo="Typo.h4" tabindex="-1">@_weekStart.ToString("yyyy年M月")</MudText>
    <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
        <MudButton OnClick="() => MoveAsync(-7)" aria-label="前の週">‹</MudButton>
        <MudButton OnClick="() => MoveAsync(0)">今日</MudButton>
        <MudButton OnClick="() => MoveAsync(7)" aria-label="次の週">›</MudButton>
    </MudButtonGroup>
    <MudText Typo="Typo.caption" Style="color:var(--rf-color-text-secondary)">@Time.ZoneLabel</MudText>
    <span class="rf-spacer"></span>
    <MudToggleGroup T="string" @bind-Value="_view" Size="Size.Small" Color="Color.Primary">
        <MudToggleItem Value="@("week")" Text="週" />
        <MudToggleItem Value="@("list")" Text="リスト" />
    </MudToggleGroup>
    @if (RolePolicy.Can(Tenant.Role, Permission.PauseAllPublishing) && !State.PublishingPaused)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Rounded.PauseCircle" OnClick="PauseAllAsync">すべての予約を一時停止</MudButton>
    }
</div>

<MudGrid>
    <MudItem xs="12" md="@(_selected is null ? 12 : 8)">
        @if (_view == "week")
        {
            <div class="rf-cal" role="grid" aria-label="週の予定">
                <div class="rf-cal-head" role="columnheader"></div>
                @for (var d = 0; d < 7; d++)
                {
                    var day = _weekStart.AddDays(d);
                    <div class="rf-cal-head @(day.Date == Today ? "rf-cal-today" : "")" role="columnheader">@day.ToString("M/d")（@DayLabel(day.DayOfWeek)）</div>
                }
                @for (var h = 7; h <= 23; h++)
                {
                    var hour = h;
                    <div class="rf-cal-hour">@($"{hour}:00")</div>
                    @for (var d = 0; d < 7; d++)
                    {
                        var day = _weekStart.AddDays(d);
                        var items = _entries.Where(e => Time.ToLocal(e.At).Date == day.Date && Time.ToLocal(e.At).Hour == hour).ToList();
                        <div class="rf-cal-cell" role="gridcell">
                            @foreach (var e in items.Take(3))
                            {
                                <button class="rf-cal-entry" @onclick="() => Select(e)" aria-label="@($"{Time.Short(e.At)} {e.Title} {e.Status.ToLabel()}")">
                                    <RfStatusBadge Status="e.Status" />
                                    <div><b>@Time.ToLocal(e.At).ToString("HH:mm")</b> @PlatformCatalog.Get(e.Platform).DisplayName</div>
                                    <div>@e.Title</div>
                                </button>
                            }
                            @if (items.Count > 3)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ShowList">＋@(items.Count - 3)件</MudButton>
                            }
                            @if (items.Count == 0 && IsBestSlot(day, hour))
                            {
                                <MudTooltip Text="@BestRationale(day, hour)">
                                    <button class="rf-cal-entry rf-cal-best" @onclick="@(() => Nav.NavigateTo("/studio"))">✦ おすすめ枠</button>
                                </MudTooltip>
                            }
                        </div>
                    }
                }
            </div>
        }
        else
        {
            @if (_entries.Count == 0)
            {
                <RfEmptyState Icon="@Icons.Material.Rounded.CalendarMonth" Title="この週の予定はありません"
                              Message="まだ予約がありません。" ActionText="投稿をつくる" ActionHref="/studio" />
            }
            else
            {
                <MudTable Items="_entries" Hover="true" Dense="true" Elevation="0" Outlined="true" OnRowClick="@((TableRowClickEventArgs<CalendarEntry> a) => Select(a.Item!))">
                    <HeaderContent>
                        <MudTh>日時</MudTh><MudTh>SNS</MudTh><MudTh>件名</MudTh><MudTh>状態</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@Time.Short(context.At)</MudTd>
                        <MudTd>@PlatformCatalog.Get(context.Platform).DisplayName</MudTd>
                        <MudTd>@context.Title @if (context.IsAiGenerated) { <span class="rf-ai-badge ml-1">✦AI</span> }</MudTd>
                        <MudTd><RfStatusBadge Status="context.Status" /></MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
    </MudItem>

    @if (_selected is { } sel)
    {
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true" role="region" aria-label="投稿の詳細">
                <div class="d-flex align-center">
                    <MudText Typo="Typo.h6">@sel.Title</MudText>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Rounded.Close" aria-label="詳細を閉じる" OnClick="() => _selected = null" />
                </div>
                <MudText Typo="Typo.body2">@PlatformCatalog.Get(sel.Platform).DisplayName（@sel.ChannelName）</MudText>
                <div class="my-2"><RfStatusBadge Status="sel.Status" At="sel.At" /></div>
                <MudText Typo="Typo.body2">@Time.Relative(sel.At)</MudText>

                @if (sel.Status is VariantStatus.Scheduled or VariantStatus.OnHold or VariantStatus.Approved or VariantStatus.Draft)
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.body2" Class="mb-1"><b>日時を変更</b></MudText>
                    <MudDatePicker @bind-Date="_date" Label="日付" Variant="Variant.Outlined" DateFormat="yyyy/MM/dd" />
                    <MudTimePicker @bind-Time="_time" Label="時刻" Variant="Variant.Outlined" Class="mt-2" MinuteSelectionStep="15" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="RescheduleAsync">この日時に変更する</MudButton>
                }
                <div class="d-flex flex-wrap gap-2 mt-4">
                    @if (sel.Status == VariantStatus.Scheduled)
                    {
                        <MudButton Variant="Variant.Outlined" OnClick="UnscheduleAsync">予約を取り消す</MudButton>
                    }
                    @if (sel.Status == VariantStatus.Failed)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RetryAsync">再実行する</MudButton>
                    }
                    @if (sel.Status is not (VariantStatus.Published or VariantStatus.Canceled or VariantStatus.Publishing))
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="CancelAsync">投稿を取り消す</MudButton>
                    }
                </div>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@code {
    private SchedulingService Scheduling => Scoped<SchedulingService>();

    [SupplyParameterFromQuery(Name = "view")] public string? ViewQuery { get; set; }

    private string _view = "week";
    private DateTime _weekStart;
    private IReadOnlyList<CalendarEntry> _entries = [];
    private IReadOnlyList<BestTimeSlot> _best = [];
    private CalendarEntry? _selected;
    private DateTime? _date;
    private TimeSpan? _time;

    private void ShowList() => _view = "list";

    private DateTime Today => Time.ToLocal(Time.Now).Date;

    protected override async Task OnInitializedAsync()
    {
        await Time.ZoneAsync();
        if (ViewQuery == "list") _view = "list";
        _weekStart = StartOfWeek(Today);
        _best = await Scheduling.BestTimesAsync(null, CancellationToken.None);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var from = Time.FromLocal(_weekStart);
        _entries = await Scheduling.CalendarAsync(from, from.AddDays(7), CancellationToken.None);
    }

    private async Task MoveAsync(int days)
    {
        _weekStart = days == 0 ? StartOfWeek(Today) : _weekStart.AddDays(days);
        _selected = null;
        await LoadAsync();
    }

    private void Select(CalendarEntry e)
    {
        _selected = e;
        var local = Time.ToLocal(e.At);
        _date = local.Date;
        _time = local.TimeOfDay;
    }

    private bool IsBestSlot(DateTime day, int hour) =>
        day.Date >= Today && _best.Any(s => s.Day == day.DayOfWeek && s.Hour == hour);

    private string BestRationale(DateTime day, int hour) =>
        _best.FirstOrDefault(s => s.Day == day.DayOfWeek && s.Hour == hour)?.Rationale ?? "";

    private async Task RescheduleAsync()
    {
        if (_selected is null || _date is null || _time is null) return;
        await RunAsync(async () =>
        {
            var at = Time.FromLocal(_date.Value.Date + _time.Value);
            await Scheduling.ScheduleAsync(_selected.VariantId, at, CancellationToken.None);
            Snackbar.Add($"{Time.Short(at)} に変更しました", Severity.Success);
        });
    }

    private Task UnscheduleAsync() => RunAsync(async () =>
    {
        await Scheduling.UnscheduleAsync(_selected!.VariantId, CancellationToken.None);
        Snackbar.Add("予約を取り消しました", Severity.Success);
    });

    private Task RetryAsync() => RunAsync(async () =>
    {
        await Scheduling.RetryAsync(_selected!.VariantId, CancellationToken.None);
        Snackbar.Add("再実行を予約しました。まもなく投稿します", Severity.Success);
    });

    private async Task CancelAsync()
    {
        var ok = await Dialogs.ShowMessageBoxAsync("投稿を取り消しますか？", "この投稿は公開されなくなります。", yesText: "投稿を取り消す", cancelText: "やめる");
        if (ok != true) return;
        await RunAsync(async () =>
        {
            await Scheduling.CancelAsync(_selected!.VariantId, CancellationToken.None);
            Snackbar.Add("投稿を取り消しました", Severity.Success);
        });
    }

    private async Task PauseAllAsync()
    {
        var ok = await Dialogs.ShowMessageBoxAsync("すべての予約を一時停止しますか？",
            "再開するまで、このテナントのすべての予約投稿がSNSへ投稿されなくなります。災害時や炎上時に使ってください。",
            yesText: "すべて一時停止する", cancelText: "やめる");
        if (ok != true) return;
        await RunAsync(async () =>
        {
            await Scheduling.SetPausedAsync(true, CancellationToken.None);
            Snackbar.Add("すべての予約を一時停止しました", Severity.Warning);
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
            _selected = null;
            await LoadAsync();
            await State.RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private static DateTime StartOfWeek(DateTime d) => d.Date.AddDays(-(((int)d.DayOfWeek + 6) % 7));

    private static string DayLabel(DayOfWeek d) => DashboardService.DayLabel(d);
}
