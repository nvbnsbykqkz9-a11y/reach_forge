@* 非同期処理の進捗：段階表示「待機中 → 生成中 → 確認中 → 完了」、経過時間、残り時間の目安、キャンセル（RF-UX-001 5.4 / 8.3） *@
@implements IAsyncDisposable
@inject MediaService Media
@inject ISnackbar Snackbar

<MudPaper Class="pa-3 rf-ai-surface" Elevation="0" role="status" aria-live="polite">
    <div class="d-flex align-center gap-2">
        @if (_job is null || !_job.IsFinished)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Secondary" />
        }
        <MudText Typo="Typo.body2"><b>@Title</b></MudText>
        <MudSpacer />
        <MudText Typo="Typo.caption">@_elapsed 秒（目安 約@(EstimatedSeconds)秒）</MudText>
    </div>
    <div class="d-flex gap-1 mt-2" aria-label="進み具合">
        @foreach (var stage in new[] { AiJobStage.Waiting, AiJobStage.Generating, AiJobStage.Checking, AiJobStage.Done })
        {
            var current = _job?.Stage ?? AiJobStage.Waiting;
            <MudChip T="string" Size="Size.Small" Variant="@(stage <= current ? Variant.Filled : Variant.Outlined)"
                     Color="@(stage <= current ? Color.Secondary : Color.Default)">@stage.ToLabel()</MudChip>
        }
    </div>
    <MudText Typo="Typo.caption" Class="d-block mt-1">ほかの作業を続けられます。画面を離れても処理は続きます。</MudText>
    @if (_job?.Status == AiJobStatus.Queued)
    {
        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="CancelAsync">キャンセル</MudButton>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public Guid JobId { get; set; }
    [Parameter] public string Title { get; set; } = "画像を作成中";
    [Parameter] public int EstimatedSeconds { get; set; } = 40;
    [Parameter] public EventCallback<AiJob> OnFinished { get; set; }

    private AiJob? _job;
    private int _elapsed;
    private PeriodicTimer? _timer;
    private readonly CancellationTokenSource _cts = new();

    protected override void OnInitialized() => _ = PollAsync();

    private async Task PollAsync()
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await _timer.WaitForNextTickAsync(_cts.Token))
            {
                _elapsed++;
                _job = await Media.GetJobAsync(JobId, _cts.Token);
                await InvokeAsync(StateHasChanged);
                if (_job.IsFinished)
                {
                    await InvokeAsync(() => OnFinished.InvokeAsync(_job));
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task CancelAsync()
    {
        try
        {
            await Media.CancelJobAsync(JobId, CancellationToken.None);
            Snackbar.Add("キャンセルしました（クレジットは消費されていません）", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _timer?.Dispose();
        _cts.Dispose();
    }
}
