@inherits RfComponentBase
@* よくある質問（返信案の根拠）と受信箱の自動対応の設定（F-09） *@
@inject ISnackbar Snackbar

<MudText Typo="Typo.body2" Class="mb-3">
    受信箱のAI返信案は、ここに登録した回答と商品情報だけを根拠にします（書かれていない営業時間・価格などは答えません）。
</MudText>

@foreach (var row in _rows)
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-2">
        <MudTextField T="string" @bind-Value="row.Question" Label="質問" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!CanEdit" MaxLength="200" />
        <MudTextField T="string" @bind-Value="row.Answer" Label="回答" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Class="mt-2" ReadOnly="!CanEdit" MaxLength="500" />
        <div class="d-flex align-center flex-wrap gap-2 mt-1">
            <MudCheckBox T="bool" @bind-Value="row.AllowAutoReply" Disabled="!CanEdit" Dense="true"
                         Label="自動返信を許可（よく似た質問に、この回答をそのまま返信します）" />
            <MudSpacer />
            @if (CanEdit)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => SaveAsync(row)">保存</MudButton>
                @if (row.Id is not null) { <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => DeleteAsync(row)">削除</MudButton> }
            }
        </div>
    </MudPaper>
}
@if (CanEdit)
{
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Add" OnClick="() => _rows.Add(new Row())">質問を追加</MudButton>
}

@if (_settings is not null)
{
    <MudText Typo="Typo.h6" Class="mt-6">受信箱の自動対応</MudText>
    <MudText Typo="Typo.caption" Class="d-block mb-2">苦情・健康・法律に関わる内容は、設定にかかわらず必ず人が対応します。</MudText>
    <MudSwitch T="bool" @bind-Value="_settings.AutoHideSpam" Color="Color.Primary" Disabled="!CanEdit" Label="スパムと判定したコメントをSNS上で非表示にする" />
    <MudSwitch T="bool" @bind-Value="_settings.AutoReplyFaq" Color="Color.Primary" Disabled="!CanEdit" Label="自動返信を許可した質問に自動で返信する" />
    <div class="d-flex gap-3 mt-2">
        <MudNumericField T="int" @bind-Value="_settings.SlaHighHours" Label="急ぎの返信目安（時間）" Min="1" Max="72" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!CanEdit" />
        <MudNumericField T="int" @bind-Value="_settings.SlaMediumHours" Label="ふつうの返信目安（時間）" Min="1" Max="168" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!CanEdit" />
    </div>
    @if (CanEdit) { <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="SaveSettingsAsync">自動対応の設定を保存</MudButton> }
}

@code {
    private InboxService InboxSvc => Scoped<InboxService>();

    [Parameter] public bool CanEdit { get; set; }

    private sealed class Row
    {
        public Guid? Id { get; set; }
        public string Question { get; set; } = "";
        public string Answer { get; set; } = "";
        public bool AllowAutoReply { get; set; }
    }

    private readonly List<Row> _rows = [];
    private InboxSettings? _settings;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            foreach (var k in await InboxSvc.KnowledgeAsync(CancellationToken.None))
            {
                _rows.Add(new Row { Id = k.Id, Question = k.Question, Answer = k.Answer, AllowAutoReply = k.AllowAutoReply });
            }
            _settings = await InboxSvc.SettingsAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private async Task SaveAsync(Row row)
    {
        try
        {
            row.Id = (await InboxSvc.SaveKnowledgeAsync(row.Id, row.Question, row.Answer, row.AllowAutoReply, CancellationToken.None)).Id;
            Snackbar.Add("保存しました", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private async Task DeleteAsync(Row row)
    {
        try
        {
            await InboxSvc.DeleteKnowledgeAsync(row.Id!.Value, CancellationToken.None);
            _rows.Remove(row);
            Snackbar.Add("削除しました", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private async Task SaveSettingsAsync()
    {
        try
        {
            await InboxSvc.SaveSettingsAsync(_settings!, CancellationToken.None);
            Snackbar.Add("自動対応の設定を保存しました", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }
}
