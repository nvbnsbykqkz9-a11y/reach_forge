@* 有料広告を出す（1つの SNS・1つの広告）。初心者が迷わないよう、目的 → 素材 → 広告文 → だれに・いくら → 確認して出稿 の順に1つずつ進める。
   広告費は各社の広告アカウントに登録した支払い方法へ直接請求される。出稿の前に、上限の金額を示して確認のチェックをもらう *@
@inherits RfComponentBase
@inject WebTenantContext Tenant
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject TimeDisplay Time
@inject AppState State
@inject ILogger<RfAdWizard> Log
@using ReachForge.Application.Ads

@if (AdNetworks.For(Platform) is null)
{
    @* LINE・Threads は広告 API が一般に公開されていない *@
    <MudPaper Class="pa-6 rf-card" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6">@C.DisplayName の広告は、公式の管理画面から出します</MudText>
        <MudText Typo="Typo.body1" Class="mt-2">
            @(Platform == SocialPlatform.Threads
                ? "Threads の広告は、Meta の広告マネージャで Instagram の広告といっしょに出せます（ReachForge からはまだ出せません）。"
                : "LINE の広告（LINE広告）は、広告を出すための API が一般に公開されていないため、ReachForge からは出せません。")
        </MudText>
        <MudText Typo="Typo.body2" Class="mt-2">ここでつくった投稿の文章や画像は、そのまま公式の管理画面で使えます。</MudText>
        <MudButton Href="@AdNetworks.ManualGuideUrl(Platform)" Target="_blank" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                   EndIcon="@Icons.Material.Rounded.OpenInNew">@C.DisplayName の広告の案内を開く</MudButton>
    </MudPaper>
}
else if (!_loaded)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_adapter is null)
{
    <MudPaper Class="pa-6 rf-card" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6">広告のアプリの設定が必要です</MudText>
        <MudText Typo="Typo.body1" Class="mt-2">
            @C.DisplayName の広告を出すには、@(AdNetworks.DisplayName(Network)) の API を使うアプリの設定が必要です（最初に1回だけ）。
        </MudText>
        <AuthorizeView Policy="@OpsAccess.Policy">
            <MudButton Href="/settings/sns-apps" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" StartIcon="@Icons.Material.Rounded.Key">広告のアプリを設定する</MudButton>
        </AuthorizeView>
        <MudText Typo="Typo.caption" Class="d-block mt-3">「SNSアプリの設定」でデモ接続をオンにすると、お試しの広告アカウントで流れを試せます。</MudText>
    </MudPaper>
}
else if (_accounts.Count == 0)
{
    <MudPaper Class="pa-6 rf-card" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6">まず広告アカウントをつなぎましょう</MudText>
        @if (_adapter.IsSimulation)
        {
            <MudText Typo="Typo.body1" Class="mt-2">
                いまは「お試し」です。お試しの広告アカウントをつくって、広告を出すまでの流れを体験できます。<b>実際には出稿されず、お金もかかりません。</b>
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="mt-4" Disabled="@(!CanManage || _busy)"
                       StartIcon="@Icons.Material.Rounded.Science" OnClick="ConnectAsync">お試しの広告アカウントをつくる</MudButton>
        }
        else
        {
            <MudText Typo="Typo.body1" Class="mt-2">広告は、@(AdNetworks.DisplayName(Network)) の広告アカウントから出します。つなぐ前に、次の2つを用意してください。</MudText>
            <ol class="mt-2" style="padding-left:1.4em">
                <li>@(AdNetworks.DisplayName(Network)) の広告アカウント</li>
                <li>広告アカウントに登録した支払い方法（クレジットカードなど）。広告費はここに直接請求されます</li>
            </ol>
            <div class="d-flex flex-wrap gap-2 mt-4">
                <MudButton Href="@AdNetworks.ManagerUrl(Network)" Target="_blank" Variant="Variant.Outlined" EndIcon="@Icons.Material.Rounded.OpenInNew">
                    @AdNetworks.DisplayName(Network) を開く
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Disabled="@(!CanManage || _busy)"
                           StartIcon="@Icons.Material.Rounded.Link" OnClick="ConnectAsync">広告アカウントをつなぐ</MudButton>
            </div>
        }
        @if (!CanManage)
        {
            <MudText Typo="Typo.caption" Class="d-block mt-2">広告アカウントをつなぐのは、オーナーと管理者だけができます。</MudText>
        }
    </MudPaper>
}
else
{
    @if (Account?.IsDemo == true)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">お試しの広告アカウントです。実際には出稿されず、お金もかかりません。</MudAlert>
    }
    @if (_done is { } done)
    {
        <MudPaper Class="pa-6 rf-card" Elevation="0" Outlined="true">
            @if (done.Status == AdStatus.Failed)
            {
                <MudAlert Severity="Severity.Error">広告を出せませんでした：@done.LastError</MudAlert>
                <MudText Typo="Typo.body2" Class="mt-2">@(AdNetworks.DisplayName(Network)) には何も残していません（請求もされません）。内容を直して、もう一度お試しください。</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" StartIcon="@Icons.Material.Rounded.Edit" OnClick="BackToEdit">直してもう一度出す</MudButton>
            }
            else
            {
                <MudAlert Severity="Severity.Success">広告を出しました。</MudAlert>
                <MudText Typo="Typo.body1" Class="mt-3">
                    いまは @(C.DisplayName) の<b>審査中</b>です。審査はふつう24時間以内に終わり、終わると配信が始まります。
                    結果はこの画面の下の「出した広告」で確認できます。
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" StartIcon="@Icons.Material.Rounded.Add" OnClick="StartOver">別の広告をつくる</MudButton>
            }
        </MudPaper>
    }
    else
    {
        <ol class="rf-steps" aria-label="広告を出す手順">
            @foreach (var (label, i) in s_steps.Select((l, i) => (l, i + 1)))
            {
                <li aria-current="@(_step == i ? "step" : null)" class="@(i < _step ? "rf-step-done" : "")">
                    <span class="rf-step-num" aria-hidden="true">@(i < _step ? "✓" : i.ToString())</span>@label
                </li>
            }
        </ol>
        <MudGrid>
            <MudItem xs="12" md="7">
                <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true">
                    @switch (_step)
                    {
                        case 1:
                            <MudText Typo="Typo.h6">広告で、どうなってほしいですか？</MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">いちばん近いものを1つ選んでください。</MudText>
                            <div class="d-flex flex-column gap-2" role="radiogroup" aria-label="広告の目的">
                                @foreach (var (objective, title, note, icon) in Objectives)
                                {
                                    <button type="button" class="rf-choice" role="radio" aria-checked="@(_objective == objective ? "true" : "false")"
                                            aria-pressed="@(_objective == objective ? "true" : "false")" @onclick="() => _objective = objective">
                                        <MudIcon Icon="@icon" Color="Color.Primary" aria-hidden="true" />
                                        <b>@title</b>
                                        <span class="mud-typography-body2">@note</span>
                                    </button>
                                }
                            </div>
                            <MudTextField T="string" @bind-Value="_link" Label="@(_objective == AdObjective.Traffic ? "リンク先（お店・商品のページ）" : "リンク先（任意）")"
                                          Variant="Variant.Outlined" Class="mt-4" InputType="InputType.Url" Placeholder="https://" Immediate="true"
                                          HelperText="広告を見た人が、ボタンを押したときに開くページです" />
                            <div class="d-flex justify-end mt-4">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" EndIcon="@Icons.Material.Rounded.ArrowForward"
                                           Disabled="@(LinkProblem is not null)" OnClick="() => GoTo(2)">次へ：画像・動画</MudButton>
                            </div>
                            @if (LinkProblem is { } lp) { <MudText Typo="Typo.caption" Class="d-block mt-1" Style="text-align:right">@lp</MudText> }
                            break;

                        case 2:
                            @if (Platform == SocialPlatform.YouTube)
                            {
                                <MudText Typo="Typo.h6">広告にする動画とロゴを選びましょう</MudText>
                                <MudText Typo="Typo.body2" Class="mb-3">YouTube の広告は、YouTube に投稿した動画で出します。</MudText>
                                @if (_videos.Count == 0)
                                {
                                    <MudAlert Severity="Severity.Warning">YouTube に投稿した動画がまだありません。先に「投稿をつくる」で動画を投稿してください。</MudAlert>
                                }
                                else
                                {
                                    <MudRadioGroup T="string" @bind-Value="_youTubeVideoId">
                                        @foreach (var v in _videos)
                                        {
                                            <MudRadio T="string" Value="@v.VideoId" Color="Color.Primary">@v.Title @(v.PublishedAt is { } at ? $"（{Time.Short(at)}）" : "")</MudRadio>
                                        }
                                    </MudRadioGroup>
                                }
                                <MudText Typo="Typo.subtitle2" Class="mt-4">お店・ブランドのロゴ（正方形の画像）</MudText>
                                <RfMediaPicker Selected="_media" SelectedChanged="MediaChangedAsync" Max="1" DefaultPrompt="@($"{ShopName} のロゴ")" />
                            }
                            else
                            {
                                <MudText Typo="Typo.h6">広告の画像・動画を選びましょう</MudText>
                                <MudAlert Severity="Severity.Info" Dense="true" Class="my-3">
                                    @(NeedsVideo ? $"{C.DisplayName} の広告には縦型の動画が必要です。" : "画像か動画を1つ選びます。人の目を引く、明るくはっきりした画像がおすすめです。")
                                </MudAlert>
                                <div class="d-flex flex-wrap gap-3">
                                    <div style="flex:1;min-width:220px">
                                        <button type="button" class="rf-choice" aria-pressed="@(_mediaTab == 1 ? "true" : "false")" @onclick="() => _mediaTab = 1">
                                            <MudIcon Icon="@Icons.Material.Rounded.Image" Color="Color.Primary" aria-hidden="true" />
                                            <b>@(NeedsVideo ? "動画を選ぶ" : "写真・画像・動画を選ぶ")</b>
                                            <span class="mud-typography-body2">@(NeedsVideo ? "これまでにつくった動画から選びます" : "手元の写真を選ぶか、AI で画像をつくります")</span>
                                        </button>
                                    </div>
                                    <div style="flex:1;min-width:220px">
                                        <button type="button" class="rf-choice" aria-pressed="@(_mediaTab == 2 ? "true" : "false")" @onclick="() => _mediaTab = 2">
                                            <MudIcon Icon="@Icons.Material.Rounded.Movie" Color="Color.Secondary" aria-hidden="true" />
                                            <b>AI で動画をつくる</b>
                                            <span class="mud-typography-body2">画像やお店のページから、縦型の動画をつくります</span>
                                        </button>
                                    </div>
                                </div>
                                @if (_mediaTab == 1)
                                {
                                    <div class="mt-4"><RfMediaPicker Selected="_media" SelectedChanged="MediaChangedAsync" Max="1" DefaultPrompt="@_theme" /></div>
                                }
                                else
                                {
                                    <div class="mt-4">
                                        <RfVideoMaker DefaultTheme="@_theme" DefaultUrl="@_link"
                                                      InitialMode="@(string.IsNullOrWhiteSpace(_link) ? VideoMode.Template : VideoMode.LandingPage)" OnCreated="VideoCreatedAsync" />
                                    </div>
                                }
                            }
                            @if (_asset is { } a)
                            {
                                <MudText Typo="Typo.subtitle2" Class="mt-4">広告に使う@(Platform == SocialPlatform.YouTube ? "ロゴ" : a.Kind == MediaKind.Video ? "動画" : "画像")</MudText>
                                <div class="rf-media-grid mt-1" style="max-width:220px">
                                    <RfMediaImage AssetId="a.Id" Alt="@a.AltText" ShowAiBadge="a.IsAiLabeled" />
                                </div>
                            }
                            <div class="d-flex justify-space-between mt-4">
                                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.ArrowBack" OnClick="() => GoTo(1)">戻る</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" EndIcon="@Icons.Material.Rounded.ArrowForward"
                                           Disabled="@(MediaProblem is not null)" OnClick="() => GoTo(3)">次へ：広告文</MudButton>
                            </div>
                            @if (MediaProblem is { } mp) { <MudText Typo="Typo.caption" Class="d-block mt-1" Style="text-align:right">@mp</MudText> }
                            break;

                        case 3:
                            <MudText Typo="Typo.h6">広告文をつくりましょう</MudText>
                            <MudTextField T="string" @bind-Value="_theme" Label="広告で伝えたいこと" Variant="Variant.Outlined" Lines="2" MaxLength="500" Immediate="true"
                                          Placeholder="例：秋限定のさつまいもラテ。テイクアウトもできます" Class="mt-2" />
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="mt-2" StartIcon="@Icons.Material.Rounded.AutoAwesome"
                                       Disabled="@(_busy || string.IsNullOrWhiteSpace(_theme))" OnClick="SuggestAsync">
                                @(_busy ? "AI が考えています…" : $"AI に広告文を書いてもらう（約{CopyCredits}クレジット）")
                            </MudButton>
                            @if (_busy) { <MudProgressLinear Indeterminate="true" Color="Color.Secondary" Class="mt-3" /> }
                            @if (_suggestions.Count > 0)
                            {
                                <MudText Typo="Typo.subtitle2" Class="mt-4">気に入った案の「これにする」を押してください（あとで直せます）</MudText>
                                @foreach (var s in _suggestions)
                                {
                                    <MudPaper Class="pa-3 mt-2" Elevation="0" Outlined="true">
                                        @if (s.Headline.Length > 0) { <MudText Typo="Typo.subtitle1"><b>@s.Headline</b></MudText> }
                                        <MudText Typo="Typo.body2" Style="white-space:pre-wrap">@s.PrimaryText</MudText>
                                        @if (s.Description.Length > 0) { <MudText Typo="Typo.caption" Class="d-block">@s.Description</MudText> }
                                        @if (s.Guardrail is { Findings.Count: > 0 } g)
                                        {
                                            <RfGuardrailPanel Findings="g.Findings" ReadOnly="true" />
                                        }
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="() => Use(s)">これにする</MudButton>
                                    </MudPaper>
                                }
                            }
                            <MudDivider Class="my-4" />
                            <MudText Typo="Typo.subtitle2">広告文（自由に直せます）</MudText>
                            <MudTextField T="string" @bind-Value="_primary" Label="本文" Variant="Variant.Outlined" Lines="4" Immediate="true" Class="mt-2" />
                            <RfCharCounter Text="@(_primary ?? "")" Max="Limits.PrimaryText" />
                            @if (Limits.Headline > 0)
                            {
                                <MudTextField T="string" @bind-Value="_headline" Label="見出し" Variant="Variant.Outlined" Immediate="true" Class="mt-2" />
                                <RfCharCounter Text="@(_headline ?? "")" Max="Limits.Headline" />
                            }
                            @if (Limits.Description > 0)
                            {
                                <MudTextField T="string" @bind-Value="_description" Label="説明（任意）" Variant="Variant.Outlined" Immediate="true" Class="mt-2" />
                                <RfCharCounter Text="@(_description ?? "")" Max="Limits.Description" />
                            }
                            @if (Platform != SocialPlatform.X)
                            {
                                <MudSelect T="string" @bind-Value="_cta" Label="ボタンの文字" Variant="Variant.Outlined" Class="mt-2" Style="max-width:280px">
                                    @foreach (var (value, label) in s_ctas) { <MudSelectItem T="string" Value="@value">@label</MudSelectItem> }
                                </MudSelect>
                            }
                            <div class="d-flex justify-space-between mt-4">
                                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.ArrowBack" OnClick="() => GoTo(2)">戻る</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" EndIcon="@Icons.Material.Rounded.ArrowForward"
                                           Disabled="@(TextProblem is not null)" OnClick="() => GoTo(4)">次へ：だれに・いくら</MudButton>
                            </div>
                            @if (TextProblem is { } tp) { <MudText Typo="Typo.caption" Class="d-block mt-1" Style="text-align:right">@tp</MudText> }
                            break;

                        case 4:
                            <MudText Typo="Typo.h6">だれに見せて、いくら使いますか？</MudText>
                            <MudText Typo="Typo.subtitle2" Class="mt-3">見せる人</MudText>
                            <MudText Typo="Typo.body2">地域：日本全国</MudText>
                            <div class="d-flex flex-wrap gap-2 align-center mt-2">
                                <MudSelect T="int" @bind-Value="_ageMin" Label="年齢（から）" Variant="Variant.Outlined" Style="max-width:150px" Dense="true">
                                    @foreach (var age in s_ages.Where(x => x < AdTargeting.MaxAge)) { <MudSelectItem T="int" Value="age">@age 歳</MudSelectItem> }
                                </MudSelect>
                                <span aria-hidden="true">〜</span>
                                <MudSelect T="int" @bind-Value="_ageMax" Label="年齢（まで）" Variant="Variant.Outlined" Style="max-width:150px" Dense="true">
                                    @foreach (var age in s_ages.Where(x => x > _ageMin)) { <MudSelectItem T="int" Value="age">@(age == AdTargeting.MaxAge ? "65歳以上" : $"{age} 歳")</MudSelectItem> }
                                </MudSelect>
                            </div>
                            <MudRadioGroup T="AdGender" @bind-Value="_gender" Class="mt-2">
                                <MudRadio T="AdGender" Value="AdGender.All" Color="Color.Primary">すべての性別</MudRadio>
                                <MudRadio T="AdGender" Value="AdGender.Female" Color="Color.Primary">女性</MudRadio>
                                <MudRadio T="AdGender" Value="AdGender.Male" Color="Color.Primary">男性</MudRadio>
                            </MudRadioGroup>

                            <MudText Typo="Typo.subtitle2" Class="mt-4">1日の予算（@Currency）</MudText>
                            <div class="d-flex flex-wrap gap-2 mt-1">
                                @foreach (var b in BudgetChoices)
                                {
                                    <MudChip T="string" Variant="@(_budget == b ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="() => _budget = b">@Money(b)</MudChip>
                                }
                            </div>
                            <MudNumericField T="decimal" @bind-Value="_budget" Label="1日の予算" Variant="Variant.Outlined" Min="MinBudget" Step="100" Class="mt-2" Style="max-width:220px"
                                             HelperText="@($"{Money(MinBudget)} から")" Immediate="true" />

                            <MudText Typo="Typo.subtitle2" Class="mt-4">期間</MudText>
                            <div class="d-flex flex-wrap gap-2 align-center mt-1">
                                <MudDatePicker @bind-Date="_startDate" Label="開始日" Variant="Variant.Outlined" MinDate="@Today" DateFormat="yyyy/MM/dd" Style="max-width:200px" />
                                @foreach (var d in s_days)
                                {
                                    <MudChip T="string" Variant="@(_days == d ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="() => _days = d">@(d)日間</MudChip>
                                }
                            </div>
                            <MudAlert Severity="Severity.Normal" Class="mt-3" Icon="@Icons.Material.Rounded.Payments">
                                広告費は<b>最大 @Money(MaxTotal)</b>（1日 @Money(_budget) × @(_days)日）です。@Time.ToLocal(StartAt).ToString("M/d") 〜 @Time.ToLocal(EndAt).ToString("M/d") に配信します。
                            </MudAlert>
                            <div class="d-flex justify-space-between mt-4">
                                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.ArrowBack" OnClick="() => GoTo(3)">戻る</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" EndIcon="@Icons.Material.Rounded.ArrowForward"
                                           Disabled="@(BudgetProblem is not null)" OnClick="() => GoTo(5)">次へ：確認</MudButton>
                            </div>
                            @if (BudgetProblem is { } bp) { <MudText Typo="Typo.caption" Class="d-block mt-1" Style="text-align:right">@bp</MudText> }
                            break;

                        case 5:
                            <MudText Typo="Typo.h6">確認して広告を出しましょう</MudText>
                            @if (_accounts.Count > 1)
                            {
                                <MudSelect T="Guid" @bind-Value="_accountId" Label="広告アカウント" Variant="Variant.Outlined" Class="mt-2" Style="max-width:360px">
                                    @foreach (var acc in _accounts) { <MudSelectItem T="Guid" Value="acc.Id">@acc.Name（@acc.Currency）</MudSelectItem> }
                                </MudSelect>
                            }
                            <table class="rf-summary mt-3">
                                <tbody>
                                    <tr><th scope="row">広告アカウント</th><td>@Account?.Name</td></tr>
                                    <tr><th scope="row">目的</th><td>@Objectives.First(o => o.Objective == _objective).Title</td></tr>
                                    <tr><th scope="row">リンク先</th><td style="word-break:break-all">@(string.IsNullOrWhiteSpace(_link) ? "なし" : _link)</td></tr>
                                    <tr><th scope="row">見せる人</th><td>日本全国・@AgeLabel・@GenderLabel</td></tr>
                                    <tr><th scope="row">期間</th><td>@Time.ToLocal(StartAt).ToString("yyyy/M/d") から @(_days)日間</td></tr>
                                    <tr><th scope="row">予算</th><td>1日 @Money(_budget)（最大 <b>@Money(MaxTotal)</b>）</td></tr>
                                </tbody>
                            </table>
                            <MudCheckBox T="bool" @bind-Value="_chargesOk" Class="mt-3" Color="Color.Primary"
                                         Label="@(Account?.IsDemo == true ? "お試しなので、実際には出稿・請求されないことを確認しました" : $"広告費（最大 {Money(MaxTotal)}）が、{AdNetworks.DisplayName(Network)} から広告アカウントの支払い方法へ請求されることを確認しました")" />
                            <MudText Typo="Typo.caption" Class="d-block mt-1">出したあとも、「出した広告」からいつでも一時停止できます。審査で承認されなかった広告には請求されません。</MudText>
                            <div class="d-flex justify-space-between mt-4">
                                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.ArrowBack" Disabled="_busy" OnClick="() => GoTo(4)">戻る</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Rounded.Campaign"
                                           Disabled="@(_busy || !_chargesOk)" OnClick="SubmitAsync">
                                    @(_busy ? "広告を出しています…" : "広告を出す")
                                </MudButton>
                            </div>
                            @if (_busy) { <MudProgressLinear Indeterminate="true" Class="mt-3" /><MudText Typo="Typo.caption">動画のアップロードには数分かかることがあります。画面を閉じずにお待ちください。</MudText> }
                            break;
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="5">
                <div style="position:sticky;top:80px">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@C.DisplayName での見え方（広告）</MudText>
                    <RfPlatformPreview Platform="Platform" Body="@(_primary ?? _theme ?? "")" Hashtags="[]" Title="@_headline"
                                       AccountName="@(Channel?.DisplayName ?? ShopName)" ImageAssetId="@_asset?.Id"
                                       ImageIsAi="@(_asset?.IsAiLabeled ?? false)" ImageCount="@(_asset is null ? 0 : 1)" />
                    <MudText Typo="Typo.caption" Class="d-block mt-1">実際の広告には「広告」「スポンサー」などの表示と、ボタンが付きます。</MudText>
                </div>
            </MudItem>
        </MudGrid>
    }

    <MudText Typo="Typo.h6" Class="mt-8 mb-2">出した広告</MudText>
    @if (_campaigns.Count == 0)
    {
        <MudText Typo="Typo.body2" Style="color:var(--rf-color-text-secondary)">まだありません。</MudText>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var ad in _campaigns)
            {
                <MudPaper Class="pa-3 rf-card" Elevation="0" Outlined="true">
                    <div class="d-flex align-center flex-wrap gap-2">
                        <MudText Typo="Typo.subtitle1"><b>@ad.Name</b></MudText>
                        <MudChip T="string" Size="Size.Small" Color="@StatusColor(ad.Status)">@StatusLabel(ad.Status)</MudChip>
                        <MudSpacer />
                        @if (ad.Status is AdStatus.Active or AdStatus.InReview)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Pause" Disabled="_busy" OnClick="() => PauseAsync(ad, true)">一時停止</MudButton>
                        }
                        else if (ad.Status == AdStatus.Paused)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.PlayArrow" Disabled="_busy" OnClick="() => PauseAsync(ad, false)">再開</MudButton>
                        }
                        @if (ad.IsLive)
                        {
                            <MudIconButton Icon="@Icons.Material.Rounded.Refresh" Size="Size.Small" aria-label="最新の状態にする" Disabled="_busy" OnClick="() => SyncAsync(ad)" />
                        }
                    </div>
                    <MudText Typo="Typo.caption" Class="d-block">
                        @Time.ToLocal(ad.StartAt).ToString("M/d") 〜 @Time.ToLocal(ad.EndAt).ToString("M/d")・1日 @Money(ad.DailyBudget, ad.Currency)
                    </MudText>
                    @if (ad.Results is { } r)
                    {
                        <div class="d-flex flex-wrap gap-4 mt-1">
                            <span><span class="mud-typography-caption">表示された回数</span><br /><b>@r.Impressions.ToString("N0")</b></span>
                            <span><span class="mud-typography-caption">クリック</span><br /><b>@r.Clicks.ToString("N0")</b></span>
                            @if (r.VideoViews > 0) { <span><span class="mud-typography-caption">動画の再生</span><br /><b>@r.VideoViews.ToString("N0")</b></span> }
                            <span><span class="mud-typography-caption">使った金額</span><br /><b>@Money(r.Spend, ad.Currency)</b></span>
                        </div>
                    }
                    @if (ad.Status == AdStatus.Failed && ad.LastError is { } err)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-1">@err</MudText>
                    }
                    @if (ad.ReviewNote is { } note)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Warning" Class="mt-1">@note</MudText>
                    }
                </MudPaper>
            }
        </div>
    }
    @if (CanManage)
    {
        <div class="d-flex flex-wrap gap-2 align-center mt-4">
            <MudText Typo="Typo.caption">広告アカウント：@string.Join("、", _accounts.Select(a => a.Name))</MudText>
            <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_busy" OnClick="ConnectAsync">つなぎ直す・追加する</MudButton>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public SocialPlatform Platform { get; set; }
    [Parameter] public Channel? Channel { get; set; }

    /// <summary>広告アカウントの連携から戻ってきた。</summary>
    [Parameter] public bool JustConnected { get; set; }
    [Parameter] public string? Error { get; set; }

    private static readonly string[] s_steps = ["目的", "画像・動画", "広告文", "だれに・いくら", "確認して出す"];
    private static readonly int[] s_ages = [18, 20, 25, 30, 35, 40, 45, 50, 55, 60, 65];
    private static readonly int[] s_days = [3, 7, 14, 30];
    private static readonly (string Value, string Label)[] s_ctas =
        [("LEARN_MORE", "詳しくはこちら"), ("SHOP_NOW", "購入する"), ("BOOK_NOW", "予約する"), ("SIGN_UP", "登録する"), ("CONTACT_US", "お問い合わせ")];

    private AdService Ads => Scoped<AdService>();
    private PlatformConstraint C => PlatformCatalog.Get(Platform);
    private AdNetwork Network => AdNetworks.For(Platform) ?? AdNetwork.Demo;
    private AdCopyLimits Limits => AdCopyLimits.For(Platform);
    private bool CanManage => RolePolicy.Can(Tenant.Role, Permission.ManageChannels);
    private static int CopyCredits => ReachForge.Domain.Credits.CreditTable.Cost(CreditOperation.CopyGeneration);

    private IAdNetworkAdapter? _adapter;
    private IReadOnlyList<AdAccount> _accounts = [];
    private IReadOnlyList<AdCampaign> _campaigns = [];
    private IReadOnlyList<YouTubeVideoChoice> _videos = [];
    private bool _loaded, _busy;

    private int _step = 1;
    private AdObjective _objective = AdObjective.Traffic;
    private string? _link, _theme;
    private int _mediaTab = 1;
    private List<Guid> _media = [];
    private MediaAsset? _asset;
    private string? _youTubeVideoId;
    private IReadOnlyList<AdCopyCandidate> _suggestions = [];
    private string? _primary, _headline, _description;
    private string _cta = "LEARN_MORE";
    private int _ageMin = AdTargeting.MinAge, _ageMax = AdTargeting.MaxAge;
    private AdGender _gender = AdGender.All;
    private decimal _budget;
    private DateTime? _startDate;
    private int _days = 7;
    private Guid _accountId;
    private bool _chargesOk;
    private AdCampaign? _done;

    private AdAccount? Account => _accounts.FirstOrDefault(a => a.Id == _accountId) ?? _accounts.FirstOrDefault();
    private string Currency => Account?.Currency ?? "JPY";
    private decimal MinBudget => _adapter?.MinDailyBudget(Currency) ?? 0;
    private bool NeedsVideo => _adapter?.RequiresVideo(Platform) == true || _objective == AdObjective.VideoViews;
    private DateTime Today => Time.ToLocal(Time.Now).Date;
    private string ShopName => State.Workspace?.Name ?? "お店";

    /// <summary>今日なら少しあと（すぐ審査に入る）、それ以外はその日の0時から。</summary>
    private DateTimeOffset StartAt => _startDate is { } d && d.Date > Today ? Time.FromLocal(d.Date) : Time.Now.AddMinutes(15);
    private DateTimeOffset EndAt => _startDate is { } d && d.Date > Today ? Time.FromLocal(d.Date.AddDays(_days)) : Time.FromLocal(Today.AddDays(_days));
    private decimal MaxTotal => _budget * _days;

    private IEnumerable<decimal> BudgetChoices => Currency == "JPY"
        ? new decimal[] { 500, 1000, 3000, 5000, 10000 }.Where(b => b >= MinBudget).Prepend(MinBudget).Distinct().Take(5)
        : new decimal[] { 5, 10, 20, 50 }.Where(b => b >= MinBudget).Prepend(MinBudget).Distinct();

    private IEnumerable<(AdObjective Objective, string Title, string Note, string Icon)> Objectives =>
        new[]
        {
            (AdObjective.Traffic, "お店・商品のページに来てほしい", "広告を見た人に、リンク先のページを開いてもらいます", Icons.Material.Rounded.Storefront),
            (AdObjective.Awareness, "たくさんの人に知ってほしい", "なるべく多くの人に、広告を見てもらいます", Icons.Material.Rounded.Groups),
            (AdObjective.VideoViews, "動画を見てほしい", "動画を最後まで見てくれそうな人に届けます（動画が必要です）", Icons.Material.Rounded.PlayCircle),
        };

    private string? LinkProblem =>
        _objective == AdObjective.Traffic && string.IsNullOrWhiteSpace(_link) ? "リンク先の URL を入力してください"
        : !string.IsNullOrWhiteSpace(_link) && !(Uri.TryCreate(_link.Trim(), UriKind.Absolute, out var u) && u.Scheme == Uri.UriSchemeHttps) ? "https:// で始まる URL を入力してください"
        : null;

    private string? MediaProblem =>
        Platform == SocialPlatform.YouTube
            ? string.IsNullOrEmpty(_youTubeVideoId) ? "広告にする動画を選んでください" : _asset?.Kind != MediaKind.Image ? "ロゴの画像を選んでください" : null
            : _asset is null ? "画像か動画を1つ選んでください"
            : NeedsVideo && _asset.Kind != MediaKind.Video ? $"{C.DisplayName} のこの広告には動画が必要です"
            : null;

    private string? TextProblem =>
        string.IsNullOrWhiteSpace(_primary) ? "本文を入力してください"
        : PostText.Length(_primary) > Limits.PrimaryText ? $"本文は{Limits.PrimaryText}字以内にしてください"
        : Limits.Headline > 0 && PostText.Length(_headline ?? "") > Limits.Headline ? $"見出しは{Limits.Headline}字以内にしてください"
        : Limits.Description > 0 && PostText.Length(_description ?? "") > Limits.Description ? $"説明は{Limits.Description}字以内にしてください"
        : null;

    private string? BudgetProblem =>
        _budget < MinBudget ? $"1日の予算は {Money(MinBudget)} 以上にしてください"
        : _startDate is null ? "開始日を選んでください"
        : null;

    private string AgeLabel => _ageMin == AdTargeting.MinAge && _ageMax == AdTargeting.MaxAge ? "18歳以上のすべての年齢"
        : _ageMax == AdTargeting.MaxAge ? $"{_ageMin}歳以上" : $"{_ageMin}〜{_ageMax}歳";
    private string GenderLabel => _gender switch { AdGender.Female => "女性", AdGender.Male => "男性", _ => "すべての性別" };

    protected override async Task OnParametersSetAsync()
    {
        await Time.ZoneAsync();
        _startDate ??= Today;
        if (AdNetworks.For(Platform) is null) return;
        _adapter = Ads.AdapterFor(Platform);
        await ReloadAsync();
        _budget = _budget == 0 ? Math.Max(MinBudget, Currency == "JPY" ? 1000 : 10) : _budget;
        if (Platform == SocialPlatform.YouTube) _videos = await Ads.YouTubeVideosAsync(CancellationToken.None);
        if (Platform is SocialPlatform.TikTok or SocialPlatform.YouTube) _objective = AdObjective.VideoViews;
        _loaded = true;
    }

    protected override void OnInitialized()
    {
        // 広告アカウントの連携から戻ってきたときの結果（1回だけ知らせる）
        if (JustConnected) Snackbar.Add("広告アカウントをつなぎました", Severity.Success);
        if (!string.IsNullOrEmpty(Error)) Snackbar.Add(Error, Severity.Error);
    }

    private async Task ReloadAsync()
    {
        _accounts = await Ads.AccountsAsync(Network, CancellationToken.None);
        if (_accounts.All(a => a.Id != _accountId)) _accountId = _accounts.FirstOrDefault()?.Id ?? Guid.Empty;
        _campaigns = await Ads.ListAsync(Platform, CancellationToken.None);
    }

    private void GoTo(int step) => _step = step;

    private string Money(decimal amount) => Money(amount, Currency);

    private static string Money(decimal amount, string currency) =>
        currency == "JPY" ? $"{amount:N0}円" : $"{amount:N2} {currency}";

    private async Task ConnectAsync()
    {
        _busy = true;
        try
        {
            var url = await Ads.BeginConnectAsync(Platform, Nav.ToAbsoluteUri("/" + AdNetworks.CallbackPath(Network)).ToString(), CancellationToken.None);
            if (url is not null)
            {
                Nav.NavigateTo(url, forceLoad: true); // 各社の認可画面へ
                return;
            }
            Snackbar.Add("お試しの広告アカウントをつくりました", Severity.Success);
            await ReloadAsync();
            _budget = Math.Max(_budget, MinBudget);
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex, Log);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MediaChangedAsync(List<Guid> ids)
    {
        _media = ids;
        _asset = ids.Count == 0 ? null : await Scoped<MediaService>().GetAsync(ids[^1], CancellationToken.None);
    }

    private async Task VideoCreatedAsync(Guid id)
    {
        await MediaChangedAsync([id]);
        Snackbar.Add("動画を広告に使う素材にしました", Severity.Success);
    }

    private async Task SuggestAsync()
    {
        _busy = true;
        try
        {
            _suggestions = await Ads.SuggestCopyAsync(new AdCopyRequest(Platform, _objective, _theme!.Trim(), string.IsNullOrWhiteSpace(_link) ? null : _link.Trim()),
                CancellationToken.None);
            if (string.IsNullOrWhiteSpace(_primary) && _suggestions.FirstOrDefault() is { } first) Use(first);
            await State.RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex, Log);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Use(AdCopyCandidate s)
    {
        _primary = s.PrimaryText;
        _headline = s.Headline;
        _description = s.Description;
        _cta = s.CallToAction;
    }

    private async Task SubmitAsync()
    {
        var ok = await Dialogs.ShowMessageBoxAsync("広告を出しますか？",
            Account?.IsDemo == true ? "お試しなので、実際には出稿・請求されません。"
                : $"{C.DisplayName} の審査のあと配信が始まり、広告費（最大 {Money(MaxTotal)}）が請求されます。",
            yesText: "広告を出す", cancelText: "やめる");
        if (ok != true) return;
        _busy = true;
        try
        {
            _done = await Ads.SubmitAsync(new AdDraft
            {
                Platform = Platform, AdAccountId = Account!.Id, Objective = _objective, DailyBudget = _budget, StartAt = StartAt, EndAt = EndAt,
                Targeting = new AdTargeting { AgeMin = _ageMin, AgeMax = _ageMax, Gender = _gender },
                Creative = new AdCreative
                {
                    PrimaryText = _primary ?? "", Headline = Limits.Headline > 0 ? _headline ?? "" : "", Description = Limits.Description > 0 ? _description ?? "" : "",
                    LinkUrl = string.IsNullOrWhiteSpace(_link) ? null : _link.Trim(), CallToAction = _cta, MediaAssetId = _asset?.Id,
                    YouTubeVideoId = Platform == SocialPlatform.YouTube ? _youTubeVideoId : null,
                },
            }, _chargesOk, CancellationToken.None);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex, Log);
        }
        finally
        {
            _busy = false;
        }
    }

    private void BackToEdit()
    {
        _done = null;
        _chargesOk = false;
        _step = 3;
    }

    private void StartOver()
    {
        _done = null;
        _step = 1;
        _media = [];
        _asset = null;
        _suggestions = [];
        _primary = _headline = _description = null;
        _chargesOk = false;
    }

    private async Task PauseAsync(AdCampaign ad, bool paused)
    {
        if (paused)
        {
            var ok = await Dialogs.ShowMessageBoxAsync("広告を一時停止しますか？", "止めている間は配信されず、広告費もかかりません。あとで再開できます。",
                yesText: "一時停止する", cancelText: "やめる");
            if (ok != true) return;
        }
        _busy = true;
        try
        {
            await Ads.SetPausedAsync(ad.Id, paused, CancellationToken.None);
            Snackbar.Add(paused ? "一時停止しました" : "再開しました", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex, Log);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SyncAsync(AdCampaign ad)
    {
        _busy = true;
        try
        {
            await Ads.SyncAsync(ad.Id, CancellationToken.None);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex, Log);
        }
        finally
        {
            _busy = false;
        }
    }

    public static string StatusLabel(AdStatus s) => s switch
    {
        AdStatus.Submitting => "送信中",
        AdStatus.InReview => "審査中",
        AdStatus.Active => "配信中",
        AdStatus.Paused => "一時停止中",
        AdStatus.Completed => "終了",
        AdStatus.Rejected => "承認されませんでした",
        AdStatus.Failed => "出せませんでした",
        _ => "下書き",
    };

    public static Color StatusColor(AdStatus s) => s switch
    {
        AdStatus.Active => Color.Success,
        AdStatus.InReview or AdStatus.Submitting => Color.Info,
        AdStatus.Paused => Color.Warning,
        AdStatus.Rejected or AdStatus.Failed => Color.Error,
        _ => Color.Default,
    };
}
