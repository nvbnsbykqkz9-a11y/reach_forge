@* AI生成案のカード：案番号・ブランド適合スコア・ガードレール・本文・操作（RF-UX-001 5.4） *@
<MudPaper Class="@($"pa-4 mb-3 rf-ai-surface {(Selected ? "mud-border-secondary" : "")}")" Elevation="0"
          Style="@(Selected ? "border-width:2px" : "")">
    <div class="d-flex align-center gap-2 mb-2">
        <span class="rf-ai-badge"><MudIcon Icon="@Icons.Material.Rounded.AutoAwesome" Size="Size.Small" aria-hidden="true" />AI 案@(Letter)</span>
        @if (Candidate.Rank == 1)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">おすすめ</MudChip>
        }
        <MudSpacer />
        @if (Candidate.BrandFitScore > 0)
        {
            <MudTooltip Text="@(Candidate.BrandFitReason ?? "ブランドの口調・必須表記などとの適合度（AIによる評価）")">
                <MudText Typo="Typo.body2">ブランドらしさ ★@Candidate.BrandFitScore.ToString("0.0")</MudText>
            </MudTooltip>
        }
    </div>
    <MudText Typo="Typo.h6">@Candidate.Headline</MudText>
    <MudText Typo="Typo.body1" Style="white-space:pre-wrap" Class="mt-1">@(Expanded ? Candidate.Body : Shorten(Candidate.Body))</MudText>
    <MudText Typo="Typo.body2" Class="mt-1" Style="color:var(--rf-color-text-secondary)">@Candidate.Cta</MudText>
    <MudText Typo="Typo.body2" Class="mt-1" Style="color:var(--rf-color-primary)">@string.Join(" ", Candidate.Hashtags.Select(t => "#" + t))</MudText>

    @if (Candidate.Guardrail.Findings.Count > 0)
    {
        <div class="mt-2">
            <RfGuardrailPanel Findings="Candidate.Guardrail.Findings" ReadOnly="true" />
        </div>
    }

    <div class="d-flex flex-wrap gap-1 mt-3" role="group" aria-label="クイック修正">
        @foreach (var fix in Enum.GetValues<QuickFix>())
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Disabled="Busy"
                     OnClick="() => OnQuickFix.InvokeAsync(fix)">@fix.ToLabel()</MudChip>
        }
    </div>
    <div class="d-flex align-center gap-2 mt-3">
        <MudIconButton Icon="@Icons.Material.Rounded.ThumbUp" Size="Size.Small" aria-label="この案は良い"
                       Color="@(_feedback == true ? Color.Primary : Color.Default)" OnClick="() => _feedback = true" />
        <MudIconButton Icon="@Icons.Material.Rounded.ThumbDown" Size="Size.Small" aria-label="この案は良くない"
                       Color="@(_feedback == false ? Color.Error : Color.Default)" OnClick="() => _feedback = false" />
        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => Expanded = !Expanded">@(Expanded ? "折りたたむ" : "全文を見る")</MudButton>
        <MudSpacer />
        <MudButton Variant="@(Selected ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Disabled="Busy"
                   OnClick="OnAdopt">@(Selected ? "選択中" : "この案を使う")</MudButton>
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired] public CopyCandidate Candidate { get; set; } = default!;
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public EventCallback OnAdopt { get; set; }
    [Parameter] public EventCallback<QuickFix> OnQuickFix { get; set; }

    // TODO(13.1 ai_feedback): 👍／👎 と理由を計測イベントとして記録する
    private bool? _feedback;

    private string Letter => ((char)('A' + Candidate.Rank - 1)).ToString();

    private static string Shorten(string s)
    {
        var lines = s.Split('\n');
        return lines.Length <= 2 ? s : string.Join('\n', lines.Take(2)) + "…";
    }
}
