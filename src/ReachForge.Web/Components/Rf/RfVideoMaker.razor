@inherits RfComponentBase
@* ショート動画（F-05）：③ テンプレート合成（画像＋テロップ＋ナレーション＋BGM）、① テキスト→動画・② 画像→動画（生成 AI）。
   実行前に推定クレジットと所要時間を確認する *@
@inject AppState State
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<MudPaper Class="pa-4 rf-ai-surface" Elevation="0">
    <span class="rf-ai-badge"><MudIcon Icon="@Icons.Material.Rounded.Movie" Size="Size.Small" aria-hidden="true" />ショート動画をつくる</span>
    <MudText Typo="Typo.body2" Class="mt-1">縦型（9:16）の動画をつくります。Reels・TikTok・Shorts向けです。</MudText>
    <MudToggleGroup T="VideoMode" @bind-Value="_mode" Color="Color.Secondary" Class="mt-2" SelectionMode="SelectionMode.SingleSelection" aria-label="作り方">
        <MudToggleItem Value="VideoMode.Template">画像＋テロップ</MudToggleItem>
        <MudToggleItem Value="VideoMode.ImageToVideo">画像に動きをつける（AI）</MudToggleItem>
        <MudToggleItem Value="VideoMode.TextToVideo">文章から動画（AI）</MudToggleItem>
    </MudToggleGroup>
    <MudText Typo="Typo.caption" Class="d-block mt-1">@ModeHint</MudText>
    <MudTextField T="string" @bind-Value="_theme" Label="@(_mode == VideoMode.Template ? "テーマ（必須）" : "どんな動画にしますか（必須）")" Variant="Variant.Outlined"
                  Class="mt-2" MaxLength="300" Immediate="true"
                  Placeholder="@(_mode == VideoMode.Template ? "例：秋限定さつまいもラテの発売" : "例：湯気の立つラテにミルクを注ぐ、やわらかい朝の光")" />
    @if (_mode != VideoMode.TextToVideo)
    {
    <MudText Typo="Typo.subtitle2" Class="mt-3">@(_mode == VideoMode.ImageToVideo ? $"動きをつける画像（{_selected.Count}／1 枚）" : $"使う画像（{_selected.Count}／{VideoJobRequest.MaxImages} 枚・選んだ順に使います）")</MudText>
    <div class="rf-media-grid mt-1" role="group" aria-label="動画に使う画像を選ぶ">
        @foreach (var m in _images.Take(24))
        {
            var index = _selected.IndexOf(m.Id);
            <button type="button" class="rf-media-pick @(index >= 0 ? "rf-media-pick-on" : "")" aria-pressed="@(index >= 0 ? "true" : "false")"
                    @onclick="() => Toggle(m.Id)" aria-label="@(m.AltText ?? m.FileName)">
                <RfMediaImage AssetId="m.Id" Alt="@m.AltText" ShowAiBadge="m.IsAiLabeled" />
                @if (index >= 0) { <span class="rf-media-order">@(index + 1)</span> }
            </button>
        }
    </div>
    }
    <div class="d-flex flex-wrap align-center gap-4 mt-3">
        @if (_mode == VideoMode.Template)
        {
            <MudSwitch T="bool" @bind-Value="_narration" Color="Color.Secondary" Label="AIのナレーションを入れる" />
            <div style="min-width:220px">
                <MudText Typo="Typo.caption">長さの目安：@_seconds 秒</MudText>
                <MudSlider T="int" @bind-Value="_seconds" Min="VideoJobRequest.MinSeconds" Max="VideoJobRequest.MaxSeconds" Step="5" aria-label="動画の長さ（秒）" />
            </div>
        }
        else
        {
            <div style="min-width:220px">
                <MudText Typo="Typo.caption">長さ：@_aiSeconds 秒</MudText>
                <MudSlider T="int" @bind-Value="_aiSeconds" Min="VideoGenerationSpec.MinSeconds" Max="VideoGenerationSpec.MaxSeconds" Step="4" aria-label="動画の長さ（秒）" />
            </div>
        }
        <MudSelect T="string" @bind-Value="_bgm" Label="BGM" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:220px">
            <MudSelectItem T="string" Value="@("")">なし</MudSelectItem>
            @foreach (var t in Videos.BgmTracks)
            {
                <MudSelectItem T="string" Value="@t.Id">@t.Title</MudSelectItem>
            }
        </MudSelect>
    </div>
    @if (Videos.BgmTracks.FirstOrDefault(t => t.Id == _bgm) is { } track)
    {
        <MudText Typo="Typo.caption" Class="d-block">BGM の利用条件：@track.License（ナレーションの間は自動で音量を下げます）</MudText>
    }
    @if (_jobId is { } jobId)
    {
        <div class="mt-3"><RfJobProgress JobId="jobId" Title="動画を作成中" EstimatedSeconds="@((int)EstimatedTime.TotalSeconds)" OnFinished="FinishedAsync" /></div>
    }
    else
    {
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="mt-3" OnClick="CreateAsync"
                   Disabled="@(!CanCreate)">動画をつくる（約@(Estimate)クレジット）</MudButton>
    }
</MudPaper>

@code {
    private MediaService Media => Scoped<MediaService>();
    private VideoService Videos => Scoped<VideoService>();

    [Parameter] public string? DefaultTheme { get; set; }
    [Parameter] public EventCallback<Guid> OnCreated { get; set; }

    private IReadOnlyList<MediaAsset> _images = [];
    private readonly List<Guid> _selected = [];
    private string? _theme;
    private bool _narration = true;
    private int _seconds = 20;
    private int _aiSeconds = 8;
    private VideoMode _mode = VideoMode.Template;
    private string _bgm = "";
    private Guid? _jobId;

    private VideoJobRequest Request => _mode == VideoMode.Template
        ? new VideoJobRequest(_theme ?? "", _selected.ToList(), _narration, _seconds, _mode, _bgm.Length > 0 ? _bgm : null)
        : new VideoJobRequest(_theme ?? "", _mode == VideoMode.ImageToVideo ? _selected.Take(1).ToList() : [], false, _aiSeconds, _mode,
            _bgm.Length > 0 ? _bgm : null);

    private int Estimate => VideoService.EstimateCredits(Request);

    private TimeSpan EstimatedTime => _mode == VideoMode.Template ? VideoService.EstimatedDuration : VideoService.EstimatedGenerativeDuration;

    private bool CanCreate => !string.IsNullOrWhiteSpace(_theme) && _mode switch
    {
        VideoMode.Template => _selected.Count > 0,
        VideoMode.ImageToVideo => _selected.Count == 1,
        _ => true,
    };

    private string ModeHint => _mode switch
    {
        VideoMode.Template => "選んだ画像にテロップとナレーションを付けて動画にします。早く、安く作れます。",
        VideoMode.ImageToVideo => "1枚の画像を起点に、生成AIが動きをつけます（数分〜10分）。実在の人物は生成しません。",
        _ => "文章から生成AIが動画をつくります（数分〜10分）。実在の人物・他社のキャラクターやロゴは出しません。",
    };

    protected override async Task OnInitializedAsync()
    {
        _theme ??= DefaultTheme;
        _images = (await Media.ListAsync(MediaFilter.All, CancellationToken.None)).Where(m => m.Kind == MediaKind.Image).ToList();
    }

    private void Toggle(Guid id)
    {
        var max = _mode == VideoMode.ImageToVideo ? 1 : VideoJobRequest.MaxImages;
        if (!_selected.Remove(id) && _selected.Count < max) _selected.Add(id);
    }

    private async Task CreateAsync()
    {
        // 動画は時間とクレジットがかかるため、実行前に確認する（F-05 業務ルール）
        var ok = await Dialogs.ShowMessageBoxAsync("動画をつくりますか？",
            $"約{Estimate}クレジットを使います。完成まで{(_mode == VideoMode.Template ? "1分ほど" : "数分〜10分ほど")}かかります（その間もほかの作業を続けられます）。失敗した場合はクレジットを消費しません。",
            yesText: "つくる", cancelText: "やめる");
        if (ok != true) return;
        try
        {
            var job = await Videos.EnqueueAsync(Request, CancellationToken.None);
            _jobId = job.Id;
            await State.RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private async Task FinishedAsync(AiJob job)
    {
        _jobId = null;
        await State.RefreshAsync();
        if (job.Status == AiJobStatus.Succeeded && job.ResultAssetIds.FirstOrDefault() is var id && id != Guid.Empty)
        {
            Snackbar.Add("動画ができました", Severity.Success);
            await OnCreated.InvokeAsync(id);
        }
        else if (job.Status == AiJobStatus.Failed)
        {
            Snackbar.Add(job.Error ?? "動画をつくれませんでした", Severity.Error);
        }
    }
}
