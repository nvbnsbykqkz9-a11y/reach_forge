@inherits RfComponentBase
@* ショート動画（F-05）：③ テンプレート合成（画像＋テロップ＋ナレーション＋BGM）、① テキスト→動画・② 画像→動画（生成 AI）、
   LP から作る集客動画（AI が LP を読み、訴求の整理・絵コンテ・ナレーションをつくる）。実行前に推定クレジットと所要時間を確認する *@
@inject AppState State
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<MudPaper Class="pa-4 rf-ai-surface" Elevation="0">
    <span class="rf-ai-badge"><MudIcon Icon="@Icons.Material.Rounded.Movie" Size="Size.Small" aria-hidden="true" />ショート動画をつくる</span>
    <MudText Typo="Typo.body2" Class="mt-1">縦型（9:16）の動画をつくります。Reels・TikTok・Shorts向けです。</MudText>
    <MudToggleGroup T="VideoMode" @bind-Value="_mode" Color="Color.Secondary" Class="mt-2" SelectionMode="SelectionMode.SingleSelection" aria-label="作り方">
        <MudToggleItem Value="VideoMode.LandingPage">LPから作る（AI）</MudToggleItem>
        <MudToggleItem Value="VideoMode.Template">画像＋テロップ</MudToggleItem>
        <MudToggleItem Value="VideoMode.ImageToVideo">画像に動きをつける（AI）</MudToggleItem>
        <MudToggleItem Value="VideoMode.TextToVideo">文章から動画（AI）</MudToggleItem>
    </MudToggleGroup>
    <MudText Typo="Typo.caption" Class="d-block mt-1">@ModeHint</MudText>
    @if (_mode == VideoMode.LandingPage)
    {
        <div class="d-flex align-start gap-2 mt-2 flex-wrap">
            <MudTextField T="string" @bind-Value="_lpUrl" Label="LP の URL（必須）" Variant="Variant.Outlined" Immediate="true" InputType="InputType.Url"
                          Placeholder="https://example.com/lp" Style="min-width:280px;flex:1" OnKeyUp="LpKeyUp" />
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="LoadLandingPageAsync" Class="mt-1"
                       Disabled="@(_lpLoading || string.IsNullOrWhiteSpace(_lpUrl))">@(_lpLoading ? "読み込み中…" : "LP を読み込む")</MudButton>
        </div>
        @if (_lpPage is { } lp)
        {
            <MudPaper Outlined="true" Class="pa-3 mt-2" Elevation="0">
                <MudText Typo="Typo.subtitle2">@(string.IsNullOrWhiteSpace(lp.Title) ? lp.Url.Host : lp.Title)</MudText>
                @if (!string.IsNullOrWhiteSpace(lp.Description))
                {
                    <MudText Typo="Typo.caption" Class="d-block">@lp.Description</MudText>
                }
                <MudText Typo="Typo.subtitle2" Class="mt-3">動画に使う LP の画像（@_lpSelected.Count／@VideoJobRequest.MaxSourceImages 枚・選んだ順に使います）</MudText>
                @if (lp.ImageList.Count == 0)
                {
                    <MudText Typo="Typo.caption" Class="d-block">画像が見つかりませんでした。ブランドカラーの背景にテロップを入れて作ります。</MudText>
                }
                else
                {
                    <div class="rf-media-grid mt-1" role="group" aria-label="動画に使う LP の画像を選ぶ">
                        @foreach (var img in lp.ImageList)
                        {
                            var url = img.Url.ToString();
                            var index = _lpSelected.IndexOf(url);
                            <button type="button" class="rf-media-pick @(index >= 0 ? "rf-media-pick-on" : "")" aria-pressed="@(index >= 0 ? "true" : "false")"
                                    @onclick="() => ToggleLp(url)" aria-label="@(img.Alt ?? System.IO.Path.GetFileName(img.Url.AbsolutePath))">
                                <img src="@url" alt="@img.Alt" loading="lazy" referrerpolicy="no-referrer" style="width:100%;height:100%;object-fit:cover" />
                                @if (index >= 0) { <span class="rf-media-order">@(index + 1)</span> }
                            </button>
                        }
                    </div>
                    <MudCheckBox T="bool" @bind-Value="_rights" Class="mt-2" Dense="true"
                                 Label="選んだ画像は自社の LP の画像で、SNS の動画に使う権利があります（他社・個人の写真を含めない）" />
                }
            </MudPaper>
        }
        <MudTextField T="string" @bind-Value="_theme" Label="伝えたいこと（任意）" Variant="Variant.Outlined" Class="mt-2" MaxLength="300" Immediate="true"
                      Placeholder="例：初回限定の特典を中心に、20代の女性向けに" />
    }
    else
    {
    <MudTextField T="string" @bind-Value="_theme" Label="@(_mode == VideoMode.Template ? "テーマ（必須）" : "どんな動画にしますか（必須）")" Variant="Variant.Outlined"
                  Class="mt-2" MaxLength="300" Immediate="true"
                  Placeholder="@(_mode == VideoMode.Template ? "例：秋限定さつまいもラテの発売" : "例：湯気の立つラテにミルクを注ぐ、やわらかい朝の光")" />
    }
    @if (_mode is VideoMode.Template or VideoMode.ImageToVideo)
    {
    <MudText Typo="Typo.subtitle2" Class="mt-3">@(_mode == VideoMode.ImageToVideo ? $"動きをつける画像（{_selected.Count}／1 枚）" : $"使う画像（{_selected.Count}／{VideoJobRequest.MaxImages} 枚・選んだ順に使います）")</MudText>
    <div class="rf-media-grid mt-1" role="group" aria-label="動画に使う画像を選ぶ">
        @foreach (var m in _images.Take(24))
        {
            var index = _selected.IndexOf(m.Id);
            <button type="button" class="rf-media-pick @(index >= 0 ? "rf-media-pick-on" : "")" aria-pressed="@(index >= 0 ? "true" : "false")"
                    @onclick="() => Toggle(m.Id)" aria-label="@(m.AltText ?? m.FileName)">
                <RfMediaImage AssetId="m.Id" Alt="@m.AltText" ShowAiBadge="m.IsAiLabeled" />
                @if (index >= 0) { <span class="rf-media-order">@(index + 1)</span> }
            </button>
        }
    </div>
    }
    <div class="d-flex flex-wrap align-center gap-4 mt-3">
        @if (_mode is VideoMode.Template or VideoMode.LandingPage)
        {
            <MudSwitch T="bool" @bind-Value="_narration" Color="Color.Secondary" Label="AIのナレーションを入れる" />
            @if (_mode == VideoMode.LandingPage)
            {
                <MudSwitch T="bool" @bind-Value="_animateHook" Color="Color.Secondary" Disabled="@(_lpSelected.Count == 0)"
                           Label="@($"冒頭のシーンを AI で動かす（+{ReachForge.Domain.Credits.CreditTable.Cost(ReachForge.Domain.Enums.CreditOperation.ShortVideo)}クレジット・数分）")" />
            }
            <div style="min-width:220px">
                <MudText Typo="Typo.caption">長さの目安：@_seconds 秒</MudText>
                <MudSlider T="int" @bind-Value="_seconds" Min="VideoJobRequest.MinSeconds" Max="VideoJobRequest.MaxSeconds" Step="5" aria-label="動画の長さ（秒）" />
            </div>
        }
        else
        {
            <div style="min-width:220px">
                <MudText Typo="Typo.caption">長さ：@_aiSeconds 秒</MudText>
                <MudSlider T="int" @bind-Value="_aiSeconds" Min="VideoGenerationSpec.MinSeconds" Max="VideoGenerationSpec.MaxSeconds" Step="4" aria-label="動画の長さ（秒）" />
            </div>
        }
        <MudSelect T="string" @bind-Value="_bgm" Label="BGM" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:220px">
            <MudSelectItem T="string" Value="@("")">なし</MudSelectItem>
            @foreach (var t in Videos.BgmTracks)
            {
                <MudSelectItem T="string" Value="@t.Id">@t.Title</MudSelectItem>
            }
        </MudSelect>
    </div>
    @if (Videos.BgmTracks.FirstOrDefault(t => t.Id == _bgm) is { } track)
    {
        <MudText Typo="Typo.caption" Class="d-block">BGM の利用条件：@track.License（ナレーションの間は自動で音量を下げます）</MudText>
    }
    @if (_lpSummary is { } summary)
    {
        <MudPaper Outlined="true" Class="pa-3 mt-3" Elevation="0">
            <MudText Typo="Typo.subtitle2">AI が整理した訴求</MudText>
            <MudText Typo="Typo.body2" Class="mt-1">商品：@summary.Product　／　お客様：@summary.Target</MudText>
            @if (summary.Benefits.Count > 0) { <MudText Typo="Typo.body2">良さ：@string.Join("・", summary.Benefits)</MudText> }
            @if (!string.IsNullOrWhiteSpace(summary.Offer)) { <MudText Typo="Typo.body2">特典：@summary.Offer</MudText> }
            <MudTextField T="string" Value="@($"{summary.PostText}\n\n{string.Join(" ", summary.Hashtags.Select(h => "#" + h))}")" ReadOnly="true"
                          Label="投稿文の案（コピーして投稿に使えます）" Variant="Variant.Outlined" Lines="4" Class="mt-2" />
            @if (!summary.HookAnimated && _requestedHook)
            {
                <MudText Typo="Typo.caption" Class="d-block mt-1">冒頭を AI で動かせなかったため、静止画で作りました（その分のクレジットは使っていません）。</MudText>
            }
        </MudPaper>
    }
    @if (_jobId is { } jobId)
    {
        <div class="mt-3"><RfJobProgress JobId="jobId" Title="動画を作成中" EstimatedSeconds="@((int)EstimatedTime.TotalSeconds)" OnFinished="FinishedAsync" /></div>
    }
    else
    {
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="mt-3" OnClick="CreateAsync"
                   Disabled="@(!CanCreate)">動画をつくる（約@(Estimate)クレジット）</MudButton>
    }
</MudPaper>

@code {
    private MediaService Media => Scoped<MediaService>();
    private VideoService Videos => Scoped<VideoService>();

    [Parameter] public string? DefaultTheme { get; set; }

    /// <summary>最初に選んでおく作り方。</summary>
    [Parameter] public VideoMode InitialMode { get; set; } = VideoMode.Template;
    [Parameter] public EventCallback<Guid> OnCreated { get; set; }

    private IReadOnlyList<MediaAsset> _images = [];
    private readonly List<Guid> _selected = [];
    private string? _theme;
    private bool _narration = true;
    private int _seconds = 20;
    private int _aiSeconds = 8;
    private VideoMode _mode = VideoMode.Template;
    private string _bgm = "";
    private Guid? _jobId;
    private string? _lpUrl;
    private WebPage? _lpPage;
    private bool _lpLoading;
    private readonly List<string> _lpSelected = [];
    private bool _rights;
    private bool _animateHook;
    private bool _requestedHook;
    private LandingPageVideoSummary? _lpSummary;

    private VideoJobRequest Request => _mode switch
    {
        VideoMode.Template => new VideoJobRequest(_theme ?? "", _selected.ToList(), _narration, _seconds, _mode, _bgm.Length > 0 ? _bgm : null),
        VideoMode.LandingPage => new VideoJobRequest(_theme ?? "", [], _narration, _seconds, _mode, _bgm.Length > 0 ? _bgm : null,
            _lpPage?.Url.ToString() ?? _lpUrl, _lpSelected.ToList(), _animateHook && _lpSelected.Count > 0, _rights),
        _ => new VideoJobRequest(_theme ?? "", _mode == VideoMode.ImageToVideo ? _selected.Take(1).ToList() : [], false, _aiSeconds, _mode,
            _bgm.Length > 0 ? _bgm : null),
    };

    private int Estimate => VideoService.EstimateCredits(Request);

    private TimeSpan EstimatedTime => _mode == VideoMode.Template || (_mode == VideoMode.LandingPage && !Request.AnimateHook)
        ? VideoService.EstimatedDuration
        : VideoService.EstimatedGenerativeDuration;

    private bool CanCreate => _mode == VideoMode.LandingPage
        ? _lpPage is not null && (_lpSelected.Count == 0 || _rights)
        : !string.IsNullOrWhiteSpace(_theme) && _mode switch
    {
        VideoMode.Template => _selected.Count > 0,
        VideoMode.ImageToVideo => _selected.Count == 1,
        _ => true,
    };

    private string ModeHint => _mode switch
    {
        VideoMode.LandingPage => "LP の内容を AI が読み取り、訴求（誰に・何が良いか・特典）を整理して、冒頭のフックから行動を促す締めまでの絵コンテ・テロップ・ナレーションをつくります。価格などの数値は LP に書かれているものだけを使います。",
        VideoMode.Template => "選んだ画像にテロップとナレーションを付けて動画にします。早く、安く作れます。",
        VideoMode.ImageToVideo => "1枚の画像を起点に、生成AIが動きをつけます（数分〜10分）。実在の人物は生成しません。",
        _ => "文章から生成AIが動画をつくります（数分〜10分）。実在の人物・他社のキャラクターやロゴは出しません。",
    };

    protected override async Task OnInitializedAsync()
    {
        _theme ??= DefaultTheme;
        _mode = InitialMode;
        _images = (await Media.ListAsync(MediaFilter.All, CancellationToken.None)).Where(m => m.Kind == MediaKind.Image).ToList();
    }

    private void Toggle(Guid id)
    {
        var max = _mode == VideoMode.ImageToVideo ? 1 : VideoJobRequest.MaxImages;
        if (!_selected.Remove(id) && _selected.Count < max) _selected.Add(id);
    }

    private void ToggleLp(string url)
    {
        if (!_lpSelected.Remove(url) && _lpSelected.Count < VideoJobRequest.MaxSourceImages) _lpSelected.Add(url);
        if (_lpSelected.Count == 0) _animateHook = false;
    }

    private async Task LpKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadLandingPageAsync();
    }

    /// <summary>LP を読み込み、画像の候補を出す（SNS 共有用の画像を先頭に、最初の4枚を選んだ状態にする）。</summary>
    private async Task LoadLandingPageAsync()
    {
        if (string.IsNullOrWhiteSpace(_lpUrl) || _lpLoading) return;
        _lpLoading = true;
        try
        {
            _lpPage = await Videos.PreviewLandingPageAsync(_lpUrl, CancellationToken.None);
            _lpSelected.Clear();
            _lpSelected.AddRange(_lpPage.ImageList.Take(4).Select(i => i.Url.ToString()));
            _rights = false;
            _lpSummary = null;
        }
        catch (Exception ex)
        {
            _lpPage = null;
            Snackbar.Show(ex);
        }
        finally
        {
            _lpLoading = false;
        }
    }

    private async Task CreateAsync()
    {
        // 動画は時間とクレジットがかかるため、実行前に確認する（F-05 業務ルール）
        var ok = await Dialogs.ShowMessageBoxAsync("動画をつくりますか？",
            $"約{Estimate}クレジットを使います。完成まで{(EstimatedTime == VideoService.EstimatedDuration ? "1分ほど" : "数分〜10分ほど")}かかります（その間もほかの作業を続けられます）。失敗した場合はクレジットを消費しません。",
            yesText: "つくる", cancelText: "やめる");
        if (ok != true) return;
        try
        {
            var job = await Videos.EnqueueAsync(Request, CancellationToken.None);
            _jobId = job.Id;
            _requestedHook = Request.AnimateHook;
            _lpSummary = null;
            await State.RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private async Task FinishedAsync(AiJob job)
    {
        _jobId = null;
        await State.RefreshAsync();
        if (job.Status == AiJobStatus.Succeeded && job.ResultAssetIds.FirstOrDefault() is var id && id != Guid.Empty)
        {
            Snackbar.Add("動画ができました", Severity.Success);
            _lpSummary = VideoService.LandingPageSummaryOf(await Media.GetAsync(id, CancellationToken.None));
            await OnCreated.InvokeAsync(id);
        }
        else if (job.Status == AiJobStatus.Failed)
        {
            Snackbar.Add(job.Error ?? "動画をつくれませんでした", Severity.Error);
        }
    }
}
