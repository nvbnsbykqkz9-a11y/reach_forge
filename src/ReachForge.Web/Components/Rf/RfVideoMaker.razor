@inherits RfComponentBase
@* ショート動画（F-05 ③ テンプレート合成）：画像＋テロップ＋ナレーション。実行前に推定クレジットと所要時間を確認する *@
@inject AppState State
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<MudPaper Class="pa-4 rf-ai-surface" Elevation="0">
    <span class="rf-ai-badge"><MudIcon Icon="@Icons.Material.Rounded.Movie" Size="Size.Small" aria-hidden="true" />ショート動画をつくる</span>
    <MudText Typo="Typo.body2" Class="mt-1">選んだ画像にテロップとナレーションを付けて、縦型（9:16）の動画にします。Reels・TikTok・Shorts向けです。</MudText>
    <MudTextField T="string" @bind-Value="_theme" Label="テーマ（必須）" Variant="Variant.Outlined" Class="mt-2" MaxLength="300" Immediate="true"
                  Placeholder="例：秋限定さつまいもラテの発売" />
    <MudText Typo="Typo.subtitle2" Class="mt-3">使う画像（@_selected.Count／@VideoJobRequest.MaxImages 枚・選んだ順に使います）</MudText>
    <div class="rf-media-grid mt-1" role="group" aria-label="動画に使う画像を選ぶ">
        @foreach (var m in _images.Take(24))
        {
            var index = _selected.IndexOf(m.Id);
            <button type="button" class="rf-media-pick @(index >= 0 ? "rf-media-pick-on" : "")" aria-pressed="@(index >= 0 ? "true" : "false")"
                    @onclick="() => Toggle(m.Id)" aria-label="@(m.AltText ?? m.FileName)">
                <RfMediaImage AssetId="m.Id" Alt="@m.AltText" ShowAiBadge="m.IsAiLabeled" />
                @if (index >= 0) { <span class="rf-media-order">@(index + 1)</span> }
            </button>
        }
    </div>
    <div class="d-flex flex-wrap align-center gap-4 mt-3">
        <MudSwitch T="bool" @bind-Value="_narration" Color="Color.Secondary" Label="AIのナレーションを入れる" />
        <div style="min-width:220px">
            <MudText Typo="Typo.caption">長さの目安：@_seconds 秒</MudText>
            <MudSlider T="int" @bind-Value="_seconds" Min="VideoJobRequest.MinSeconds" Max="VideoJobRequest.MaxSeconds" Step="5" aria-label="動画の長さ（秒）" />
        </div>
    </div>
    @if (_jobId is { } jobId)
    {
        <div class="mt-3"><RfJobProgress JobId="jobId" Title="動画を作成中" EstimatedSeconds="60" OnFinished="FinishedAsync" /></div>
    }
    else
    {
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="mt-3" OnClick="CreateAsync"
                   Disabled="@(string.IsNullOrWhiteSpace(_theme) || _selected.Count == 0)">動画をつくる（約@(Estimate)クレジット）</MudButton>
    }
</MudPaper>

@code {
    private MediaService Media => Scoped<MediaService>();
    private VideoService Videos => Scoped<VideoService>();

    [Parameter] public string? DefaultTheme { get; set; }
    [Parameter] public EventCallback<Guid> OnCreated { get; set; }

    private IReadOnlyList<MediaAsset> _images = [];
    private readonly List<Guid> _selected = [];
    private string? _theme;
    private bool _narration = true;
    private int _seconds = 20;
    private Guid? _jobId;

    private int Estimate => VideoService.EstimateCredits(new VideoJobRequest(_theme ?? "", _selected, _narration, _seconds));

    protected override async Task OnInitializedAsync()
    {
        _theme ??= DefaultTheme;
        _images = (await Media.ListAsync(MediaFilter.All, CancellationToken.None)).Where(m => m.Kind == MediaKind.Image).ToList();
    }

    private void Toggle(Guid id)
    {
        if (!_selected.Remove(id) && _selected.Count < VideoJobRequest.MaxImages) _selected.Add(id);
    }

    private async Task CreateAsync()
    {
        // 動画は時間とクレジットがかかるため、実行前に確認する（F-05 業務ルール）
        var ok = await Dialogs.ShowMessageBoxAsync("動画をつくりますか？",
            $"約{Estimate}クレジットを使います。完成まで1分ほどかかります（その間もほかの作業を続けられます）。失敗した場合はクレジットを消費しません。",
            yesText: "つくる", cancelText: "やめる");
        if (ok != true) return;
        try
        {
            var job = await Videos.EnqueueAsync(new VideoJobRequest(_theme!, _selected.ToList(), _narration, _seconds), CancellationToken.None);
            _jobId = job.Id;
            await State.RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private async Task FinishedAsync(AiJob job)
    {
        _jobId = null;
        await State.RefreshAsync();
        if (job.Status == AiJobStatus.Succeeded && job.ResultAssetIds.FirstOrDefault() is var id && id != Guid.Empty)
        {
            Snackbar.Add("動画ができました", Severity.Success);
            await OnCreated.InvokeAsync(id);
        }
        else if (job.Status == AiJobStatus.Failed)
        {
            Snackbar.Add(job.Error ?? "動画をつくれませんでした", Severity.Error);
        }
    }
}
