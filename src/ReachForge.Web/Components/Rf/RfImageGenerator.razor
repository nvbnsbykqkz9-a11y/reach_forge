@* AI 画像生成パネル（F-04）。実行前に推定クレジットを表示し、生成はジョブとして非同期に進める *@
@inject MediaService Media
@inject AppState State
@inject ISnackbar Snackbar

<MudPaper Class="pa-3" Elevation="0" Outlined="true">
    <MudTextField @bind-Value="_prompt" Label="どんな画像にしますか？" Variant="Variant.Outlined" Lines="2" Sizing="InputSizing.Auto"
                  Immediate="true" Placeholder="例：木のテーブルに置かれた、湯気の立つさつまいもラテ" />
    <div class="d-flex flex-wrap gap-2 mt-2 align-center">
        <MudSelect T="ImageStyle" @bind-Value="_style" Label="スタイル" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:160px">
            @foreach (var s in Enum.GetValues<ImageStyle>())
            {
                <MudSelectItem T="ImageStyle" Value="s">@s.ToLabel()</MudSelectItem>
            }
        </MudSelect>
        <MudNumericField T="int" @bind-Value="_count" Label="枚数" Min="1" Max="4" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:90px" />
        <MudCheckBox T="bool" @bind-Value="_logo" Label="ロゴを入れる" Dense="true" />
    </div>
    <MudText Typo="Typo.caption" Class="d-block mb-2" Style="color:var(--rf-color-text-secondary)">
        実在の人物・他社のキャラクターやロゴは描きません。文字入りの画像は今後対応します。
    </MudText>
    @if (_jobId is { } id)
    {
        <RfJobProgress JobId="id" Title="@($"画像を{_count}枚作成中")" EstimatedSeconds="@(25 * _count)" OnFinished="FinishedAsync" />
    }
    else
    {
        <RfAiButton Text="@($"AIで画像をつくる（約{5 * _count}クレジット）")" EstimatedCredits="5 * _count"
                    DisabledReason="@(string.IsNullOrWhiteSpace(_prompt) ? "どんな画像にするかを入力してください" : null)" OnClick="StartAsync" />
    }
</MudPaper>

@code {
    [Parameter] public string? DefaultPrompt { get; set; }
    [Parameter] public SocialPlatform AspectFor { get; set; } = SocialPlatform.Instagram;
    [Parameter] public EventCallback<IReadOnlyList<Guid>> OnGenerated { get; set; }

    private string _prompt = "";
    private ImageStyle _style = ImageStyle.Photo;
    private int _count = 1;
    private bool _logo;
    private Guid? _jobId;

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(_prompt) && !string.IsNullOrWhiteSpace(DefaultPrompt)) _prompt = DefaultPrompt;
    }

    private async Task StartAsync()
    {
        try
        {
            var job = await Media.EnqueueGenerationAsync(new ImageJobRequest
            {
                Prompt = _prompt, Style = _style, Count = _count, AspectFor = AspectFor, OverlayLogo = _logo,
            }, CancellationToken.None);
            _jobId = job.Id;
            await State.RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private async Task FinishedAsync(AiJob job)
    {
        _jobId = null;
        await State.RefreshAsync();
        if (job.Status == AiJobStatus.Succeeded)
        {
            Snackbar.Add($"画像を{job.ResultAssetIds.Count}枚作りました（{job.CreditsCharged}クレジット）", Severity.Success);
            await OnGenerated.InvokeAsync(job.ResultAssetIds);
        }
        else if (job.Status == AiJobStatus.Failed)
        {
            Snackbar.Add(job.Error ?? "画像を作成できませんでした。", Severity.Error);
        }
    }
}
