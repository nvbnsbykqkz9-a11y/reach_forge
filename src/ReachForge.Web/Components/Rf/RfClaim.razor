@* AI の主張と、その根拠の数値（システム計算値）。根拠はチップで併記し、色だけに頼らずラベルで示す（RF-UX-001 SCR-10） *@
@using ReachForge.Domain.Analytics

<MudText Typo="Typo.body2" Inline="true">@Claim.Text</MudText>
@foreach (var fact in Claim.FactIds.Select(id => Facts.GetValueOrDefault(id)).OfType<ReportFact>())
{
    <span class="rf-evidence" title="根拠となる数値（システムが計算）">@fact.Label：@fact.Value</span>
}

@code {
    [Parameter, EditorRequired] public ReportClaim Claim { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, ReportFact> Facts { get; set; } = default!;
}
