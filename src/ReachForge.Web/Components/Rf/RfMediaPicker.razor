@* 投稿に使う画像を選ぶ（アップロード・AI 生成・メディアライブラリから）。最大 Max 枚、順序付き *@
@inject MediaService Media
@inject ISnackbar Snackbar

<div>
    <div class="d-flex flex-wrap gap-2 align-center">
        <MudFileUpload T="IBrowserFile" FilesChanged="UploadAsync" Accept=".jpg,.jpeg,.png,.webp" SelectedTemplate="@(_ => __builder => { })">
            <CustomContent>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Upload" Disabled="_uploading"
                           OnClick="@context.OpenFilePickerAsync">
                    @(_uploading ? "アップロード中…" : "写真を選ぶ")
                </MudButton>
            </CustomContent>
        </MudFileUpload>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Rounded.AutoAwesome"
                   OnClick="() => _showGenerator = !_showGenerator">AIで画像をつくる</MudButton>
        <MudText Typo="Typo.caption" Style="color:var(--rf-color-text-secondary)">JPEG・PNG・WebP、20MBまで。選べるのは@(Max)枚まで</MudText>
    </div>

    @if (_showGenerator)
    {
        <div class="mt-2"><RfImageGenerator DefaultPrompt="@DefaultPrompt" OnGenerated="GeneratedAsync" /></div>
    }

    @if (ShowLibrary && _library.Count > 0)
    {
        <div class="rf-media-grid mt-3" role="group" aria-label="画像を選ぶ">
            @foreach (var m in _library.Take(12))
            {
                var index = Selected.IndexOf(m.Id);
                <button type="button" class="rf-media-pick @(index >= 0 ? "rf-media-pick-on" : "")" aria-pressed="@(index >= 0 ? "true" : "false")"
                        @onclick="() => ToggleAsync(m.Id)" aria-label="@(m.AltText ?? m.FileName)">
                    <RfMediaImage AssetId="m.Id" Alt="@m.AltText" ShowAiBadge="m.IsAiLabeled" />
                    @if (index >= 0)
                    {
                        <span class="rf-media-order">@(index + 1)</span>
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<Guid> Selected { get; set; } = [];
    [Parameter] public EventCallback<List<Guid>> SelectedChanged { get; set; }
    [Parameter] public int Max { get; set; } = 4;
    [Parameter] public string? DefaultPrompt { get; set; }
    [Parameter] public bool ShowLibrary { get; set; } = true;

    private IReadOnlyList<MediaAsset> _library = [];
    private bool _uploading, _showGenerator;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _library = await Media.ListAsync(MediaFilter.All, CancellationToken.None);

    private async Task UploadAsync(IBrowserFile? file)
    {
        if (file is null) return;
        _uploading = true;
        try
        {
            await using var stream = file.OpenReadStream(MediaAsset.MaxUploadBytes);
            var asset = await Media.UploadAsync(file.Name, file.ContentType, stream, file.Size, CancellationToken.None);
            await LoadAsync();
            await AddAsync(asset.Id);
        }
        catch (IOException)
        {
            Snackbar.Add("画像は20MBまでです。サイズを小さくしてから選んでください。", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task GeneratedAsync(IReadOnlyList<Guid> ids)
    {
        _showGenerator = false;
        await LoadAsync();
        foreach (var id in ids) await AddAsync(id);
    }

    private async Task ToggleAsync(Guid id)
    {
        if (Selected.Contains(id))
        {
            Selected.Remove(id);
            await SelectedChanged.InvokeAsync(Selected);
        }
        else
        {
            await AddAsync(id);
        }
    }

    private async Task AddAsync(Guid id)
    {
        if (Selected.Contains(id)) return;
        if (Selected.Count >= Max)
        {
            Snackbar.Add($"選べる画像は{Max}枚までです。", Severity.Warning);
            return;
        }
        Selected.Add(id);
        await SelectedChanged.InvokeAsync(Selected);
    }
}
