@* 1つの SNS への投稿を、4つの手順でつくる（伝えたいこと → 画像・動画 → 文章 → 確認して投稿）。
   各手順でやることは1つ。AI は文章・画像・動画づくりを手伝い、最後は利用者が確認してその場で投稿する *@
@inherits RfComponentBase
@inject WebTenantContext Tenant
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject AppState State
@inject ILogger<RfPostWizard> Log

<ol class="rf-steps" aria-label="投稿をつくる手順">
    @foreach (var (label, i) in s_steps.Select((l, i) => (l, i + 1)))
    {
        <li aria-current="@(_step == i ? "step" : null)" class="@(i < _step ? "rf-step-done" : "")">
            <span class="rf-step-num" aria-hidden="true">@(i < _step ? "✓" : i.ToString())</span>@label
        </li>
    }
</ol>

<MudGrid>
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4 rf-card" Elevation="0" Outlined="true">
            @switch (_step)
            {
                case 1:
                    <MudText Typo="Typo.h6">何を伝えますか？</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3">お知らせしたいことを、ひとことで書いてください。AI が @(C.DisplayName) 向けの文章にします。</MudText>
                    <MudTextField T="string" @bind-Value="_theme" Label="伝えたいこと" Variant="Variant.Outlined" Lines="3" MaxLength="500" Immediate="true"
                                  Placeholder="例：秋限定のさつまいもラテを10月1日から販売します" />
                    <MudText Typo="Typo.caption" Class="d-block mt-2">例から始める：</MudText>
                    <div class="d-flex flex-wrap gap-2 mt-1">
                        @foreach (var example in s_examples)
                        {
                            <MudChip T="string" Variant="Variant.Outlined" OnClick="() => _theme = example.Text">@example.Label</MudChip>
                        }
                    </div>
                    <MudTextField T="string" @bind-Value="_link" Label="お店・商品のページの URL（任意）" Variant="Variant.Outlined" Class="mt-4"
                                  InputType="InputType.Url" Placeholder="https://"
                                  HelperText="@(C.LinkPolicy == LinkPolicy.NotAllowed ? $"{C.DisplayName} の投稿にはリンクを入れられませんが、動画づくりに使えます" : "投稿にリンクを入れたり、ページの内容から動画をつくったりできます")" />
                    <div class="d-flex justify-end mt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" EndIcon="@Icons.Material.Rounded.ArrowForward"
                                   Disabled="@string.IsNullOrWhiteSpace(_theme)" OnClick="() => GoTo(2)">次へ：画像・動画</MudButton>
                    </div>
                    break;

                case 2:
                    <MudText Typo="Typo.h6">画像・動画を用意しましょう</MudText>
                    <MudAlert Severity="Severity.Info" Dense="true" Class="my-3">@RfSns.MediaRule(Platform)</MudAlert>
                    <div class="d-flex flex-wrap gap-3">
                        <div style="flex:1;min-width:220px">
                            <button type="button" class="rf-choice" aria-pressed="@(_mediaTab == 1 ? "true" : "false")" @onclick="() => _mediaTab = 1">
                                <MudIcon Icon="@Icons.Material.Rounded.Image" Color="Color.Primary" aria-hidden="true" />
                                <b>写真・画像を使う</b>
                                <span class="mud-typography-body2">手元の写真を選ぶか、AI で画像をつくります</span>
                            </button>
                        </div>
                        <div style="flex:1;min-width:220px">
                            <button type="button" class="rf-choice" aria-pressed="@(_mediaTab == 2 ? "true" : "false")" @onclick="() => _mediaTab = 2">
                                <MudIcon Icon="@Icons.Material.Rounded.Movie" Color="Color.Secondary" aria-hidden="true" />
                                <b>AI で動画をつくる</b>
                                <span class="mud-typography-body2">画像やお店のページから、縦型の動画をつくります</span>
                            </button>
                        </div>
                    </div>
                    @if (_mediaTab == 1)
                    {
                        <div class="mt-4">
                            <RfMediaPicker Selected="_media" SelectedChanged="MediaChangedAsync" Max="Math.Max(1, C.MaxImages)" DefaultPrompt="@_theme" />
                        </div>
                    }
                    else if (_mediaTab == 2)
                    {
                        <div class="mt-4">
                            <RfVideoMaker DefaultTheme="@_theme" DefaultUrl="@_link"
                                          InitialMode="@(string.IsNullOrWhiteSpace(_link) ? VideoMode.Template : VideoMode.LandingPage)" OnCreated="VideoCreatedAsync" />
                        </div>
                    }
                    @if (_assets.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mt-4">使う画像・動画（@_assets.Count）</MudText>
                        <div class="rf-media-grid mt-1">
                            @foreach (var a in _assets)
                            {
                                <div style="position:relative">
                                    <RfMediaImage AssetId="a.Id" Alt="@a.AltText" ShowAiBadge="a.IsAiLabeled" />
                                    @if (a.Kind == MediaKind.Video) { <MudChip T="string" Size="Size.Small" Style="position:absolute;left:4px;bottom:4px">動画</MudChip> }
                                    <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" Variant="Variant.Filled"
                                                   Style="position:absolute;top:4px;right:4px" aria-label="外す" OnClick="() => RemoveAsync(a.Id)" />
                                </div>
                            }
                        </div>
                    }
                    <div class="d-flex justify-space-between mt-4">
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.ArrowBack" OnClick="() => GoTo(1)">戻る</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" EndIcon="@Icons.Material.Rounded.ArrowForward"
                                   Disabled="@(MediaProblem is not null || _busy)" OnClick="LeaveMediaAsync">次へ：文章</MudButton>
                    </div>
                    @if (MediaProblem is { } problem)
                    {
                        <MudText Typo="Typo.caption" Class="d-block mt-1" Style="text-align:right;color:var(--rf-color-text-secondary)">@problem</MudText>
                    }
                    break;

                case 3:
                    <MudText Typo="Typo.h6">文章をつくりましょう</MudText>
                    @if (_variant is null)
                    {
                        @if (!_manual)
                        {
                            <MudText Typo="Typo.body2" Class="mb-3">AI が「@PostText.Truncate(_theme ?? "", 30)」をもとに、@(C.DisplayName) に合った文章を3つ考えます。</MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large" StartIcon="@Icons.Material.Rounded.AutoAwesome"
                                       Disabled="_busy" OnClick="GenerateAsync">
                                @(_busy ? "AI が考えています…" : $"AI に文章を書いてもらう（約{CopyCredits}クレジット）")
                            </MudButton>
                            <MudButton Variant="Variant.Text" Class="ml-2" Disabled="_busy" OnClick="() => _manual = true">自分で書く</MudButton>
                            @if (_busy) { <MudProgressLinear Indeterminate="true" Color="Color.Secondary" Class="mt-3" /> }
                            @if (_copies is { } copies)
                            {
                                <MudText Typo="Typo.subtitle2" Class="mt-4">気に入った案を選んでください（あとで直せます）</MudText>
                                @foreach (var candidate in copies.Candidates)
                                {
                                    <div class="mt-2">
                                        <RfAiCandidateCard Candidate="candidate" Busy="_busy" OnAdopt="() => AdoptAsync(candidate)"
                                                           OnQuickFix="f => RefineAsync(candidate, f)" />
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <MudTextField T="string" @bind-Value="_manualBody" Label="本文" Variant="Variant.Outlined" Lines="8" Immediate="true" />
                            <RfCharCounter Text="@(_manualBody ?? "")" Max="C.MaxBodyLength" />
                            <MudTextField T="string" @bind-Value="_manualTags" Label="ハッシュタグ（スペース区切り・任意）" Variant="Variant.Outlined" Class="mt-2"
                                          Disabled="@(C.MaxHashtags == 0)" />
                            <div class="d-flex gap-2 mt-3">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(string.IsNullOrWhiteSpace(_manualBody) || _busy)" OnClick="UseManualAsync">この文章を使う</MudButton>
                                <MudButton Variant="Variant.Text" OnClick="() => _manual = false">AI に書いてもらう</MudButton>
                            </div>
                        }
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mb-2">@(C.DisplayName) 向けに整えました。自由に直してください。</MudText>
                        @if (C.MaxTitleLength is { } maxTitle)
                        {
                            <MudTextField T="string" @bind-Value="_title" Label="タイトル" Variant="Variant.Outlined" Immediate="true" />
                            <RfCharCounter Text="@(_title ?? "")" Max="maxTitle" />
                        }
                        <MudTextField T="string" @bind-Value="_body" Label="本文" Variant="Variant.Outlined" Lines="8" Immediate="true" Class="mt-2" />
                        <RfCharCounter Text="@PostText.Compose(_body ?? "", Tags)" Max="C.MaxBodyLength" />
                        <MudTextField T="string" @bind-Value="_tags" Label="ハッシュタグ（スペース区切り）" Variant="Variant.Outlined" Immediate="true" Class="mt-2"
                                      Disabled="@(C.MaxHashtags == 0)" HelperText="@(C.MaxHashtags == 0 ? $"{C.DisplayName} ではハッシュタグを使いません" : null)" />
                        @if (_variant.GuardrailFindings.Count > 0)
                        {
                            <MudText Typo="Typo.subtitle2" Class="mt-3">AI のチェック結果</MudText>
                            <RfGuardrailPanel Findings="_variant.GuardrailFindings" OnApply="ApplyFindingAsync" />
                        }
                        <MudButton Variant="Variant.Text" Class="mt-2" StartIcon="@Icons.Material.Rounded.Refresh" OnClick="ResetText">別の文章にする</MudButton>
                    }
                    <div class="d-flex justify-space-between mt-4">
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.ArrowBack" OnClick="() => GoTo(2)">戻る</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" EndIcon="@Icons.Material.Rounded.ArrowForward"
                                   Disabled="@(_variant is null || _busy || string.IsNullOrWhiteSpace(_body))" OnClick="SaveTextAsync">次へ：確認して投稿</MudButton>
                    </div>
                    break;

                case 4:
                    <MudText Typo="Typo.h6">確認して投稿しましょう</MudText>
                    @if (_result is { Status: VariantStatus.Published } done)
                    {
                        <MudAlert Severity="Severity.Success" Class="my-3">@(C.DisplayName) に投稿しました。</MudAlert>
                        <div class="d-flex flex-wrap gap-2">
                            @if (done.Url is { } url)
                            {
                                <MudButton Href="@url" Target="_blank" Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.OpenInNew">投稿を見る</MudButton>
                            }
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="StartOver">もう1件つくる</MudButton>
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.body1" Class="mt-2">右の見た目で、<b>@(_channel?.DisplayName ?? C.DisplayName)</b> に今すぐ投稿します。</MudText>
                        <ul class="mt-2" style="padding-left:1.2em">
                            <li>画像・動画：@(_assets.Count == 0 ? "なし" : $"{_assets.Count}点")</li>
                            <li>文字数：@PostText.Length(PostText.Compose(_body ?? "", Tags))／@C.MaxBodyLength.ToString("N0")</li>
                        </ul>
                        @if (Platform == SocialPlatform.TikTok)
                        {
                            <MudSelect T="string" Label="公開範囲" Variant="Variant.Outlined" Class="mt-2" Style="max-width:260px"
                                       Value="@(_variant!.PlatformOptions.GetValueOrDefault(PlatformOptionKeys.TikTokPrivacy) ?? "PUBLIC_TO_EVERYONE")"
                                       ValueChanged="@((string v) => SetOptionAsync(PlatformOptionKeys.TikTokPrivacy, v))">
                                @foreach (var (value, label) in PlatformOptionKeys.TikTokPrivacyChoices) { <MudSelectItem T="string" Value="@value">@label</MudSelectItem> }
                            </MudSelect>
                        }
                        else if (Platform == SocialPlatform.YouTube)
                        {
                            <MudSelect T="string" Label="公開設定" Variant="Variant.Outlined" Class="mt-2" Style="max-width:260px"
                                       Value="@(_variant!.PlatformOptions.GetValueOrDefault(PlatformOptionKeys.YouTubePrivacy) ?? "public")"
                                       ValueChanged="@((string v) => SetOptionAsync(PlatformOptionKeys.YouTubePrivacy, v))">
                                @foreach (var (value, label) in PlatformOptionKeys.YouTubePrivacyChoices) { <MudSelectItem T="string" Value="@value">@label</MudSelectItem> }
                            </MudSelect>
                        }
                        @if (C.LinkPolicy == LinkPolicy.DiscouragedByCost && PostText.ContainsUrl(_body ?? ""))
                        {
                            <MudCheckBox T="bool" @bind-Value="_urlAck" Class="mt-2"
                                         Label="@($"URL 付きの投稿は X の費用が高くなること（1件あたり約 ${C.CostPerPostWithUrlUsd:0.00}）を確認しました")" />
                        }
                        @if (_result is { Status: VariantStatus.Scheduled } retry)
                        {
                            <MudAlert Severity="Severity.Warning" Class="mt-3">@(C.DisplayName) が混み合っているため、少し待ってから自動でもう一度投稿します。@retry.LastError</MudAlert>
                        }
                        else if (_result is { Status: VariantStatus.Failed } failed)
                        {
                            <MudAlert Severity="Severity.Error" Class="mt-3">投稿できませんでした：@failed.LastError</MudAlert>
                        }
                        <div class="d-flex justify-space-between mt-4">
                            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.ArrowBack" Disabled="_busy" OnClick="() => GoTo(3)">戻る</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Rounded.Send"
                                       Disabled="@(_busy || _result is { Status: VariantStatus.Scheduled })" OnClick="PublishAsync">
                                @(_busy ? "投稿しています…" : $"今すぐ {C.DisplayName} に投稿する")
                            </MudButton>
                        </div>
                        @if (_busy) { <MudProgressLinear Indeterminate="true" Class="mt-3" /> <MudText Typo="Typo.caption">動画は数分かかることがあります。画面を閉じずにお待ちください。</MudText> }
                    }
                    break;
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="5">
        <div style="position:sticky;top:80px">
            <MudText Typo="Typo.subtitle2" Class="mb-2">@(C.DisplayName) での見え方</MudText>
            <RfPlatformPreview Platform="Platform" Body="@PreviewBody" Hashtags="PreviewTags" Title="@_title"
                               AccountName="@(_channel?.DisplayName ?? "@shop")"
                               ImageAssetId="@(_variant?.MediaAssetIds.FirstOrDefault() is { } vm && vm != Guid.Empty ? vm : _assets.FirstOrDefault()?.Id)"
                               ImageIsAi="@(_assets.FirstOrDefault()?.IsAiLabeled ?? false)" ImageCount="@(_variant?.MediaAssetIds.Count ?? _assets.Count)" />
        </div>
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired] public SocialPlatform Platform { get; set; }
    [Parameter, EditorRequired] public Channel? Channel { get; set; }

    private static readonly string[] s_steps = ["伝えたいこと", "画像・動画", "文章", "確認して投稿"];
    private static readonly (string Label, string Text)[] s_examples =
    [
        ("新商品のお知らせ", "新商品「」を発売します。おすすめのポイントは"),
        ("セール・キャンペーン", "期間限定のキャンペーンを行います。期間は"),
        ("イベントの告知", "イベントを開催します。日時は"),
        ("お店の紹介", "私たちのお店のこだわりを紹介します。"),
    ];

    private StudioService Studio => Scoped<StudioService>();
    private PublishingService Publishing => Scoped<PublishingService>();
    private MediaService Media => Scoped<MediaService>();

    private PlatformConstraint C => PlatformCatalog.Get(Platform);
    private Channel? _channel => Channel;
    private static int CopyCredits => ReachForge.Domain.Credits.CreditTable.Cost(CreditOperation.CopyGeneration)
                                      + ReachForge.Domain.Credits.CreditTable.Cost(CreditOperation.VariantConversion);

    private int _step = 1;
    private string? _theme, _link;
    private int _mediaTab = 1;
    private List<Guid> _media = [];
    private List<MediaAsset> _assets = [];
    private bool _mediaChanged;
    private CopyResult? _copies;
    private bool _manual;
    private string? _manualBody, _manualTags;
    private MasterPost? _master;
    private PostVariant? _variant;
    private string? _title, _body, _tags;
    private bool _urlAck;
    private PostVariant? _result;
    private bool _busy;

    private IReadOnlyList<string> Tags => (_tags ?? "").Split([' ', '　', ','], StringSplitOptions.RemoveEmptyEntries).Select(PostText.Normalize)
        .Where(t => t.Length > 0).ToList();

    private string PreviewBody => _variant is not null ? _body ?? "" : _manual ? _manualBody ?? "" : _copies?.Candidates.FirstOrDefault()?.Body ?? _theme ?? "";
    private IReadOnlyList<string> PreviewTags => _variant is not null ? Tags : _copies?.Candidates.FirstOrDefault()?.Hashtags ?? [];

    /// <summary>画像・動画の条件を満たしていなければ理由（次へ進めない）。</summary>
    private string? MediaProblem =>
        C.VideoOnly && _assets.All(a => a.Kind != MediaKind.Video) ? $"{C.DisplayName} には動画が必要です"
        : RfSns.NeedsMedia(Platform) && _assets.Count == 0 ? $"{C.DisplayName} には画像か動画が必要です"
        : null;

    private void GoTo(int step) => _step = step;

    private async Task MediaChangedAsync(List<Guid> ids)
    {
        _media = ids;
        _mediaChanged = true;
        await LoadAssetsAsync();
    }

    private async Task VideoCreatedAsync(Guid id)
    {
        // 動画は1本だけ使う（画像とは混ぜない）
        _media = [id];
        _mediaChanged = true;
        await LoadAssetsAsync();
        Snackbar.Add("動画を使う素材にしました", Severity.Success);
    }

    private async Task RemoveAsync(Guid id)
    {
        _media.Remove(id);
        _mediaChanged = true;
        await LoadAssetsAsync();
    }

    private async Task LoadAssetsAsync()
    {
        var list = new List<MediaAsset>();
        foreach (var id in _media) list.Add(await Media.GetAsync(id, CancellationToken.None));
        _assets = list;
    }

    /// <summary>画像・動画を変えたあとに戻ってきた場合は、つくった文章にも反映する。</summary>
    private async Task LeaveMediaAsync()
    {
        if (_mediaChanged && _master is not null && _variant is not null)
        {
            _busy = true;
            try
            {
                _master = await Studio.SaveMasterPostAsync(MasterCommand(_master.CoreMessage, _master.Title, _master.Cta, _master.Hashtags, _master.AiGenerationId) with { Id = _master.Id },
                    CancellationToken.None);
                await Studio.ChangeAspectMethodAsync(_variant.Id, AspectMethod.SmartCrop, CancellationToken.None);
                _variant = (await Studio.GetVariantsAsync(_master.Id, CancellationToken.None)).First(v => v.Id == _variant.Id);
            }
            catch (Exception ex)
            {
                Snackbar.Show(ex, Log);
                return;
            }
            finally
            {
                _busy = false;
            }
        }
        _mediaChanged = false;
        GoTo(3);
    }

    private SaveMasterPost MasterCommand(string body, string title, string cta, IReadOnlyList<string> hashtags, Guid? generationId) => new()
    {
        Title = title,
        Objective = PostObjective.Awareness,
        Theme = _theme ?? "",
        CoreMessage = body,
        Cta = cta,
        Hashtags = hashtags,
        AiGenerationId = generationId,
        MediaAssetIds = _media.ToList(),
    };

    private async Task GenerateAsync()
    {
        _busy = true;
        try
        {
            var theme = string.IsNullOrWhiteSpace(_link) ? _theme! : $"{_theme}（詳しくは {_link}）";
            _copies = await Studio.GenerateCopiesAsync(new CopyRequest
            {
                WorkspaceId = Tenant.WorkspaceId, Objective = PostObjective.Awareness, Theme = PostText.Truncate(theme, 500), Count = 3,
            }, CancellationToken.None);
            await State.RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex, Log);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RefineAsync(CopyCandidate candidate, QuickFix fix)
    {
        _busy = true;
        try
        {
            var refined = await Studio.RefineCopyAsync(new CopyRequest
            {
                WorkspaceId = Tenant.WorkspaceId, Objective = PostObjective.Awareness, Theme = _theme ?? "", Count = 1,
            }, new GeneratedCopy(candidate.Headline, candidate.Body, candidate.Cta, [.. candidate.Hashtags]), fix, CancellationToken.None);
            if (_copies is not null && refined.Candidates.FirstOrDefault() is { } updated)
            {
                _copies = _copies with { Candidates = _copies.Candidates.Select(c => c == candidate ? updated with { Rank = c.Rank } : c).ToList() };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex, Log);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>選んだ案を、この SNS 向けに AI で整える（文字数・ハッシュタグ・リンクの扱い）。</summary>
    private async Task AdoptAsync(CopyCandidate candidate)
    {
        _busy = true;
        try
        {
            _master = await Studio.SaveMasterPostAsync(MasterCommand(candidate.Body, candidate.Headline, candidate.Cta, candidate.Hashtags, _copies?.GenerationId),
                CancellationToken.None);
            var variants = await Studio.GenerateVariantsAsync(_master.Id, [Channel!.Id],
                new VariantOptions(LinkUrl: string.IsNullOrWhiteSpace(_link) ? null : _link.Trim()), CancellationToken.None);
            UseVariant(variants.Single());
            await State.RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex, Log);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UseManualAsync()
    {
        _busy = true;
        try
        {
            var tags = (_manualTags ?? "").Split([' ', '　', ','], StringSplitOptions.RemoveEmptyEntries).ToList();
            _master = await Studio.SaveMasterPostAsync(MasterCommand(_manualBody!.Trim(), PostText.Truncate(_manualBody!.Trim(), 30), "", tags, null),
                CancellationToken.None);
            UseVariant(await Studio.CreateVariantAsIsAsync(_master.Id, Channel!.Id, CancellationToken.None));
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex, Log);
        }
        finally
        {
            _busy = false;
        }
    }

    private void UseVariant(PostVariant v)
    {
        _variant = v;
        _title = v.Title;
        _body = v.Body;
        _tags = string.Join(" ", v.Hashtags);
        _urlAck = v.UrlCostAcknowledged;
        _mediaChanged = false;
    }

    private void ResetText()
    {
        _variant = null;
        _result = null;
    }

    private async Task ApplyFindingAsync(GuardrailFinding f)
    {
        _body = f.Code == GuardrailCodes.MissingPrDisclosure ? "#PR " + _body : f.Apply(_body ?? "");
        await SaveEditsAsync();
    }

    private async Task<bool> SaveEditsAsync()
    {
        try
        {
            var result = await Studio.UpdateVariantAsync(_variant!.Id, _body ?? "", Tags, _title, _urlAck, CancellationToken.None);
            _variant = result.Variant;
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex, Log);
            return false;
        }
    }

    private async Task SaveTextAsync()
    {
        _busy = true;
        try
        {
            if (!await SaveEditsAsync()) return;
            if (_variant!.HasGuardrailErrors)
            {
                Snackbar.Add("AI のチェックでエラーがあります。「AI のチェック結果」を確認して直してください。", Severity.Warning);
                return;
            }
            _result = null;
            GoTo(4);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetOptionAsync(string key, string value)
    {
        try
        {
            _variant = (await Studio.SetPlatformOptionAsync(_variant!.Id, key, value, CancellationToken.None)).Variant;
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex, Log);
        }
    }

    private async Task PublishAsync()
    {
        var ok = await Dialogs.ShowMessageBoxAsync($"{C.DisplayName} に投稿しますか？",
            $"{_channel?.DisplayName ?? C.DisplayName} に今すぐ投稿します。投稿したあとの削除は {C.DisplayName} のアプリから行ってください。",
            yesText: "投稿する", cancelText: "やめる");
        if (ok != true) return;
        _busy = true;
        try
        {
            if (_urlAck != _variant!.UrlCostAcknowledged && !await SaveEditsAsync()) return;
            _result = await Publishing.PublishNowAsync(_variant.Id, CancellationToken.None);
            _variant = _result;
            if (_result.Status == VariantStatus.Published) Snackbar.Add($"{C.DisplayName} に投稿しました", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex, Log);
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartOver()
    {
        _step = 1;
        _theme = _link = null;
        _media = [];
        _assets = [];
        _copies = null;
        _manual = false;
        _manualBody = _manualTags = null;
        _master = null;
        _variant = null;
        _title = _body = _tags = null;
        _urlAck = false;
        _result = null;
    }
}
