@* AIボタン：クレジット表示・処理中表示・無効理由をまとめて扱う（RF-UX-001 14.3） *@
<MudTooltip Text="@(DisabledReason ?? $"約{EstimatedCredits}クレジットを使います")">
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="@(IsBusy || DisabledReason is not null)"
               OnClick="OnClick" aria-busy="@(IsBusy ? "true" : "false")" aria-describedby="@_hintId"
               StartIcon="@(IsBusy ? null : Icons.Material.Rounded.AutoAwesome)" Size="Size" FullWidth="FullWidth">
        @if (IsBusy)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            @BusyText
        }
        else
        {
            @Text
        }
    </MudButton>
</MudTooltip>
<span id="@_hintId" class="rf-visually-hidden">推定 @EstimatedCredits クレジット</span>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    [Parameter] public string BusyText { get; set; } = "生成中…";
    [Parameter] public int EstimatedCredits { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public string? DisabledReason { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public bool FullWidth { get; set; }

    private readonly string _hintId = $"aihint-{Guid.NewGuid():N}";
}
