@* 各 SNS の実表示に近いプレビュー（RF-UX-001 SCR-06）。ロゴは使わず、配色・レイアウトのみ近づける *@
@{
    var c = PlatformCatalog.Get(Platform);
    var text = PostText.Compose(Body, Hashtags);
}
<div>
    @if (Platform == SocialPlatform.Line)
    {
        <div class="rf-preview rf-preview-line">
            <div class="rf-preview-header"><div class="rf-preview-avatar"></div><span class="rf-preview-name" style="color:#fff">@AccountName</span></div>
            <div class="rf-bubble">@Body</div>
        </div>
    }
    else
    {
        <div class="rf-preview @(Dark ? "rf-preview-dark" : "")">
            <div class="rf-preview-header">
                <div class="rf-preview-avatar" aria-hidden="true"></div>
                <div>
                    <div class="rf-preview-name">@AccountName</div>
                    <div class="rf-preview-sub">@c.DisplayName ・ 今</div>
                </div>
            </div>
            @if (Title is not null)
            {
                <div class="rf-preview-name mb-1">@Title</div>
            }
            @if (Platform is SocialPlatform.Instagram or SocialPlatform.Pinterest or SocialPlatform.TikTok)
            {
                <div class="rf-preview-media" style="aspect-ratio:@c.ImageAspect.Width/@c.ImageAspect.Height;max-height:260px">画像 @c.ImageAspect</div>
            }
            <div class="rf-preview-body">
                @if (c.FoldAt is { } fold && PostText.Length(text) > fold)
                {
                    @Highlight(Take(text, fold))
                    <div class="rf-preview-fold">ここで「続きを読む」になります（冒頭約@(fold)字）</div>
                    @Highlight(Skip(text, fold))
                }
                else
                {
                    @Highlight(text)
                }
            </div>
            @if (Platform is SocialPlatform.X or SocialPlatform.Threads or SocialPlatform.Facebook or SocialPlatform.LinkedIn)
            {
                <div class="rf-preview-media" style="aspect-ratio:@c.ImageAspect.Width/@c.ImageAspect.Height;max-height:200px">画像 @c.ImageAspect</div>
            }
        </div>
    }
    <MudText Typo="Typo.caption" Style="color:var(--rf-color-text-tertiary)">実際の表示はSNS側の仕様で異なる場合があります</MudText>
</div>

@code {
    [Parameter, EditorRequired] public SocialPlatform Platform { get; set; }
    [Parameter] public string Body { get; set; } = "";
    [Parameter] public IReadOnlyList<string> Hashtags { get; set; } = [];
    [Parameter] public string? Title { get; set; }
    [Parameter] public string AccountName { get; set; } = "@shop";
    [Parameter] public bool Dark { get; set; }

    private static string Take(string s, int n) => new System.Globalization.StringInfo(s).SubstringByTextElements(0, n);
    private static string Skip(string s, int n) => new System.Globalization.StringInfo(s).SubstringByTextElements(n);

    /// <summary>ハッシュタグ・URL を色分けする（RF-UX-001 5.2）。</summary>
    private static RenderFragment Highlight(string text) => builder =>
    {
        var seq = 0;
        foreach (var token in System.Text.RegularExpressions.Regex.Split(text, @"((?:https?://[^\s　]+)|(?:[#＃][^\s　#＃]+))"))
        {
            if (token.Length == 0) continue;
            if (token.StartsWith('#') || token.StartsWith('＃') || token.StartsWith("http"))
            {
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", token.StartsWith("http") ? "rf-url" : "rf-tag");
                builder.AddContent(seq++, token);
                builder.CloseElement();
            }
            else
            {
                builder.AddContent(seq++, token);
            }
        }
    };
}
