@* 空の状態：イラスト（アイコン）＋説明1文＋次の行動ボタン1つ（RF-UX-001 5.3） *@
<MudPaper Class="pa-8 d-flex flex-column align-center rf-card" Elevation="0" Outlined="true">
    <MudIcon Icon="@Icon" Style="font-size:48px;color:var(--rf-color-text-tertiary)" aria-hidden="true" />
    <MudText Typo="Typo.h6" Class="mt-3">@Title</MudText>
    <MudText Typo="Typo.body2" Class="mt-1" Style="color:var(--rf-color-text-secondary)">@Message</MudText>
    @if (ActionText is not null)
    {
        <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" Href="@ActionHref" OnClick="OnAction">@ActionText</MudButton>
    }
</MudPaper>

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Rounded.Inbox;
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? ActionText { get; set; }
    [Parameter] public string? ActionHref { get; set; }
    [Parameter] public EventCallback OnAction { get; set; }
}
