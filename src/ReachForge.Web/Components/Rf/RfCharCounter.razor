@* 文字数カウンタ：上限の 90% で warning、超過で danger＋下線（RF-UX-001 5.2） *@
<div class="rf-counter @Css" aria-live="polite">
    @Length.ToString("N0") / @Max.ToString("N0") 字@(Length > Max ? $"（{Length - Max:N0}字オーバー）" : "")
</div>

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public int Max { get; set; }

    private int Length => PostText.Length(Text);
    private string Css => Length > Max ? "rf-counter-over" : Length >= Max * 0.9 ? "rf-counter-warn" : "";
}
