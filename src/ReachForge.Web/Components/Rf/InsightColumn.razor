@using ReachForge.Domain.Analytics

<MudItem xs="12" md="4">
    <MudText Typo="Typo.subtitle1" Class="mb-1"><b>@Title</b></MudText>
    @if (Claims.Count == 0)
    {
        <MudText Typo="Typo.body2" Style="color:var(--rf-color-text-tertiary)">—</MudText>
    }
    else
    {
        <ul class="ml-5">
            @foreach (var claim in Claims)
            {
                <li class="mb-1"><RfClaim Claim="claim" Facts="Facts" /></li>
            }
        </ul>
    }
</MudItem>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<ReportClaim> Claims { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, ReportFact> Facts { get; set; } = default!;
}
