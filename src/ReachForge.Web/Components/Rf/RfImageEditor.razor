@inherits RfComponentBase
@* 参照画像の AI 編集（F-04：背景差替・不要物除去・商品の配置）。消す範囲は 4×4 のマスで選ぶ（キーボードでも操作できる） *@
@inject AppState State
@inject ISnackbar Snackbar

<div class="rf-image-editor">
    <MudSelect T="ImageEditKind" @bind-Value="_kind" Label="編集の種類" Variant="Variant.Outlined" Margin="Margin.Dense">
        <MudSelectItem Value="ImageEditKind.BackgroundReplace">背景を差し替える</MudSelectItem>
        <MudSelectItem Value="ImageEditKind.ObjectRemoval">不要な物を消す</MudSelectItem>
        <MudSelectItem Value="ImageEditKind.ProductPlacement">商品を新しい背景に配置する</MudSelectItem>
    </MudSelect>
    <MudText Typo="Typo.caption" Class="d-block mt-1 mb-2">@Hint</MudText>

    @if (_kind == ImageEditKind.ObjectRemoval)
    {
        <div class="rf-region-picker" role="group" aria-label="消す範囲（最大@(ReferenceEditJobRequest.MaxRegions)マス）">
            <RfMediaImage AssetId="AssetId" Alt="@Alt" />
            <div class="rf-region-grid">
                @for (var i = 0; i < Grid * Grid; i++)
                {
                    var cell = i;
                    var row = cell / Grid + 1;
                    var col = cell % Grid + 1;
                    <button type="button" class="rf-region-cell @(_cells.Contains(cell) ? "is-selected" : "")" aria-pressed="@(_cells.Contains(cell) ? "true" : "false")"
                            aria-label="@($"{row}行{col}列")" @onclick="() => Toggle(cell)"></button>
                }
            </div>
        </div>
        <MudText Typo="Typo.caption" Class="d-block mt-1">選んだマス：@_cells.Count / @ReferenceEditJobRequest.MaxRegions（範囲の外は元の画像のまま残ります）</MudText>
    }

    <MudTextField T="string" @bind-Value="_prompt" Immediate="true" Variant="Variant.Outlined" Class="mt-2"
                      Label="@(_kind == ImageEditKind.ObjectRemoval ? "補足（任意）" : "新しい背景")"
                      Placeholder="@(_kind == ImageEditKind.ObjectRemoval ? "例：床のタイルを続けて" : "例：木のテーブルと朝の光")" />
    @if (_kind == ImageEditKind.ProductPlacement)
    {
        <div class="d-flex gap-2 align-center mt-2 flex-wrap">
            <MudSelect T="ProductPlacement" @bind-Value="_placement" Label="置く位置" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:140px">
                <MudSelectItem Value="ProductPlacement.Bottom">手前（下）</MudSelectItem>
                <MudSelectItem Value="ProductPlacement.Center">中央</MudSelectItem>
                <MudSelectItem Value="ProductPlacement.Left">左</MudSelectItem>
                <MudSelectItem Value="ProductPlacement.Right">右</MudSelectItem>
            </MudSelect>
            <MudSlider T="double" @bind-Value="_scale" Min="0.3" Max="0.8" Step="0.05" Style="max-width:200px" aria-label="商品の大きさ">
                大きさ @(_scale.ToString("P0"))
            </MudSlider>
        </div>
    }

    <div class="mt-2">
        @if (_jobId is { } id)
        {
            <RfJobProgress JobId="id" Title="AIで画像を編集中" EstimatedSeconds="30" OnFinished="FinishedAsync" />
        }
        else
        {
            <RfAiButton Text="AIで編集する（約5クレジット）" EstimatedCredits="5" DisabledReason="@Disabled" OnClick="StartAsync" />
        }
    </div>
</div>

@code {
    private const int Grid = 4;
    private MediaService Media => Scoped<MediaService>();

    [Parameter, EditorRequired] public Guid AssetId { get; set; }
    [Parameter] public string? Alt { get; set; }
    [Parameter] public EventCallback<Guid> OnCreated { get; set; }

    private ImageEditKind _kind = ImageEditKind.BackgroundReplace;
    private string _prompt = "";
    private ProductPlacement _placement = ProductPlacement.Bottom;
    private double _scale = 0.55;
    private readonly HashSet<int> _cells = [];
    private Guid? _jobId;

    private string Hint => _kind switch
    {
        ImageEditKind.BackgroundReplace => "被写体（商品・人物）はそのまま残し、背景だけを描き直します。背景が単色に近い写真ほど、被写体の形や色が正確に残ります。",
        ImageEditKind.ObjectRemoval => "消したい物があるマスを選んでください。選んだ範囲だけを周りになじむように描き直します。",
        _ => "商品を切り抜いて、AIが作った背景に置きます。商品そのものは描き直さないため、色や文字は変わりません（白や単色の背景で撮った写真向け）。",
    };

    private string? Disabled => _kind switch
    {
        ImageEditKind.ObjectRemoval when _cells.Count == 0 => "消す範囲を選んでください",
        not ImageEditKind.ObjectRemoval when string.IsNullOrWhiteSpace(_prompt) => "新しい背景を入力してください",
        _ => null,
    };

    private void Toggle(int cell)
    {
        if (!_cells.Remove(cell) && _cells.Count < ReferenceEditJobRequest.MaxRegions) _cells.Add(cell);
    }

    private async Task StartAsync()
    {
        try
        {
            var job = await Media.EnqueueEditAsync(new ReferenceEditJobRequest
            {
                SourceAssetId = AssetId,
                Kind = _kind,
                Prompt = _prompt,
                Regions = _kind == ImageEditKind.ObjectRemoval
                    ? _cells.Select(c => new NormalizedRect((c % Grid) / (double)Grid, (c / Grid) / (double)Grid, 1.0 / Grid, 1.0 / Grid)).ToList()
                    : [],
                Placement = _placement,
                Scale = _scale,
            }, CancellationToken.None);
            _jobId = job.Id;
            await State.RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    private async Task FinishedAsync(AiJob job)
    {
        _jobId = null;
        await State.RefreshAsync();
        if (job.Status == AiJobStatus.Succeeded && job.ResultAssetIds.Count > 0)
        {
            Snackbar.Add("編集した画像を保存しました（元の画像はそのまま残ります）", Severity.Success);
            _cells.Clear();
            await OnCreated.InvokeAsync(job.ResultAssetIds[0]);
        }
        else
        {
            Snackbar.Add(job.Error ?? "編集できませんでした。", Severity.Warning);
        }
    }
}
