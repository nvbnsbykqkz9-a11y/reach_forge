@page "/account/forgot-password"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@inject AccountService Accounts
@inject NavigationManager Nav

<PageTitle>パスワードの再設定｜ReachForge</PageTitle>

<h1>パスワードの再設定</h1>
@if (_sent)
{
    @* アカウントの有無にかかわらず同じ表示にする（登録の有無を推測させない） *@
    <p class="rf-help" role="status">
        入力したメールアドレスが登録されていれば、再設定のメールを送りました。メールのリンクは1時間有効です。
        届かない場合は、迷惑メールフォルダを確認するか、管理者にご連絡ください。
    </p>
    <div class="rf-auth-links"><a href="/account/login">ログイン画面へ</a></div>
}
else
{
    <p class="rf-help">登録したメールアドレスを入力してください。再設定のリンクをお送りします。</p>
    <EditForm Model="Input!" FormName="forgot" OnValidSubmit="SendAsync" method="post">
        <DataAnnotationsValidator />
        <div class="rf-field">
            <label for="email">メールアドレス<span class="rf-required">必須</span></label>
            <InputText id="email" @bind-Value="Input!.Email" autocomplete="username" type="email" inputmode="email" />
            <ValidationMessage For="() => Input!.Email" />
        </div>
        <button type="submit" class="rf-btn rf-btn-primary">再設定のメールを送る</button>
    </EditForm>
    <div class="rf-auth-links"><a href="/account/login">ログイン画面へ戻る</a></div>
}

@code {
    [SupplyParameterFromForm] private InputModel? Input { get; set; }
    private bool _sent;

    protected override void OnParametersSet() => Input ??= new();

    private async Task SendAsync()
    {
        await Accounts.RequestPasswordResetAsync(Input!.Email,
            (userId, code) => Nav.ToAbsoluteUri($"/account/reset-password?userId={userId}&code={Uri.EscapeDataString(code)}").ToString(),
            CancellationToken.None);
        _sent = true;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "メールアドレスを入力してください。"), EmailAddress(ErrorMessage = "メールアドレスの形式を確認してください。")]
        public string Email { get; set; } = "";
    }
}
