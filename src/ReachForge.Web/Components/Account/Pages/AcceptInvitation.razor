@page "/account/invite/{Token}"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using ReachForge.Domain.Common
@using ReachForge.Domain.Entities
@using ReachForge.Domain.Enums
@inject AccountService Accounts
@inject UserManager<AppUser> Users
@inject SignInManager<AppUser> SignIn
@inject NavigationManager Nav

<PageTitle>招待を受ける｜ReachForge</PageTitle>

<h1>招待を受ける</h1>
@if (_invitation is null)
{
    <FormMessage Message="この招待リンクは使えません（期限切れ・使用済み・取り消し済み）。招待した人にもう一度依頼してください。" />
    <div class="rf-auth-links"><a href="/account/login">ログイン画面へ</a></div>
}
else
{
    <p class="rf-help">@_invitation.InvitedBy さんから <b>@_invitation.Role.ToLabel()</b> として招待されています（@_invitation.Email）。</p>
    <FormMessage Message="@_error" />
    <EditForm Model="Input!" FormName="accept-invite" OnValidSubmit="AcceptAsync" method="post">
        <DataAnnotationsValidator />
        @if (!_existingUser)
        {
            <div class="rf-field">
                <label for="name">お名前<span class="rf-required">必須</span></label>
                <InputText id="name" @bind-Value="Input!.DisplayName" autocomplete="name" />
            </div>
            <div class="rf-field">
                <label for="password">パスワード（10文字以上）<span class="rf-required">必須</span></label>
                <InputText id="password" @bind-Value="Input!.Password" type="password" autocomplete="new-password" />
            </div>
        }
        else
        {
            <p class="rf-help">このメールアドレスのアカウントがあります。参加すると、ワークスペースが追加されます。</p>
        }
        <button type="submit" class="rf-btn rf-btn-primary">参加する</button>
    </EditForm>
}

@code {
    [Parameter] public string Token { get; set; } = "";
    [SupplyParameterFromForm] private InputModel? Input { get; set; }

    protected override void OnParametersSet() => Input ??= new();
    private Invitation? _invitation;
    private bool _existingUser;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _invitation = await Accounts.FindInvitationAsync(Token, default);
        _existingUser = _invitation is not null && await Users.FindByEmailAsync(_invitation.Email) is not null;
    }

    private async Task AcceptAsync()
    {
        if (_invitation is null) return;
        if (!_existingUser && (string.IsNullOrWhiteSpace(Input!.DisplayName) || (Input!.Password?.Length ?? 0) < 10))
        {
            _error = "お名前と10文字以上のパスワードを入力してください。";
            return;
        }
        try
        {
            var user = await Accounts.AcceptInvitationAsync(Token, Input!.DisplayName ?? "", Input!.Password, default);
            if (_existingUser)
            {
                // 既存アカウントは本人確認のためログインしてもらう
                Nav.NavigateTo("/account/login?returnUrl=%2F", forceLoad: true);
                return;
            }
            await SignIn.SignInAsync(user, isPersistent: false);
            Nav.NavigateTo("/", forceLoad: true);
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
    }

    private sealed class InputModel
    {
        [MaxLength(50)] public string? DisplayName { get; set; }
        public string? Password { get; set; }
    }
}
