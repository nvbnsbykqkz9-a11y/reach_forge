@page "/account/reset-password"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using ReachForge.Domain.Common
@inject AccountService Accounts

<PageTitle>新しいパスワード｜ReachForge</PageTitle>

<h1>新しいパスワード</h1>
@if (_done)
{
    <p class="rf-help" role="status">パスワードを変更しました。新しいパスワードでログインしてください。ほかの端末ではログアウトされます。</p>
    <div class="rf-auth-links"><a href="/account/login">ログイン画面へ</a></div>
}
else if (UserId is null || string.IsNullOrEmpty(Code))
{
    <FormMessage Message="このリンクは使えません。もう一度、パスワードの再設定を依頼してください。" />
    <div class="rf-auth-links"><a href="/account/forgot-password">再設定を依頼する</a></div>
}
else
{
    <FormMessage Message="@_error" />
    <EditForm Model="Input!" FormName="reset" OnValidSubmit="ResetAsync" method="post">
        <DataAnnotationsValidator />
        <div class="rf-field">
            <label for="password">新しいパスワード（10文字以上）<span class="rf-required">必須</span></label>
            <InputText id="password" @bind-Value="Input!.Password" type="password" autocomplete="new-password" />
            <ValidationMessage For="() => Input!.Password" />
        </div>
        <div class="rf-field">
            <label for="confirm">もう一度入力<span class="rf-required">必須</span></label>
            <InputText id="confirm" @bind-Value="Input!.Confirm" type="password" autocomplete="new-password" />
            <ValidationMessage For="() => Input!.Confirm" />
        </div>
        <button type="submit" class="rf-btn rf-btn-primary">パスワードを変更する</button>
    </EditForm>
}

@code {
    [SupplyParameterFromQuery(Name = "userId")] private Guid? UserId { get; set; }
    [SupplyParameterFromQuery(Name = "code")] private string? Code { get; set; }
    [SupplyParameterFromForm] private InputModel? Input { get; set; }
    private string? _error;
    private bool _done;

    protected override void OnParametersSet() => Input ??= new();

    private async Task ResetAsync()
    {
        try
        {
            await Accounts.ResetPasswordAsync(UserId!.Value, Code!, Input!.Password, CancellationToken.None);
            _done = true;
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "新しいパスワードを入力してください。"), MinLength(10, ErrorMessage = "パスワードは10文字以上にしてください。")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "確認のため、もう一度入力してください。"), Compare(nameof(Password), ErrorMessage = "パスワードが一致しません。")]
        public string Confirm { get; set; } = "";
    }
}
