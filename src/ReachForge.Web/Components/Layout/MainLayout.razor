@inherits LayoutComponentBase
@implements IDisposable
@inject AppState State
@inject WebTenantContext Tenant
@inject TimeDisplay Time
@inject NavigationManager Nav
@inject SchedulingService Scheduling
@inject ISnackbar Snackbar
@inject ReachForge.Infrastructure.Identity.AccountService Accounts
@inject Microsoft.Extensions.Options.IOptions<AuthOptions> Auth

<MudThemeProvider Theme="Theme.RfTheme.Default" @bind-IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" />
<MudSnackbarProvider />

<a class="rf-skip-link" href="#main">本文へスキップ</a>
@if (State.Workspace is { } ws)
{
    <div class="rf-workspace-strip" style="background:@ws.BrandColor" aria-hidden="true"></div>
}

<MudLayout>
    <MudAppBar Elevation="1" Dense="false" Fixed="true">
        <MudIconButton Icon="@Icons.Material.Rounded.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="() => _drawer = !_drawer" aria-label="メニューを開閉" />
        <MudText Typo="Typo.h6" Class="ml-2 mr-4" Style="white-space:nowrap">◆ ReachForge</MudText>
        <MudText Typo="Typo.body2" Class="d-none d-sm-flex" Style="color:var(--rf-color-text-secondary)">
            @(State.Workspace?.Name ?? "")
        </MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" Href="/studio"
                   Class="mr-3 d-none d-sm-flex" Style="white-space:nowrap">新規投稿</MudButton>
        <MudIconButton Icon="@Icons.Material.Rounded.Add" Variant="Variant.Filled" Color="Color.Primary" Href="/studio"
                       Class="mr-1 d-flex d-sm-none" aria-label="新規投稿" />
        <RfCreditMeter Account="State.Credits" />
        <MudTooltip Text="通知">
            <MudIconButton Icon="@Icons.Material.Rounded.NotificationsNone" Color="Color.Inherit" aria-label="通知" />
        </MudTooltip>
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Variant="Variant.Text"
                 StartIcon="@Icons.Material.Rounded.AccountCircle" Label="@($"{Tenant.UserName}（{Tenant.Role.ToLabel()}）")"
                 AriaLabel="アカウント" Style="text-transform:none">
            <ChildContent>
                <MudText Typo="Typo.caption" Class="px-4 pt-2 d-block">@Tenant.UserName（@Tenant.Role.ToLabel()）</MudText>
                @if (_memberships.Count > 1)
                {
                    <MudDivider Class="my-1" />
                    <MudText Typo="Typo.caption" Class="px-4">ワークスペースを切り替える</MudText>
                    @foreach (var m in _memberships)
                    {
                        <form method="post" action="/account/switch-workspace" class="px-2">
                            <AntiforgeryToken />
                            <input type="hidden" name="workspaceId" value="@m.WorkspaceId" />
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" FullWidth="true" Class="justify-start"
                                       Disabled="@(m.WorkspaceId == Tenant.WorkspaceId)">
                                <span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:@m.BrandColor;margin-right:8px" aria-hidden="true"></span>
                                @m.WorkspaceName（@m.Role.ToLabel()）
                            </MudButton>
                        </form>
                    }
                }
                <MudDivider Class="my-1" />
                <MudMenuItem Href="/account/mfa" ForceLoad="true">2段階認証の設定</MudMenuItem>
                <MudMenuItem OnClick="() => _dark = !_dark">@(_dark ? "ライト表示にする" : "ダーク表示にする")</MudMenuItem>
                <form method="post" action="/account/logout" class="px-2 pb-1">
                    <AntiforgeryToken />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" FullWidth="true" Class="justify-start"
                               StartIcon="@Icons.Material.Rounded.Logout">ログアウト</MudButton>
                </form>
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawer" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md" Style="border-right:1px solid var(--rf-color-border)">
        <nav aria-label="メインナビゲーション">
            <MudNavMenu Class="pt-2">
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.Home">ホーム</MudNavLink>
                <MudNavGroup Title="つくる" Icon="@Icons.Material.Rounded.AutoAwesome" IconColor="Color.Secondary" Expanded="true">
                    <MudNavLink Href="/studio">スタジオ</MudNavLink>
                    <MudNavLink Href="/media">メディア</MudNavLink>
                </MudNavGroup>
                <MudNavLink Href="/calendar" Icon="@Icons.Material.Rounded.CalendarMonth">予定</MudNavLink>
                <MudNavLink Href="/approvals" Icon="@Icons.Material.Rounded.FactCheck">
                    承認キュー
                    @if (State.PendingApprovals > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="ml-2">@(State.PendingApprovals > 99 ? "99+" : State.PendingApprovals)</MudChip>
                    }
                </MudNavLink>
                <MudNavLink Href="/inbox" Icon="@Icons.Material.Rounded.Inbox">受信箱</MudNavLink>
                <MudNavLink Href="/analytics" Icon="@Icons.Material.Rounded.Insights">分析</MudNavLink>
                <MudNavLink Href="/settings" Icon="@Icons.Material.Rounded.Settings">設定</MudNavLink>
            </MudNavMenu>
        </nav>
    </MudDrawer>

    <MudMainContent>
        @if (State.PublishingPaused)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Square="true" Class="rf-paused-banner">
                すべての予約投稿を一時停止しています。再開するまでSNSへの投稿は行われません。
                @if (RolePolicy.Can(Tenant.Role, Permission.PauseAllPublishing))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small" Class="ml-4" OnClick="ResumeAsync">再開する</MudButton>
                }
            </MudAlert>
        }
        <main id="main" class="rf-main" tabindex="-1">
            @Body
        </main>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawer = true;
    private bool _dark;

    private IReadOnlyList<ReachForge.Infrastructure.Identity.MembershipInfo> _memberships = [];

    protected override async Task OnInitializedAsync()
    {
        // オーナー・管理者は MFA 必須（RF-DES-001 9.1）
        if (Auth.Value.RequireMfaForAdmins && Tenant.Role is Role.Owner or Role.Admin && !Tenant.MfaEnabled)
        {
            Nav.NavigateTo("/account/mfa?required=true", forceLoad: true);
            return;
        }
        State.Changed += OnChanged;
        await Time.ZoneAsync();
        await State.RefreshAsync();
        _memberships = await Accounts.MembershipsAsync(Tenant.UserId, CancellationToken.None);
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task ResumeAsync()
    {
        try
        {
            await Scheduling.SetPausedAsync(false, CancellationToken.None);
            await State.RefreshAsync();
            Snackbar.Add("予約投稿を再開しました", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Show(ex);
        }
    }

    public void Dispose()
    {
        State.Changed -= OnChanged;
    }
}
